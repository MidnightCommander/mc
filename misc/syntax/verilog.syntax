# default colors
context default


#Compiler directives
    keyword  whole  `__FILE__ META_PREPROCESSOR
    keyword  whole  `__LINE__ META_PREPROCESSOR
    keyword  whole  `begin_keywords META_PREPROCESSOR
    keyword  whole  `celldefine META_PREPROCESSOR
    keyword  whole  `default_nettype META_PREPROCESSOR
    keyword  whole  `define META_PREPROCESSOR
    keyword  whole  `else META_PREPROCESSOR
    keyword  whole  `elsif META_PREPROCESSOR
    keyword  whole  `end_keywords META_PREPROCESSOR
    keyword  whole  `endcelldefine META_PREPROCESSOR
    keyword  whole  `endif META_PREPROCESSOR
    keyword  whole  `ifdef META_PREPROCESSOR
    keyword  whole  `ifndef META_PREPROCESSOR
    keyword  whole  `include META_PREPROCESSOR
    keyword  whole  `line META_PREPROCESSOR
    keyword  whole  `nounconnected_drive META_PREPROCESSOR
    keyword  whole  `pragma META_PREPROCESSOR
    keyword  whole  `resetall META_PREPROCESSOR
    keyword  whole  `timescale META_PREPROCESSOR
    keyword  whole  `unconnected_drive META_PREPROCESSOR
    keyword  whole  `undef META_PREPROCESSOR
    keyword  whole  `undefineall META_PREPROCESSOR

