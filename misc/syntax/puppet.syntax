# Language keywords

  keyword whole absent CONSTANT_OTHER
  keyword whole class STORAGE_TYPE_CLASS
  keyword whole define KEYWORD_OTHER
  keyword whole directory CONSTANT_OTHER
  keyword whole include KEYWORD_CONTROL_IMPORT
  keyword whole inherits KEYWORD_OTHER
  keyword whole installed CONSTANT_OTHER
  keyword whole latest CONSTANT_OTHER
  keyword whole link CONSTANT_OTHER
  keyword whole node KEYWORD_OTHER
  keyword whole on_failure KEYWORD_OTHER
  keyword whole present CONSTANT_OTHER
  keyword whole running CONSTANT_OTHER

# Stdlib 4.10.0 Types

  keyword whole file_line SUPPORT_TYPE

