# R language syntax highlighting file for mcedit
# Based on Perl syntax + analysis of the 80 most frequent R commands
# Alexey Shipunov (dactylorhiza@gmail.com), version 20170122
#

context default

    keyword ->> KEYWORD_OPERATOR gray
    keyword <<- KEYWORD_OPERATOR gray
    keyword -> KEYWORD_OPERATOR gray

    keyword <- KEYWORD_OPERATOR

    keyword \\ KEYWORD_OTHER white

    keyword : PUNCTUATION_SEPARATOR
    keyword $ KEYWORD_OPERATOR
    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword ^ KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword != KEYWORD_OPERATOR
    keyword == KEYWORD_OPERATOR
    keyword ! KEYWORD_OPERATOR
    keyword ~ KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword & KEYWORD_OPERATOR

    keyword = KEYWORD_OPERATOR

    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION

    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION

    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION

    keyword ; PUNCTUATION_TERMINATOR

    keyword whole else KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole while KEYWORD_CONTROL

    keyword whole abbreviate SUPPORT_FUNCTION
    keyword whole abline SUPPORT_FUNCTION
    keyword whole abs SUPPORT_FUNCTION
    keyword whole aggregate SUPPORT_FUNCTION
    keyword whole apply SUPPORT_FUNCTION
    keyword whole as.character SUPPORT_FUNCTION
    keyword whole as.data.frame SUPPORT_FUNCTION
    keyword whole as.factor SUPPORT_FUNCTION
    keyword whole as.matrix SUPPORT_FUNCTION
    keyword whole as.numeric SUPPORT_FUNCTION
    keyword whole as.vector SUPPORT_FUNCTION
    keyword whole attr SUPPORT_FUNCTION
    keyword whole boxplot SUPPORT_FUNCTION
    keyword whole c SUPPORT_FUNCTION
    keyword whole cat SUPPORT_FUNCTION
    keyword whole cbind SUPPORT_FUNCTION
    keyword whole chisq.test SUPPORT_FUNCTION
    keyword whole colnames SUPPORT_FUNCTION
    keyword whole colSums SUPPORT_FUNCTION
    keyword whole cor SUPPORT_FUNCTION
    keyword whole cor.test SUPPORT_FUNCTION
    keyword whole data.frame SUPPORT_FUNCTION
    keyword whole dev.off SUPPORT_FUNCTION
    keyword whole dimnames SUPPORT_FUNCTION
    keyword whole dist SUPPORT_FUNCTION
    keyword whole dotchart SUPPORT_FUNCTION
    keyword whole eqscplot SUPPORT_FUNCTION
    keyword whole factor SUPPORT_FUNCTION
    keyword whole function STORAGE_TYPE_FUNCTION
    keyword whole get SUPPORT_FUNCTION
    keyword whole grep SUPPORT_FUNCTION
    keyword whole gsub SUPPORT_FUNCTION
    keyword whole hclust SUPPORT_FUNCTION
    keyword whole hist SUPPORT_FUNCTION
    keyword whole ifelse SUPPORT_FUNCTION
    keyword whole is.factor SUPPORT_FUNCTION
    keyword whole is.na SUPPORT_FUNCTION
    keyword whole kruskal.test SUPPORT_FUNCTION
    keyword whole lda SUPPORT_FUNCTION
    keyword whole legend SUPPORT_FUNCTION
    keyword whole length SUPPORT_FUNCTION
    keyword whole levels SUPPORT_FUNCTION
    keyword whole library KEYWORD_CONTROL_IMPORT
    keyword whole lines SUPPORT_FUNCTION
    keyword whole list SUPPORT_FUNCTION
    keyword whole lm SUPPORT_FUNCTION
    keyword whole loadings SUPPORT_FUNCTION
    keyword whole log SUPPORT_FUNCTION
    keyword whole manova SUPPORT_FUNCTION
    keyword whole matrix SUPPORT_FUNCTION
    keyword whole max SUPPORT_FUNCTION
    keyword whole mean SUPPORT_FUNCTION
    keyword whole median SUPPORT_FUNCTION
    keyword whole min SUPPORT_FUNCTION
    keyword whole mtext SUPPORT_FUNCTION
    keyword whole names SUPPORT_FUNCTION
    keyword whole na.omit SUPPORT_FUNCTION
    keyword whole ncol SUPPORT_FUNCTION
    keyword whole nrow SUPPORT_FUNCTION
    keyword whole order SUPPORT_FUNCTION
    keyword whole palette SUPPORT_FUNCTION
    keyword whole par SUPPORT_FUNCTION
    keyword whole paste SUPPORT_FUNCTION
    keyword whole pdf SUPPORT_FUNCTION
    keyword whole plot SUPPORT_FUNCTION
    keyword whole png SUPPORT_FUNCTION
    keyword whole points SUPPORT_FUNCTION
    keyword whole predict SUPPORT_FUNCTION
    keyword whole princomp SUPPORT_FUNCTION
    keyword whole print SUPPORT_FUNCTION
    keyword whole range SUPPORT_FUNCTION
    keyword whole rbind SUPPORT_FUNCTION
    keyword whole read.table SUPPORT_FUNCTION
    keyword whole recode SUPPORT_FUNCTION
    keyword whole rep SUPPORT_FUNCTION
    keyword whole replace SUPPORT_FUNCTION
    keyword whole return KEYWORD_CONTROL
    keyword whole rev SUPPORT_FUNCTION
    keyword whole rnorm SUPPORT_FUNCTION
    keyword whole round SUPPORT_FUNCTION
    keyword whole row.names SUPPORT_FUNCTION
    keyword whole rowSums SUPPORT_FUNCTION
    keyword whole sapply SUPPORT_FUNCTION
    keyword whole scale SUPPORT_FUNCTION
    keyword whole seq SUPPORT_FUNCTION
    keyword whole sink SUPPORT_FUNCTION
    keyword whole smooth.spline SUPPORT_FUNCTION
    keyword whole sort SUPPORT_FUNCTION
    keyword whole source KEYWORD_CONTROL_IMPORT
    keyword whole sqrt SUPPORT_FUNCTION
    keyword whole str SUPPORT_FUNCTION
    keyword whole sum SUPPORT_FUNCTION
    keyword whole summary SUPPORT_FUNCTION
    keyword whole t SUPPORT_FUNCTION
    keyword whole table SUPPORT_FUNCTION
    keyword whole tapply SUPPORT_FUNCTION
    keyword whole text SUPPORT_FUNCTION
    keyword whole t.test SUPPORT_FUNCTION
    keyword whole unique SUPPORT_FUNCTION
    keyword whole wilcox.test SUPPORT_FUNCTION
    keyword whole with SUPPORT_FUNCTION
    keyword whole write.table SUPPORT_FUNCTION
    keyword whole x11 SUPPORT_FUNCTION

context # \n COMMENT_LINE
    spellcheck

context "http " MARKUP_UNDERLINE_LINK

context " " STRING_QUOTED_DOUBLE

context 'http ' MARKUP_UNDERLINE_LINK

context ' ' STRING_QUOTED_SINGLE
