# Adam Pribyl, based on ADA
# modified: Andrew Borodin
# missing
# literal, on,  (something else)

caseinsensitive

context default

#wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_

    keyword whole with KEYWORD_CONTROL
    keyword whole select KEYWORD_CONTROL
    keyword whole use KEYWORD_CONTROL_IMPORT
    keyword whole is KEYWORD_OTHER_RESERVED
    keyword whole of KEYWORD_OTHER_RESERVED
    keyword whole length SUPPORT_FUNCTION
    keyword whole range SUPPORT_FUNCTION
    keyword whole left SUPPORT_FUNCTION
    keyword whole right SUPPORT_FUNCTION
    keyword whole delta SUPPORT_FUNCTION
    keyword whole return KEYWORD_CONTROL
    keyword whole next KEYWORD_CONTROL
    keyword whole null CONSTANT_LANGUAGE
    keyword whole array KEYWORD_OTHER_RESERVED
    keyword whole downto KEYWORD_OTHER_RESERVED
    keyword whole to KEYWORD_OTHER_RESERVED
    keyword whole foreign KEYWORD_OTHER_RESERVED

# comment
    keyword -- COMMENT_LINE

# expressions
    keyword := KEYWORD_OPERATOR
    keyword . PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword , PUNCTUATION_SEPARATOR
    keyword ' KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword \*\* KEYWORD_OPERATOR
    keyword # KEYWORD_OPERATOR
    keyword & KEYWORD_OPERATOR
    keyword => KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword > KEYWORD_OPERATOR
    keyword <= KEYWORD_OPERATOR
    keyword >= KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword /= KEYWORD_OPERATOR

# operators and functions
    keyword whole sll KEYWORD_OPERATOR_WORD
    keyword whole srl KEYWORD_OPERATOR_WORD
    keyword whole sla KEYWORD_OPERATOR_WORD
    keyword whole sra KEYWORD_OPERATOR_WORD
    keyword whole rol KEYWORD_OPERATOR_WORD
    keyword whole ror KEYWORD_OPERATOR_WORD
    keyword whole rem KEYWORD_OPERATOR_WORD
    keyword whole mod KEYWORD_OPERATOR_WORD
    keyword whole not KEYWORD_OPERATOR_WORD
    keyword whole and KEYWORD_OPERATOR_WORD
    keyword whole nand KEYWORD_OPERATOR_WORD
    keyword whole or KEYWORD_OPERATOR_WORD
    keyword whole xor KEYWORD_OPERATOR_WORD
    keyword whole nor KEYWORD_OPERATOR_WORD
    keyword whole xnor KEYWORD_OPERATOR_WORD
    keyword whole abs SUPPORT_FUNCTION
    keyword whole new KEYWORD_OTHER_NEW

    keyword whole begin KEYWORD_OTHER_RESERVED
    keyword whole end KEYWORD_OTHER_RESERVED
    keyword whole exit KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole while KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole then KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole elsif KEYWORD_CONTROL
    keyword whole case KEYWORD_CONTROL
    keyword whole when KEYWORD_CONTROL
    keyword whole with KEYWORD_CONTROL
    keyword whole select KEYWORD_CONTROL
    keyword whole assert KEYWORD_CONTROL
    keyword    whole wait KEYWORD_CONTROL
    keyword    whole open KEYWORD_OTHER_RESERVED
    keyword whole loop KEYWORD_CONTROL
    keyword whole until KEYWORD_CONTROL
    keyword whole others KEYWORD_CONTROL
    keyword whole all KEYWORD_CONTROL
    keyword whole block KEYWORD_OTHER_RESERVED
    keyword whole guarded KEYWORD_OTHER_RESERVED
    keyword whole after KEYWORD_OTHER_RESERVED
    keyword whole transport KEYWORD_OTHER_RESERVED
    keyword whole inertial KEYWORD_OTHER_RESERVED
    keyword whole reject KEYWORD_OTHER_RESERVED
    keyword whole unaffected KEYWORD_OTHER_RESERVED
    keyword whole disconnect KEYWORD_OTHER_RESERVED

# types and related stuff
    keyword whole integer STORAGE_TYPE_PRIMITIVE
    keyword whole natural STORAGE_TYPE_PRIMITIVE
    keyword whole positive STORAGE_TYPE_PRIMITIVE
    keyword whole string STORAGE_TYPE_PRIMITIVE
    keyword whole character STORAGE_TYPE_PRIMITIVE
    keyword whole boolean STORAGE_TYPE_PRIMITIVE
    keyword whole real STORAGE_TYPE_PRIMITIVE
    keyword whole bit STORAGE_TYPE_PRIMITIVE
    keyword whole bit_vector STORAGE_TYPE_PRIMITIVE
    keyword whole time STORAGE_TYPE_PRIMITIVE
    keyword whole units STORAGE_TYPE
    keyword whole std_logic SUPPORT_TYPE
    keyword whole std_logic_vector SUPPORT_TYPE
    keyword whole severity_level STORAGE_TYPE

# boolean values
    keyword whole true CONSTANT_LANGUAGE
    keyword whole false CONSTANT_LANGUAGE
# time values
    keyword whole fs CONSTANT_OTHER
    keyword whole ps CONSTANT_OTHER
    keyword whole ns CONSTANT_OTHER
    keyword whole us CONSTANT_OTHER
    keyword whole ms CONSTANT_OTHER
    keyword whole sec CONSTANT_OTHER
    keyword whole min CONSTANT_OTHER
    keyword whole hr CONSTANT_OTHER

# declarations
    keyword whole type STORAGE_TYPE
    keyword whole subtype STORAGE_TYPE

    keyword whole variable STORAGE_MODIFIER
    keyword whole shared STORAGE_MODIFIER
    keyword whole signal STORAGE_MODIFIER
    keyword whole constant STORAGE_MODIFIER
    keyword whole group KEYWORD_OTHER_RESERVED
    keyword whole file STORAGE_MODIFIER
    keyword whole register KEYWORD_OTHER_RESERVED

    keyword whole port STORAGE_MODIFIER
    keyword whole map KEYWORD_OTHER_RESERVED
    keyword whole label KEYWORD_OTHER_RESERVED
    keyword whole record STORAGE_TYPE_CLASS
    keyword whole generic STORAGE_MODIFIER
    keyword whole alias KEYWORD_OTHER_RESERVED
    keyword whole attribute KEYWORD_OTHER_RESERVED

# ports
    keyword whole in STORAGE_MODIFIER
    keyword whole out STORAGE_MODIFIER
    keyword whole inout STORAGE_MODIFIER
    keyword whole buffer STORAGE_MODIFIER
    keyword whole linkage STORAGE_MODIFIER
    keyword whole bus STORAGE_MODIFIER

# library units
    keyword whole library KEYWORD_CONTROL_IMPORT
    keyword whole entity STORAGE_TYPE_CLASS
    keyword whole architecture STORAGE_TYPE_CLASS
    keyword whole package STORAGE_TYPE_CLASS
    keyword whole body KEYWORD_OTHER_RESERVED
    keyword whole procedure STORAGE_TYPE_FUNCTION
    keyword whole function STORAGE_TYPE_FUNCTION
    keyword whole pure KEYWORD_OTHER_RESERVED
    keyword whole impure KEYWORD_OTHER_RESERVED
    keyword whole configuration STORAGE_TYPE_CLASS
    keyword whole component STORAGE_TYPE_CLASS
    keyword whole generic STORAGE_MODIFIER
    keyword whole process KEYWORD_OTHER_RESERVED
    keyword whole postponded KEYWORD_OTHER_RESERVED
    keyword whole generate KEYWORD_OTHER_RESERVED

# reports
    keyword whole report KEYWORD_OTHER_RESERVED
    keyword whole severity KEYWORD_OTHER_RESERVED
    keyword whole note KEYWORD_OTHER_RESERVED
    keyword whole warning KEYWORD_OTHER_RESERVED
    keyword whole error KEYWORD_OTHER_RESERVED
    keyword whole failure KEYWORD_OTHER_RESERVED

# comment
context exclusive -- \n COMMENT_LINE

context " " STRING_QUOTED_DOUBLE
