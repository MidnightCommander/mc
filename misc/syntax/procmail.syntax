    keyword whole HOME VARIABLE_OTHER
    keyword whole PATH VARIABLE_OTHER
    keyword whole SHELL VARIABLE_OTHER

    keyword whole ST VARIABLE_OTHER
    keyword whole STN VARIABLE_OTHER
    keyword whole NL VARIABLE_OTHER

