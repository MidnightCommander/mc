context exclusive linestart .SH \n ENTITY_NAME_SECTION
    keyword \\fB*\\fP MARKUP_BOLD
    keyword \\fI*\\fP MARKUP_ITALIC
    spellcheck
context exclusive linestart .TH \n ENTITY_NAME_SECTION
    keyword \\fB*\\fP MARKUP_BOLD
    keyword \\fI*\\fP MARKUP_ITALIC
    spellcheck
context exclusive linestart .B \n MARKUP_BOLD
    keyword \\fI*\\fP MARKUP_ITALIC
    spellcheck
context exclusive linestart .I \n MARKUP_ITALIC
    keyword \\fB*\\fP MARKUP_BOLD
    spellcheck
context exclusive whole linestart .nf linestart .fi STRING_UNQUOTED
    keyword \\fB*\\fP MARKUP_BOLD
    keyword \\fI*\\fP MARKUP_ITALIC
    spellcheck

# font changes should end in a \fP
context exclusive \\fB \\f\{PR\} MARKUP_BOLD
    spellcheck
context exclusive \\fI \\f\{PR\} MARKUP_ITALIC
    spellcheck
context linestart .\\" \n COMMENT_LINE
    spellcheck
