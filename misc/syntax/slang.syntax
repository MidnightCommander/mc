context default
    keyword whole forever KEYWORD_CONTROL
    keyword whole foreach KEYWORD_CONTROL
    keyword whole using KEYWORD_CONTROL_IMPORT
    keyword whole orelse KEYWORD_CONTROL
    keyword whole andelse KEYWORD_CONTROL
    keyword whole loop KEYWORD_CONTROL
    keyword whole variable STORAGE_MODIFIER
    keyword whole define KEYWORD_OTHER_RESERVED
    keyword whole break KEYWORD_CONTROL
    keyword whole case KEYWORD_CONTROL
    keyword whole continue KEYWORD_CONTROL
    keyword whole do KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole goto KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole !if KEYWORD_CONTROL
    keyword whole return KEYWORD_CONTROL
    keyword whole sizeof KEYWORD_OPERATOR_WORD
    keyword whole static STORAGE_MODIFIER
    keyword whole struct STORAGE_TYPE_CLASS
    keyword whole switch KEYWORD_CONTROL
    keyword whole typedef STORAGE_TYPE
    keyword whole while KEYWORD_CONTROL
    keyword whole typecast KEYWORD_OTHER_RESERVED
    keyword whole delete KEYWORD_OTHER_NEW
    keyword whole private STORAGE_MODIFIER
    keyword whole protected STORAGE_MODIFIER
    keyword whole public STORAGE_MODIFIER
    keyword whole namespace KEYWORD_OTHER_RESERVED
    keyword whole implements KEYWORD_OTHER_RESERVED

    keyword whole EXIT_BLOCK KEYWORD_CONTROL
    keyword whole ERROR_BLOCK KEYWORD_CONTROL
    keyword whole EXECUTE_ERROR_BLOCK KEYWORD_CONTROL

    keyword whole and KEYWORD_OPERATOR_WORD
    keyword whole or KEYWORD_OPERATOR_WORD
    keyword whole xor KEYWORD_OPERATOR_WORD


    keyword whole Char_Type STORAGE_TYPE_PRIMITIVE
    keyword whole UChar_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Short_Type STORAGE_TYPE_PRIMITIVE
    keyword whole UShort_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Integer_Type STORAGE_TYPE_PRIMITIVE
    keyword whole UInteger_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Long_Type STORAGE_TYPE_PRIMITIVE
    keyword whole ULong_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Float_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Double_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Complex_Type STORAGE_TYPE_PRIMITIVE
    keyword whole String_Type STORAGE_TYPE_PRIMITIVE
    keyword whole BString_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Struct_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Ref_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Null_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Array_Type STORAGE_TYPE_PRIMITIVE
    keyword whole DataType_Type STORAGE_TYPE_PRIMITIVE
    keyword whole Assoc_Type STORAGE_TYPE_PRIMITIVE

    keyword '\\\{"abtnvfr\}' CONSTANT_CHARACTER_ESCAPE
    keyword '\\\{0123\}\{01234567\}\{01234567\}' CONSTANT_CHARACTER
    keyword '\\'' CONSTANT_CHARACTER_ESCAPE
    keyword '\\\\' CONSTANT_CHARACTER_ESCAPE
    keyword '\\0' CONSTANT_CHARACTER_ESCAPE
    keyword '\{\s!"#$%&()\*\+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~ ¡¢£¤¥¦§¨©ª«¬­®¯°±²³´µ¶·¸¹º»¼½¾¿ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ×ØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿ\}' CONSTANT_CHARACTER

    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword != KEYWORD_OPERATOR
    keyword == KEYWORD_OPERATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
context % \n COMMENT_LINE
    spellcheck
context linestart # \n META_PREPROCESSOR
    keyword \\\n PUNCTUATION_SEPARATOR_CONTINUATION
    keyword /\**\*/ COMMENT_BLOCK
    keyword "+" STRING_QUOTED_OTHER
    keyword <+> STRING_QUOTED_OTHER
context " " STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\n CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_OTHER_PLACEHOLDER
    keyword %\[#0\s-\+,\]\[0123456789\]\[.\]\[0123456789\]\[L\]\{eEfgGoxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[0\s-\+,\]\[0123456789\]\[.\]\[0123456789\]\[hl\]\{diuxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[hl\]n CONSTANT_OTHER_PLACEHOLDER
    keyword %\[.\]\[0123456789\]s CONSTANT_OTHER_PLACEHOLDER
    keyword %[*] CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE
