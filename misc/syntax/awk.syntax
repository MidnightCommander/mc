context default

    keyword whole linestart #!\[\s\]/bin/\[msg\]awk COMMENT_LINE magenta
    keyword whole linestart #!\[\s\]/usr/bin/\[msg\]awk COMMENT_LINE magenta
# Keywords
    keyword whole AMNOISE CONSTANT_OTHER
    keyword whole BEGIN KEYWORD_OTHER_RESERVED
    keyword whole END KEYWORD_OTHER_RESERVED
    keyword whole func STORAGE_TYPE_FUNCTION
    keyword whole function STORAGE_TYPE_FUNCTION
    keyword whole nextfile KEYWORD_CONTROL

    keyword whole return KEYWORD_CONTROL
    keyword whole print SUPPORT_FUNCTION
    keyword whole printf SUPPORT_FUNCTION
    keyword whole if KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole while KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole in KEYWORD_OPERATOR_WORD
    keyword whole do KEYWORD_CONTROL
    keyword whole break KEYWORD_CONTROL
    keyword whole continue KEYWORD_CONTROL
    keyword whole next KEYWORD_CONTROL
    keyword whole exit KEYWORD_CONTROL
    keyword whole close KEYWORD_CONTROL
    keyword whole system KEYWORD_CONTROL
    keyword whole getline SUPPORT_FUNCTION
# Builtin functions:
    keyword whole atan2        SUPPORT_FUNCTION black
    keyword whole cos          SUPPORT_FUNCTION black
    keyword whole exp          SUPPORT_FUNCTION black
    keyword whole int          SUPPORT_FUNCTION black
    keyword whole log          SUPPORT_FUNCTION black
    keyword whole rand         SUPPORT_FUNCTION black
    keyword whole sin          SUPPORT_FUNCTION black
    keyword whole sqrt         SUPPORT_FUNCTION black
    keyword whole srand        SUPPORT_FUNCTION black
    keyword whole gsub         SUPPORT_FUNCTION black
    keyword whole index        SUPPORT_FUNCTION black
    keyword whole length       SUPPORT_FUNCTION black
    keyword whole match        SUPPORT_FUNCTION black
    keyword whole split        SUPPORT_FUNCTION black
    keyword whole sprintf      SUPPORT_FUNCTION black
    keyword whole sub          SUPPORT_FUNCTION black
    keyword whole substr       SUPPORT_FUNCTION black
    keyword whole asort        SUPPORT_FUNCTION black
    keyword whole asorti       SUPPORT_FUNCTION black

    keyword whole xor SUPPORT_FUNCTION
    keyword whole and SUPPORT_FUNCTION
    keyword whole or SUPPORT_FUNCTION

# Gawk builtin functions:
    keyword whole fflush       SUPPORT_FUNCTION black
    keyword whole gensub       SUPPORT_FUNCTION black
    keyword whole tolower      SUPPORT_FUNCTION black
    keyword whole toupper      SUPPORT_FUNCTION black
    keyword whole systime      SUPPORT_FUNCTION black
    keyword whole strftime     SUPPORT_FUNCTION black
    keyword whole strtonum SUPPORT_FUNCTION
    keyword whole bindtextdomain SUPPORT_FUNCTION
    keyword whole dcgettext SUPPORT_FUNCTION
    keyword whole dcngettext SUPPORT_FUNCTION
    keyword whole compl SUPPORT_FUNCTION
    keyword whole delete SUPPORT_FUNCTION
    keyword whole extension SUPPORT_FUNCTION
    keyword whole mktime SUPPORT_FUNCTION
    keyword whole lshift SUPPORT_FUNCTION
    keyword whole rshift SUPPORT_FUNCTION

# Builtin variables:
    keyword whole ARGIND VARIABLE_OTHER
    keyword whole BINMODE VARIABLE_OTHER
    keyword whole CONVFMT VARIABLE_OTHER
    keyword whole ENVIRON VARIABLE_OTHER
    keyword whole LINT VARIABLE_OTHER
    keyword whole TEXTDOMAIN VARIABLE_OTHER
    keyword whole ARGC VARIABLE_OTHER
    keyword whole ARGV VARIABLE_OTHER
    keyword whole FILENAME VARIABLE_OTHER
    keyword whole FNR VARIABLE_OTHER
    keyword whole FS VARIABLE_OTHER
    keyword whole NF VARIABLE_OTHER
    keyword whole NR VARIABLE_OTHER
    keyword whole OFMT VARIABLE_OTHER
    keyword whole OFS VARIABLE_OTHER
    keyword whole ORS VARIABLE_OTHER
    keyword whole RLENGTH VARIABLE_OTHER
    keyword whole RS VARIABLE_OTHER
    keyword whole RSTART VARIABLE_OTHER
    keyword whole SUBSEP VARIABLE_OTHER
# Gawk builtin variables:
    keyword whole ARGIND VARIABLE_OTHER
    keyword whole ERRNO VARIABLE_OTHER
    keyword whole RT VARIABLE_OTHER
    keyword whole IGNORECASE VARIABLE_OTHER
    keyword whole FIELDWIDTHS VARIABLE_OTHER

    keyword '\s' CONSTANT_CHARACTER
    keyword '+' CONSTANT_CHARACTER
    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword != KEYWORD_OPERATOR
    keyword == KEYWORD_OPERATOR
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [*] KEYWORD_OPERATOR
    keyword , PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword $\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\] VARIABLE_OTHER
# Begin/End:
    keyword whole BEGIN KEYWORD_OTHER_RESERVED
    keyword whole END KEYWORD_OTHER_RESERVED
# Function keyword:
    keyword whole function STORAGE_TYPE_FUNCTION
# Hex constant:
    keyword 0\{xX\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\] CONSTANT_NUMERIC
# Tab:    \t
#    keyword linestart \t lightgray/13 blue/6

# Sed:
    keyword linestart /^ STRING_REGEXP
    keyword linestart /^# STRING_REGEXP
context /^#*/ STRING_REGEXP

# Comments:
context linestart # \n COMMENT_LINE
context linestart $ \n COMMENT_LINE

# String:
context " " STRING_QUOTED_DOUBLE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\n CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_OTHER_PLACEHOLDER
    keyword %\[#0\s-\+,\]\[0123456789\]\[.\]\[0123456789\]\[L\]\{eEfgGoxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[0\s-\+,\]\[0123456789\]\[.\]\[0123456789\]\[hl\]\{diu\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[hl\]n CONSTANT_OTHER_PLACEHOLDER
    keyword %\[.\]\[0123456789\]s CONSTANT_OTHER_PLACEHOLDER
    keyword %[*] CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE
