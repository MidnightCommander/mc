# TOML: Tom's Obvious Minimal Language

context default

# groups
context [ \n ENTITY_NAME_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION

# assignment
context exclusive = \n STRING_UNQUOTED
    keyword "*" STRING_QUOTED_DOUBLE
    keyword whole false CONSTANT_LANGUAGE
    keyword whole true CONSTANT_LANGUAGE
    keyword \{0123456789\} CONSTANT_NUMERIC

# comments
context # \n COMMENT_LINE
    spellcheck

# other strings
context " " STRING_QUOTED_DOUBLE
