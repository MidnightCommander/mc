#
# JavaScript syntax highlighting
# for MC Editor/CoolEdit
#
# Authors:
#    * Vlad Romanenko <VladRomanenko@ukr.net>
#    * Timur Shemsedinov <timur.shemsedinov@gmail.com>
#    * Pavel Roskin <proski@gnu.org>
# Based on c.syntax
#
# 2022-08-17  Timur Shemsedinov <timur.shemsedinov@gmail.com>
#    * Support latest ECMAScript syntax
#    * Support ECMAScript global identifiers
#    * Support node.js specific identifiers
#
# 2002-09-17  Vlad Romanenko <VladRomanenko@ukr.net>
#    * More C and Java consistency by Pavel Roskin <proski@gnu.org>
#    * Advanced number highlighting
#
# 2002-09-16  Vlad Romanenko <VladRomanenko@ukr.net>
#    * Initial public release
#

context default

    #=========================
    # Keywords
    keyword whole arguments VARIABLE_LANGUAGE
    keyword whole async STORAGE_MODIFIER
    keyword whole await KEYWORD_CONTROL
    keyword whole break KEYWORD_CONTROL
    keyword whole caller VARIABLE_LANGUAGE
    keyword whole case KEYWORD_CONTROL
    keyword whole catch KEYWORD_CONTROL
    keyword whole class STORAGE_TYPE_CLASS
    keyword whole const STORAGE_MODIFIER
    keyword whole constructor SUPPORT_FUNCTION
    keyword whole continue KEYWORD_CONTROL
    keyword whole debugger KEYWORD_OTHER_RESERVED
    keyword whole default KEYWORD_CONTROL
    keyword whole delete KEYWORD_OPERATOR_WORD
    keyword whole do KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole export KEYWORD_CONTROL_IMPORT
    keyword whole extends STORAGE_MODIFIER
    keyword whole finally KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole function STORAGE_TYPE_FUNCTION
    keyword whole if KEYWORD_CONTROL
    keyword whole import KEYWORD_CONTROL_IMPORT
    keyword whole in KEYWORD_OPERATOR_WORD
    keyword whole instanceof KEYWORD_OPERATOR_WORD
    keyword whole let STORAGE_TYPE
    keyword whole new KEYWORD_OTHER_NEW
    keyword whole of KEYWORD_OTHER_RESERVED
    keyword whole prototype SUPPORT_FUNCTION
    keyword whole return KEYWORD_CONTROL
    keyword whole super VARIABLE_LANGUAGE
    keyword whole switch KEYWORD_CONTROL
    keyword whole this VARIABLE_LANGUAGE
    keyword whole throw KEYWORD_CONTROL
    keyword whole try KEYWORD_CONTROL
    keyword whole typeof KEYWORD_OPERATOR_WORD
    keyword whole var STORAGE_TYPE
    keyword whole void KEYWORD_OPERATOR_WORD
    keyword whole while KEYWORD_CONTROL
    keyword whole with KEYWORD_OTHER_RESERVED
    keyword whole yield KEYWORD_CONTROL

    #=========================
    # Objects
    keyword whole AbortController SUPPORT_CLASS
    keyword whole AbortSignal SUPPORT_CLASS
    keyword whole AggregateError SUPPORT_CLASS
    keyword whole Array SUPPORT_CLASS
    keyword whole ArrayBuffer SUPPORT_CLASS
    keyword whole AsyncFunction SUPPORT_CLASS
    keyword whole AsyncGenerator SUPPORT_CLASS
    keyword whole AsyncGeneratorFunction SUPPORT_CLASS
    keyword whole Atomics SUPPORT_CLASS
    keyword whole BigInt64Array SUPPORT_CLASS
    keyword whole BigInt SUPPORT_CLASS
    keyword whole BigUint64Array SUPPORT_CLASS
    keyword whole Blob SUPPORT_CLASS
    keyword whole Boolean SUPPORT_CLASS
    keyword whole Buffer SUPPORT_CLASS
    keyword whole DataView SUPPORT_CLASS
    keyword whole Date SUPPORT_CLASS
    keyword whole DOMException SUPPORT_CLASS
    keyword whole Error SUPPORT_CLASS
    keyword whole EvalError SUPPORT_CLASS
    keyword whole Float32Array SUPPORT_CLASS
    keyword whole Float64Array SUPPORT_CLASS
    keyword whole Function SUPPORT_CLASS
    keyword whole Generator SUPPORT_CLASS
    keyword whole GeneratorFunction SUPPORT_CLASS
    keyword whole global VARIABLE_LANGUAGE
    keyword whole globalThis VARIABLE_LANGUAGE
    keyword whole Image SUPPORT_CLASS
    keyword whole Infinity CONSTANT_LANGUAGE
    keyword whole Int16Array SUPPORT_CLASS
    keyword whole Int32Array SUPPORT_CLASS
    keyword whole Int8Array SUPPORT_CLASS
    keyword whole Intl SUPPORT_CLASS
    keyword whole JSON SUPPORT_CLASS
    keyword whole Map SUPPORT_CLASS
    keyword whole Math SUPPORT_CLASS
    keyword whole Number SUPPORT_CLASS
    keyword whole Object SUPPORT_CLASS
    keyword whole Promise SUPPORT_CLASS
    keyword whole Promise SUPPORT_CLASS
    keyword whole Proxy SUPPORT_CLASS
    keyword whole RangeError SUPPORT_CLASS
    keyword whole ReferenceError SUPPORT_CLASS
    keyword whole Reflect SUPPORT_CLASS
    keyword whole RegExp SUPPORT_CLASS
    keyword whole Set SUPPORT_CLASS
    keyword whole SharedArrayBuffer SUPPORT_CLASS
    keyword whole Symbol SUPPORT_CLASS
    keyword whole SyntaxError SUPPORT_CLASS
    keyword whole TextDecoder SUPPORT_CLASS
    keyword whole TypeError SUPPORT_CLASS
    keyword whole Uint16Array SUPPORT_CLASS
    keyword whole Uint32Array SUPPORT_CLASS
    keyword whole Uint8Array SUPPORT_CLASS
    keyword whole Uint8ClampedArray SUPPORT_CLASS
    keyword whole URIError SUPPORT_CLASS
    keyword whole URL SUPPORT_CLASS
    keyword whole URLSearchParams SUPPORT_CLASS
    keyword whole WeakMap SUPPORT_CLASS
    keyword whole WeakSet SUPPORT_CLASS
    keyword whole WebAssembly SUPPORT_CLASS
    keyword whole window VARIABLE_LANGUAGE

    #=========================
    # Most common functions
    keyword whole alert SUPPORT_FUNCTION
    keyword whole clearInterval SUPPORT_FUNCTION
    keyword whole clearTimeout SUPPORT_FUNCTION
    keyword whole console SUPPORT_CLASS
    keyword whole decodeURIComponent SUPPORT_FUNCTION
    keyword whole decodeURI SUPPORT_FUNCTION
    keyword whole encodeURIComponent SUPPORT_FUNCTION
    keyword whole escape SUPPORT_FUNCTION
    keyword whole eval SUPPORT_FUNCTION
    keyword whole fetch SUPPORT_FUNCTION
    keyword whole isFinite SUPPORT_FUNCTION
    keyword whole isNaN SUPPORT_FUNCTION
    keyword whole module SUPPORT_CLASS
    keyword whole parseFloat SUPPORT_FUNCTION
    keyword whole parseInt SUPPORT_FUNCTION
    keyword whole performance SUPPORT_CLASS
    keyword whole process SUPPORT_CLASS
    keyword whole queueMicrotask SUPPORT_FUNCTION
    keyword whole require SUPPORT_FUNCTION
    keyword whole setImmediate SUPPORT_FUNCTION
    keyword whole setInterval SUPPORT_FUNCTION
    keyword whole setTimeout SUPPORT_FUNCTION
    keyword whole structuredClone SUPPORT_FUNCTION
    keyword whole unescape SUPPORT_FUNCTION

    #=========================
    # Constants
    keyword whole true CONSTANT_LANGUAGE
    keyword whole false CONSTANT_LANGUAGE
    keyword whole null CONSTANT_LANGUAGE
    keyword whole undefined CONSTANT_LANGUAGE
    keyword whole NaN CONSTANT_LANGUAGE
    keyword whole __dirname VARIABLE_OTHER
    keyword whole __filename VARIABLE_OTHER

    #=========================
    # Comments
    keyword /\* COMMENT_BLOCK
    keyword \*/ COMMENT_BLOCK
    keyword // COMMENT_LINE

    #=========================
    # Numbers
    wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.

    keyword whole 0\{xX\}\{0123456789abcdefABCDEF\}\[0123456789abcdefABCDEF\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[0123456789\]\.\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC

    #=========================
    # Special symbols
    keyword => KEYWORD_OPERATOR
    keyword \. KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword ! KEYWORD_OPERATOR
    keyword & KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    keyword ^ KEYWORD_OPERATOR
    keyword ~ KEYWORD_OPERATOR
    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR

    #=========================
    # Separators
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword ? PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR


#=============================
# Comments

context exclusive /\* \*/ COMMENT_BLOCK
    spellcheck
    keyword whole BUG KEYWORD_OTHER_TODO
    keyword whole FixMe KEYWORD_OTHER_TODO
    keyword whole FIXME KEYWORD_OTHER_TODO
    keyword whole Note KEYWORD_OTHER_TODO
    keyword whole NOTE KEYWORD_OTHER_TODO
    keyword whole ToDo KEYWORD_OTHER_TODO
    keyword whole TODO KEYWORD_OTHER_TODO
    keyword !!\[!\] KEYWORD_OTHER_TODO
    keyword ??\[?\] KEYWORD_OTHER_TODO


context exclusive // \n COMMENT_LINE
    spellcheck
    keyword whole BUG KEYWORD_OTHER_TODO
    keyword whole FixMe KEYWORD_OTHER_TODO
    keyword whole FIXME KEYWORD_OTHER_TODO
    keyword whole Note KEYWORD_OTHER_TODO
    keyword whole NOTE KEYWORD_OTHER_TODO
    keyword whole ToDo KEYWORD_OTHER_TODO
    keyword whole TODO KEYWORD_OTHER_TODO
    keyword !!\[!\] KEYWORD_OTHER_TODO
    keyword ??\[?\] KEYWORD_OTHER_TODO


#=============================
# Strings

context " " STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\\{\\'"abtnvfr\} CONSTANT_NUMERIC
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE

    keyword ' STRING_QUOTED_SINGLE

context ' ' STRING_QUOTED_SINGLE
    spellcheck
    keyword \\\{\\'"abtnvfr\} CONSTANT_NUMERIC
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE

    keyword " STRING_QUOTED_DOUBLE

context ` ` STRING_QUOTED_OTHER
    spellcheck
    keyword \\\{\\'"abtnvfr\} CONSTANT_NUMERIC
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE
    keyword ${*} VARIABLE_OTHER
