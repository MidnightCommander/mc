context default
    keyword linestart deb-src KEYWORD_OTHER_RESERVED
    keyword linestart deb KEYWORD_OTHER_RESERVED

    # Variables
    keyword \$\(ARCH\) VARIABLE_OTHER

    # Options (delimiters)
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION


# Options
context exclusive [ ]
    # Basic syntax elements
    keyword ! KEYWORD_OPERATOR
    keyword , PUNCTUATION_SEPARATOR
    keyword = KEYWORD_OPERATOR

    # Known options
    keyword whole arch ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole allow-downgrade-to-insecure ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole allow-insecure ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole allow-weak ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole by-hash ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole check-date ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole check-valid-until ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole date-max-future ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole inrelease-path ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole lang ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole pdiffs ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole signed-by ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole target ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole trusted ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole valid-until-max ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole valid-until-min ENTITY_OTHER_ATTRIBUTE_NAME

    # Known values
    keyword whole force CONSTANT_OTHER
    keyword whole no CONSTANT_LANGUAGE
    keyword whole yes CONSTANT_LANGUAGE

# Comment
context # \n COMMENT_LINE

# Common URI specifications
context cdrom\:\/ \s STRING_UNQUOTED
context copy\: \s STRING_UNQUOTED
context file\:\/ \s STRING_UNQUOTED
context ftp\:\/\/ \s STRING_UNQUOTED
context http\:\/\/ \s STRING_UNQUOTED
context https\:\/\/ \s STRING_UNQUOTED
context mirror\:\/\/ \s STRING_UNQUOTED
context mirror\+cdrom\:\/ \s STRING_UNQUOTED
context mirror\+copy\: \s STRING_UNQUOTED
context mirror\+file\:\/ \s STRING_UNQUOTED
context mirror\+ftp\:\/\/ \s STRING_UNQUOTED
context mirror\+https\:\/\/ \s STRING_UNQUOTED
context mirror\+rsh\:\/\/ \s STRING_UNQUOTED
context mirror\+ssh\:\/\/ \s STRING_UNQUOTED
context rsh\:\/\/ \s STRING_UNQUOTED
context ssh\:\/\/ \s STRING_UNQUOTED

# Other URI specifications
context mirror\+s3\:\/\/ \s STRING_UNQUOTED
context mirror\+tor\+http\:\/\/ \s STRING_UNQUOTED
context mirror\+tor\+https\:\/\/ \s STRING_UNQUOTED
context s3\:\/\/ \s STRING_UNQUOTED
context tor\+http\:\/\/ \s STRING_UNQUOTED
context tor\+https\:\/\/ \s STRING_UNQUOTED
