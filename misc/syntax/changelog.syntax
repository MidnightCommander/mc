context default
    spellcheck

context linestart \t \n\n
    keyword wholeright +() KEYWORD_OPERATOR
    keyword linestart \t\*\s*: ENTITY_NAME_OTHER
    keyword (*): ENTITY_NAME_OTHER
    keyword (*)\{\s\}[*]: ENTITY_NAME_OTHER

context linestart \s\s\s\s\s\s\s\s \n\n
    keyword wholeright +() KEYWORD_OPERATOR
    keyword \*\s*: ENTITY_NAME_OTHER
    keyword (*): ENTITY_NAME_OTHER
    keyword (*)\{\s\}[*]: ENTITY_NAME_OTHER
    keyword whole \* KEYWORD_OPERATOR

context linestart 19+-+\s \n CONSTANT_OTHER
    keyword <+> STRING_UNQUOTED
context linestart 20+-+\s \n CONSTANT_OTHER
    keyword <+> STRING_UNQUOTED
context linestart Mon\s \n CONSTANT_OTHER
    keyword <+> STRING_UNQUOTED
context linestart Tue\s \n CONSTANT_OTHER
    keyword <+> STRING_UNQUOTED
context linestart Wed\s \n CONSTANT_OTHER
    keyword <+> STRING_UNQUOTED
context linestart Thu\s \n CONSTANT_OTHER
    keyword <+> STRING_UNQUOTED
context linestart Fri\s \n CONSTANT_OTHER
    keyword <+> STRING_UNQUOTED
context linestart Sat\s \n CONSTANT_OTHER
    keyword <+> STRING_UNQUOTED
context linestart Sun\s \n CONSTANT_OTHER
    keyword <+> STRING_UNQUOTED
