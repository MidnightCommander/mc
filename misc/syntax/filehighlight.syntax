# Syntax highlighting rules for file highlighting rules
# check-tokens: literal colors by design

# Use \[\] at the end of keywords to suppress their special meaning

context default
    keyword whole black black blue
    keyword whole red red
    keyword whole green green
    keyword whole brown brown
    keyword whole blue blue black
    keyword whole magenta magenta
    keyword whole cyan cyan
    keyword whole lightgray lightgray
    keyword whole gray gray black
    keyword whole brightred brightred
    keyword whole brightgreen brightgreen
    keyword whole yellow yellow
    keyword whole brightblue brightblue black
    keyword whole brightmagenta brightmagenta
    keyword whole brightcyan brightcyan
    keyword whole white white

    keyword = KEYWORD_OPERATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword whole extensions KEYWORD_OTHER_RESERVED
    keyword whole extensions_case KEYWORD_OTHER_RESERVED
    keyword whole type KEYWORD_OTHER_RESERVED
    keyword DEVICE SUPPORT_CONSTANT
    keyword DIR SUPPORT_CONSTANT
    keyword FILE_EXE SUPPORT_CONSTANT
    keyword SPECIAL SUPPORT_CONSTANT
    keyword STALE_LINK SUPPORT_CONSTANT
    keyword SYMLINK SUPPORT_CONSTANT
    keyword HARDLINK SUPPORT_CONSTANT

context linestart # \n COMMENT_LINE

context linestart [ ] ENTITY_NAME_SECTION

context regexp= \n STRING_REGEXP
    keyword = KEYWORD_OPERATOR
    keyword whole regexp KEYWORD_OTHER_RESERVED

# regexp patterns
    keyword \\\/ CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\B CONSTANT_CHARACTER_ESCAPE
    keyword \\b CONSTANT_CHARACTER_ESCAPE
    keyword \\D CONSTANT_CHARACTER_ESCAPE
    keyword \\d CONSTANT_CHARACTER_ESCAPE
    keyword \\S CONSTANT_CHARACTER_ESCAPE
    keyword \\s CONSTANT_CHARACTER_ESCAPE
    keyword \\W CONSTANT_CHARACTER_ESCAPE
    keyword \\w CONSTANT_CHARACTER_ESCAPE
    keyword \\A CONSTANT_CHARACTER_ESCAPE
    keyword \\Z CONSTANT_CHARACTER_ESCAPE

    keyword \\( CONSTANT_CHARACTER_ESCAPE
    keyword \\) CONSTANT_CHARACTER_ESCAPE
    keyword \\[ CONSTANT_CHARACTER_ESCAPE
    keyword \\] CONSTANT_CHARACTER_ESCAPE
    keyword \\{ CONSTANT_CHARACTER_ESCAPE
    keyword \\} CONSTANT_CHARACTER_ESCAPE
    keyword \\$ CONSTANT_CHARACTER_ESCAPE
    keyword \\\+ CONSTANT_CHARACTER_ESCAPE
    keyword \\. CONSTANT_CHARACTER_ESCAPE
    keyword \\? CONSTANT_CHARACTER_ESCAPE
    keyword \\\* CONSTANT_CHARACTER_ESCAPE
    keyword \\^ CONSTANT_CHARACTER_ESCAPE
    keyword \\| CONSTANT_CHARACTER_ESCAPE

    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION

    keyword ?! KEYWORD_OPERATOR
    keyword ?# KEYWORD_OPERATOR
    keyword ?: KEYWORD_OPERATOR
    keyword ?= KEYWORD_OPERATOR
    keyword ?\{-imx:\}+ KEYWORD_OPERATOR

    keyword $ KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword . KEYWORD_OPERATOR
    keyword ? KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword ^ KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
