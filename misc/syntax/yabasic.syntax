    keyword // COMMENT_LINE

    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword ^ KEYWORD_OPERATOR
    keyword $ VARIABLE_OTHER
    keyword = KEYWORD_OPERATOR
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword . PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR

    keyword 0 CONSTANT_NUMERIC
    keyword 1 CONSTANT_NUMERIC
    keyword 2 CONSTANT_NUMERIC
    keyword 3 CONSTANT_NUMERIC
    keyword 4 CONSTANT_NUMERIC
    keyword 5 CONSTANT_NUMERIC
    keyword 6 CONSTANT_NUMERIC
    keyword 7 CONSTANT_NUMERIC
    keyword 8 CONSTANT_NUMERIC
    keyword 9 CONSTANT_NUMERIC

context " " STRING_QUOTED_DOUBLE
context exclusive // \n COMMENT_LINE
context exclusive rem \n COMMENT_LINE

spellcheck
