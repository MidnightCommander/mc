#
# NASM,WASM,TASM,MASM and GAS x86 syntax highlight
# // Mike Gorchak
# // Andres Farfan 2012
#

caseinsensitive

context default

# NASM directives
    keyword whole BITS KEYWORD_OTHER_RESERVED
    keyword whole SECTION KEYWORD_OTHER_RESERVED
    keyword whole SEGMENT KEYWORD_OTHER_RESERVED
    keyword whole ABSOLUTE KEYWORD_OTHER_RESERVED
    keyword whole EXTERN KEYWORD_OTHER_RESERVED
    keyword whole GLOBAL KEYWORD_OTHER_RESERVED
    keyword whole COMMON KEYWORD_OTHER_RESERVED
    keyword whole CPU KEYWORD_OTHER_RESERVED

# NASM, WASM, TASM, MASM and common modifiers
    keyword whole ALIGN KEYWORD_OTHER_RESERVED
    keyword whole ALIGNB KEYWORD_OTHER_RESERVED
    keyword whole STRUC KEYWORD_OTHER_RESERVED
    keyword whole ENDSTRUC KEYWORD_OTHER_RESERVED
    keyword whole ISTRUC KEYWORD_OTHER_RESERVED
    keyword whole IEND KEYWORD_OTHER_RESERVED
    keyword whole AT KEYWORD_OTHER_RESERVED
    keyword whole __FILE__ CONSTANT_OTHER
    keyword whole __LINE__ CONSTANT_OTHER
    keyword whole __NASM_VER__ CONSTANT_OTHER
    keyword whole __NASM_VERSION_ID__ CONSTANT_OTHER
    keyword whole __NASM_MAJOR__ CONSTANT_OTHER
    keyword whole __NASM_MINOR__ CONSTANT_OTHER
    keyword whole __NASM_SUBMINOR__ CONSTANT_OTHER
    keyword whole __NASM_PATCHLEVEL__ CONSTANT_OTHER
    keyword whole __SECT__ CONSTANT_OTHER
    keyword whole STRICT KEYWORD_OTHER_RESERVED
    keyword whole SEG KEYWORD_OTHER_RESERVED
    keyword whole WRT KEYWORD_OTHER_RESERVED
    keyword whole NOSPLIT KEYWORD_OTHER_RESERVED
    keyword whole BYTE STORAGE_TYPE
    keyword whole WORD STORAGE_TYPE
    keyword whole DWORD STORAGE_TYPE
    keyword whole QWORD STORAGE_TYPE
    keyword whole TWORD STORAGE_TYPE

# Pseudo instructions
    keyword whole ORG KEYWORD_OTHER_RESERVED
    keyword whole EQU KEYWORD_OTHER_RESERVED
    keyword whole DB STORAGE_TYPE
    keyword whole DW STORAGE_TYPE
    keyword whole DD STORAGE_TYPE
    keyword whole DQ STORAGE_TYPE
    keyword whole DT STORAGE_TYPE
    keyword whole RESB STORAGE_TYPE
    keyword whole RESW STORAGE_TYPE
    keyword whole RESD STORAGE_TYPE
    keyword whole RESQ STORAGE_TYPE
    keyword whole REST STORAGE_TYPE
    keyword whole INCBIN KEYWORD_CONTROL
    keyword whole TIMES KEYWORD_CONTROL

# GAS specific
    keyword whole .string KEYWORD_OTHER_RESERVED
    keyword whole .section KEYWORD_OTHER_RESERVED
    keyword whole .align KEYWORD_OTHER_RESERVED
    keyword whole .type KEYWORD_OTHER_RESERVED
    keyword whole .size KEYWORD_OTHER_RESERVED
    keyword whole .comm KEYWORD_OTHER_RESERVED
    keyword whole .ident KEYWORD_OTHER_RESERVED
    keyword whole .globl KEYWORD_OTHER_RESERVED
    keyword whole .rodata ENTITY_NAME_SECTION
    keyword whole .data ENTITY_NAME_SECTION
    keyword whole .text ENTITY_NAME_SECTION
    keyword whole .bss ENTITY_NAME_SECTION

# NASM/TASM Macroses
    keyword whole %ifdef META_PREPROCESSOR
    keyword whole %define META_PREPROCESSOR
    keyword whole %else META_PREPROCESSOR
    keyword whole %elif META_PREPROCESSOR
    keyword whole %endif META_PREPROCESSOR
    keyword whole %macro META_PREPROCESSOR
    keyword whole %endmacro META_PREPROCESSOR
    keyword whole %rep META_PREPROCESSOR
    keyword whole %repl META_PREPROCESSOR
    keyword whole %strlen META_PREPROCESSOR
    keyword whole %substr META_PREPROCESSOR
    keyword whole %arg META_PREPROCESSOR
    keyword whole %stacksize META_PREPROCESSOR
    keyword whole %local META_PREPROCESSOR
    keyword whole %push META_PREPROCESSOR
    keyword whole %pop META_PREPROCESSOR
    keyword whole %line META_PREPROCESSOR
    keyword whole %\! META_PREPROCESSOR
    keyword whole %\+ META_PREPROCESSOR

# Generic 16-bit registers set
    keyword whole %al CONSTANT_OTHER
    keyword whole %bl CONSTANT_OTHER
    keyword whole %cl CONSTANT_OTHER
    keyword whole %dl CONSTANT_OTHER
    keyword whole %ah CONSTANT_OTHER
