# ---------------------------------------------------
# f90.syntax
# FORTRAN 90/95 language freeform syntax highlighting template.
# Provides syntax highlighting rules for the
# FORTRAN programming language.
#
# Based on FORTRAN77 version fortran.syntax
# Author: John Theal
# Email: jtheal@renegadelinuxbox.dhs.org
# December 7, 1999
# ---------------------------------------------------

# Heavily modified by Paul Sheer <psheer@obsidian.co.za>.
# Adjusted to Fortran 90 by Norbert Nemec <Norbert@Nemec-online.de>.

caseinsensitive

context default
# keywords at the beginning of line
    keyword linestart \{0123456789\}\{0123456789\}\{0123456789\}\{0123456789\}\{0123456789\} CONSTANT_NUMERIC
    keyword linestart \{0123456789\}\{0123456789\}\{0123456789\}\{0123456789\} CONSTANT_NUMERIC
    keyword linestart \{0123456789\}\{0123456789\}\{0123456789\} CONSTANT_NUMERIC
    keyword linestart \{0123456789\}\{0123456789\} CONSTANT_NUMERIC
    keyword linestart \{0123456789\} CONSTANT_NUMERIC

# structure
    keyword whole ASSIGNMENT KEYWORD_OTHER_RESERVED black
    keyword whole CONTAINS KEYWORD_OTHER_RESERVED black
    keyword whole END KEYWORD_CONTROL black
    keyword whole FUNCTION STORAGE_TYPE black
    keyword whole INTERFACE STORAGE_TYPE_CLASS black
    keyword whole INCLUDE KEYWORD_CONTROL_IMPORT black
    keyword whole MODULE STORAGE_TYPE black
    keyword whole OPERATOR KEYWORD_OTHER_RESERVED black
    keyword whole PROGRAM STORAGE_TYPE black
    keyword whole SUBROUTINE STORAGE_TYPE black

# boolean and logical expressions / operators
    keyword .and. KEYWORD_OPERATOR_WORD orange
    keyword .eq. KEYWORD_OPERATOR_WORD orange
    keyword .eqv. KEYWORD_OPERATOR_WORD orange
    keyword .false. CONSTANT_LANGUAGE orange
    keyword .ge. KEYWORD_OPERATOR_WORD orange
    keyword .gt. KEYWORD_OPERATOR_WORD orange
    keyword .le. KEYWORD_OPERATOR_WORD orange
    keyword .lt. KEYWORD_OPERATOR_WORD orange
    keyword .ne. KEYWORD_OPERATOR_WORD orange
    keyword .neqv. KEYWORD_OPERATOR_WORD orange
    keyword .not. KEYWORD_OPERATOR_WORD orange
    keyword .or. KEYWORD_OPERATOR_WORD orange
    keyword .true. CONSTANT_LANGUAGE orange
    keyword whole lge KEYWORD_OPERATOR_WORD orange
    keyword whole lgt KEYWORD_OPERATOR_WORD orange
    keyword whole lle KEYWORD_OPERATOR_WORD orange
    keyword whole llt KEYWORD_OPERATOR_WORD orange

# declarations
    keyword whole ALLOCATABLE STORAGE_MODIFIER
    keyword whole BLOCK KEYWORD_OTHER_RESERVED
    keyword whole CHARACTER STORAGE_TYPE_PRIMITIVE
    keyword whole COMMON KEYWORD_OTHER_RESERVED
    keyword whole COMPLEX STORAGE_TYPE_PRIMITIVE
    keyword whole DATA KEYWORD_OTHER_RESERVED
    keyword whole DIMENSION KEYWORD_OTHER_RESERVED
    keyword whole DOUBLE STORAGE_TYPE_PRIMITIVE
    keyword whole ELEMENTAL STORAGE_MODIFIER
    keyword whole EQUIVALENCE KEYWORD_OTHER_RESERVED
    keyword whole EXTERNAL STORAGE_MODIFIER
    keyword whole FORMAT KEYWORD_OTHER_RESERVED
    keyword whole IMPLICIT KEYWORD_OTHER_RESERVED
    keyword whole INTEGER STORAGE_TYPE_PRIMITIVE
    keyword whole INTENT STORAGE_MODIFIER
    keyword whole INTRINSIC KEYWORD_OTHER_RESERVED
    keyword whole LOGICAL STORAGE_TYPE_PRIMITIVE
    keyword whole NAMELIST KEYWORD_OTHER_RESERVED
    keyword whole NONE KEYWORD_OTHER_RESERVED
    keyword whole ONLY KEYWORD_CONTROL_IMPORT
    keyword whole OPTIONAL STORAGE_MODIFIER
    keyword whole PARAMETER STORAGE_MODIFIER
    keyword whole POINTER STORAGE_MODIFIER
    keyword whole PRECISION STORAGE_TYPE_PRIMITIVE
    keyword whole PRIVATE STORAGE_MODIFIER
    keyword whole PUBLIC STORAGE_MODIFIER
    keyword whole PURE STORAGE_MODIFIER
    keyword whole REAL STORAGE_TYPE_PRIMITIVE
    keyword whole SAVE STORAGE_MODIFIER
    keyword whole TYPE STORAGE_TYPE_CLASS
    keyword whole USE KEYWORD_CONTROL_IMPORT

# general programming syntax
    keyword whole allocate KEYWORD_OTHER_RESERVED
    keyword whole assign KEYWORD_OTHER_RESERVED
    keyword whole call KEYWORD_CONTROL
    keyword whole case KEYWORD_CONTROL
    keyword whole deallocate KEYWORD_OTHER_RESERVED
    keyword whole default KEYWORD_CONTROL
    keyword whole continue KEYWORD_CONTROL
    keyword whole cycle KEYWORD_CONTROL
    keyword whole do KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole elseif KEYWORD_CONTROL
    keyword whole elsewhere KEYWORD_CONTROL
    keyword whole end KEYWORD_CONTROL
    keyword whole enddo KEYWORD_CONTROL
    keyword whole endif KEYWORD_CONTROL
    keyword whole exit KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole forall KEYWORD_CONTROL
    keyword whole goto KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole nullify KEYWORD_OTHER_RESERVED
    keyword whole pause KEYWORD_CONTROL
    keyword whole return KEYWORD_CONTROL
    keyword whole select KEYWORD_CONTROL
    keyword whole stop KEYWORD_CONTROL
    keyword whole target STORAGE_MODIFIER
    keyword whole then KEYWORD_CONTROL
    keyword whole to KEYWORD_CONTROL
    keyword whole where KEYWORD_CONTROL
    keyword whole while KEYWORD_CONTROL

# headers
    keyword whole entry KEYWORD_OTHER_RESERVED

# I/O functions
# may have optional equal signs after them: 'keyword ='
    keyword whole access KEYWORD_OTHER_RESERVED
    keyword whole backspace KEYWORD_OTHER_RESERVED
    keyword whole blank KEYWORD_OTHER_RESERVED
    keyword whole close KEYWORD_OTHER_RESERVED
    keyword whole direct KEYWORD_OTHER_RESERVED
    keyword whole endfile KEYWORD_OTHER_RESERVED
    keyword whole err KEYWORD_OTHER_RESERVED
    keyword whole exist KEYWORD_OTHER_RESERVED
    keyword whole file KEYWORD_OTHER_RESERVED
    keyword whole fmt KEYWORD_OTHER_RESERVED
    keyword whole form KEYWORD_OTHER_RESERVED
    keyword whole formatted KEYWORD_OTHER_RESERVED
    keyword whole inquire KEYWORD_OTHER_RESERVED
    keyword whole iostat KEYWORD_OTHER_RESERVED
    keyword whole name KEYWORD_OTHER_RESERVED
    keyword whole named KEYWORD_OTHER_RESERVED
    keyword whole nextrec KEYWORD_OTHER_RESERVED
    keyword whole number KEYWORD_OTHER_RESERVED
    keyword whole open KEYWORD_OTHER_RESERVED
    keyword whole opened KEYWORD_OTHER_RESERVED
    keyword whole print KEYWORD_OTHER_RESERVED
    keyword whole read KEYWORD_OTHER_RESERVED
    keyword whole rec KEYWORD_OTHER_RESERVED
    keyword whole recl KEYWORD_OTHER_RESERVED
    keyword whole rewind KEYWORD_OTHER_RESERVED
    keyword whole sequential KEYWORD_OTHER_RESERVED
    keyword whole status KEYWORD_OTHER_RESERVED
    keyword whole unformatted KEYWORD_OTHER_RESERVED
    keyword whole unit KEYWORD_OTHER_RESERVED
    keyword whole write KEYWORD_OTHER_RESERVED

# mathematical functions
    keyword whole abs SUPPORT_FUNCTION
    keyword whole achar SUPPORT_FUNCTION
    keyword whole acos SUPPORT_FUNCTION
    keyword whole aimag SUPPORT_FUNCTION
    keyword whole aint SUPPORT_FUNCTION
    keyword whole alog SUPPORT_FUNCTION
    keyword whole alog10 SUPPORT_FUNCTION
    keyword whole amax0 SUPPORT_FUNCTION
    keyword whole amax1 SUPPORT_FUNCTION
    keyword whole amin0 SUPPORT_FUNCTION
    keyword whole amin1 SUPPORT_FUNCTION
    keyword whole amod SUPPORT_FUNCTION
    keyword whole anint SUPPORT_FUNCTION
    keyword whole aprime SUPPORT_FUNCTION
    keyword whole asin SUPPORT_FUNCTION
    keyword whole atan SUPPORT_FUNCTION
    keyword whole atan2 SUPPORT_FUNCTION
    keyword whole acos SUPPORT_FUNCTION
    keyword whole cabs SUPPORT_FUNCTION
    keyword whole ceiling SUPPORT_FUNCTION
    keyword whole cexp SUPPORT_FUNCTION
    keyword whole char SUPPORT_FUNCTION
    keyword whole clog SUPPORT_FUNCTION
    keyword whole cmplx SUPPORT_FUNCTION
    keyword whole conjg SUPPORT_FUNCTION
    keyword whole cos SUPPORT_FUNCTION
    keyword whole cosh SUPPORT_FUNCTION
    keyword whole ccos SUPPORT_FUNCTION
    keyword whole csin SUPPORT_FUNCTION
    keyword whole csqrt SUPPORT_FUNCTION
    keyword whole dabs SUPPORT_FUNCTION
    keyword whole dacos SUPPORT_FUNCTION
    keyword whole dasin SUPPORT_FUNCTION
    keyword whole datan SUPPORT_FUNCTION
    keyword whole datan2 SUPPORT_FUNCTION
    keyword whole dble SUPPORT_FUNCTION
    keyword whole dcos SUPPORT_FUNCTION
    keyword whole dcosh SUPPORT_FUNCTION
    keyword whole dfloat SUPPORT_FUNCTION
    keyword whole ddmim SUPPORT_FUNCTION
    keyword whole dexp SUPPORT_FUNCTION
    keyword whole dim SUPPORT_FUNCTION
    keyword whole dint SUPPORT_FUNCTION
    keyword whole dlog SUPPORT_FUNCTION
    keyword whole dlog10 SUPPORT_FUNCTION
    keyword whole dmax1 SUPPORT_FUNCTION
    keyword whole dmin1 SUPPORT_FUNCTION
    keyword whole dmod SUPPORT_FUNCTION
    keyword whole dnint SUPPORT_FUNCTION
    keyword whole dsign SUPPORT_FUNCTION
    keyword whole dsin SUPPORT_FUNCTION
    keyword whole dsinh SUPPORT_FUNCTION
    keyword whole dsqrt SUPPORT_FUNCTION
    keyword whole dtan SUPPORT_FUNCTION
    keyword whole dtanh SUPPORT_FUNCTION
    keyword whole exp SUPPORT_FUNCTION
    keyword whole float SUPPORT_FUNCTION
    keyword whole floor SUPPORT_FUNCTION
    keyword whole iabs SUPPORT_FUNCTION
    keyword whole iachar SUPPORT_FUNCTION
    keyword whole ichar SUPPORT_FUNCTION
    keyword whole idim SUPPORT_FUNCTION
    keyword whole idint SUPPORT_FUNCTION
    keyword whole ifix SUPPORT_FUNCTION
    keyword whole index SUPPORT_FUNCTION
    keyword whole int SUPPORT_FUNCTION
    keyword whole isign SUPPORT_FUNCTION
    keyword whole len SUPPORT_FUNCTION
    keyword whole log SUPPORT_FUNCTION
    keyword whole log10 SUPPORT_FUNCTION
    keyword whole matmul SUPPORT_FUNCTION
    keyword whole max SUPPORT_FUNCTION
    keyword whole max0 SUPPORT_FUNCTION
    keyword whole max1 SUPPORT_FUNCTION
    keyword whole maxval SUPPORT_FUNCTION
    keyword whole min SUPPORT_FUNCTION
    keyword whole min0 SUPPORT_FUNCTION
    keyword whole min1 SUPPORT_FUNCTION
    keyword whole minval SUPPORT_FUNCTION
    keyword whole mod SUPPORT_FUNCTION
    keyword whole nint SUPPORT_FUNCTION
    keyword whole product SUPPORT_FUNCTION
    keyword whole rand SUPPORT_FUNCTION
    keyword whole random_number SUPPORT_FUNCTION
    keyword whole random_seed SUPPORT_FUNCTION
    keyword whole sign SUPPORT_FUNCTION
    keyword whole sin SUPPORT_FUNCTION
    keyword whole sinh SUPPORT_FUNCTION
    keyword whole sngl SUPPORT_FUNCTION
    keyword whole sqrt SUPPORT_FUNCTION
    keyword whole sum SUPPORT_FUNCTION
    keyword whole tan SUPPORT_FUNCTION
    keyword whole tanh SUPPORT_FUNCTION
    keyword whole transpose SUPPORT_FUNCTION

# operators and syntax elements
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword : PUNCTUATION_SEPARATOR
    keyword , PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword > KEYWORD_OPERATOR

# comments and quotes
    keyword '*' STRING_QUOTED_SINGLE
    keyword "*" STRING_QUOTED_DOUBLE

#context &\n \n black cyan
    keyword &\n PUNCTUATION_SEPARATOR_CONTINUATION cyan

context format( ) STRING_QUOTED_OTHER

context ! \n COMMENT_LINE
   spellcheck
