# kotlin.syntax
#
# URL: https://github.com/anvabr/kotlin.syntax
#
# License: GNU General Public License v3.0

context default

# hard keywords
	keyword whole as KEYWORD_OPERATOR_WORD
	keyword whole as? KEYWORD_OPERATOR_WORD
	keyword whole break KEYWORD_CONTROL
	keyword whole class STORAGE_TYPE_CLASS
	keyword whole continue KEYWORD_CONTROL
	keyword whole do KEYWORD_CONTROL
	keyword whole else KEYWORD_CONTROL
	keyword whole false CONSTANT_LANGUAGE
	keyword whole for KEYWORD_CONTROL
	keyword whole fun STORAGE_TYPE_FUNCTION
	keyword whole if KEYWORD_CONTROL
	keyword whole in KEYWORD_OPERATOR_WORD
	keyword whole !in KEYWORD_OPERATOR_WORD
	keyword whole interface STORAGE_TYPE_CLASS
	keyword whole is KEYWORD_OPERATOR_WORD
	keyword whole !is KEYWORD_OPERATOR_WORD
	keyword whole null CONSTANT_LANGUAGE
	keyword whole object STORAGE_TYPE_CLASS
	keyword whole package KEYWORD_OTHER_PACKAGE
	keyword whole return KEYWORD_CONTROL
	keyword whole super VARIABLE_LANGUAGE
	keyword whole this VARIABLE_LANGUAGE
	keyword whole throw KEYWORD_CONTROL
	keyword whole true CONSTANT_LANGUAGE
	keyword whole try KEYWORD_CONTROL
	keyword whole typealias STORAGE_TYPE
	keyword whole val STORAGE_TYPE
	keyword whole var STORAGE_TYPE
	keyword whole when KEYWORD_CONTROL
	keyword whole while KEYWORD_CONTROL	

# soft keywords
	keyword whole by KEYWORD_OTHER
	keyword whole catch KEYWORD_CONTROL
	keyword whole constructor KEYWORD_OTHER
	keyword whole delegate KEYWORD_OTHER
	keyword whole dynamic KEYWORD_OTHER
#	keyword whole field brightgreen
	keyword whole file KEYWORD_OTHER
	keyword whole finally KEYWORD_CONTROL
	keyword whole get KEYWORD_OTHER
	keyword whole import KEYWORD_CONTROL_IMPORT
	keyword whole init KEYWORD_OTHER
	keyword whole param KEYWORD_OTHER
	keyword whole property KEYWORD_OTHER
	keyword whole reciever KEYWORD_OTHER
	keyword whole set KEYWORD_OTHER
	keyword whole setparam KEYWORD_OTHER
	keyword whole where KEYWORD_OTHER

# modifier keywords
	keyword whole abstract STORAGE_MODIFIER
	keyword whole annotation STORAGE_MODIFIER
	keyword whole companion STORAGE_MODIFIER
	keyword whole const STORAGE_MODIFIER
	keyword whole crossinline STORAGE_MODIFIER
	keyword whole data STORAGE_MODIFIER
	keyword whole enum STORAGE_TYPE_CLASS
	keyword whole external STORAGE_MODIFIER
	keyword whole final STORAGE_MODIFIER
	keyword whole infix STORAGE_MODIFIER
	keyword whole inline STORAGE_MODIFIER
	keyword whole inner STORAGE_MODIFIER
	keyword whole internal STORAGE_MODIFIER
	keyword whole lateinit STORAGE_MODIFIER
	keyword whole noinline STORAGE_MODIFIER
	keyword whole open STORAGE_MODIFIER
	keyword whole operator STORAGE_MODIFIER
	keyword whole out STORAGE_MODIFIER
	keyword whole override STORAGE_MODIFIER
	keyword whole private STORAGE_MODIFIER
	keyword whole protected STORAGE_MODIFIER
	keyword whole public STORAGE_MODIFIER
	keyword whole reified STORAGE_MODIFIER
	keyword whole sealed STORAGE_MODIFIER
	keyword whole suspend STORAGE_MODIFIER
	keyword whole tailrec STORAGE_MODIFIER
	keyword whole vararg STORAGE_MODIFIER

# special identifiers
	keyword whole field VARIABLE_LANGUAGE
	keyword whole it VARIABLE_LANGUAGE

	keyword @\[ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\] STORAGE_TYPE_ANNOTATION	
	keyword \[ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\]@ ENTITY_NAME_LABEL

# operators and special symbols
	keyword \+ KEYWORD_OPERATOR
	keyword - KEYWORD_OPERATOR
	keyword \* KEYWORD_OPERATOR
	keyword / KEYWORD_OPERATOR
	keyword % KEYWORD_OPERATOR
	keyword = KEYWORD_OPERATOR
	keyword \+= KEYWORD_OPERATOR
	keyword -= KEYWORD_OPERATOR
	keyword \*= KEYWORD_OPERATOR
	keyword /= KEYWORD_OPERATOR
	keyword %= KEYWORD_OPERATOR
	keyword \+\+ KEYWORD_OPERATOR
	keyword -- KEYWORD_OPERATOR
	keyword && KEYWORD_OPERATOR
	keyword || KEYWORD_OPERATOR
	keyword ! KEYWORD_OPERATOR
	keyword == KEYWORD_OPERATOR
	keyword != KEYWORD_OPERATOR
	keyword === KEYWORD_OPERATOR
	keyword !== KEYWORD_OPERATOR
	keyword > KEYWORD_OPERATOR
	keyword < KEYWORD_OPERATOR
	keyword >= KEYWORD_OPERATOR
	keyword <= KEYWORD_OPERATOR
	keyword [ PUNCTUATION_SECTION
	keyword ] PUNCTUATION_SECTION
	keyword !! KEYWORD_OPERATOR
	keyword ?. KEYWORD_OPERATOR
	keyword ?: KEYWORD_OPERATOR
	keyword :: KEYWORD_OPERATOR
	keyword .. KEYWORD_OPERATOR
	keyword : PUNCTUATION_SEPARATOR
	keyword ? PUNCTUATION_SEPARATOR
	keyword -> KEYWORD_OPERATOR
	keyword @ STORAGE_TYPE_ANNOTATION
	keyword ; PUNCTUATION_TERMINATOR
	keyword $ VARIABLE_OTHER
	keyword _ KEYWORD_OTHER_RESERVED

# built-in types
	keyword whole Double SUPPORT_TYPE
	keyword whole Float SUPPORT_TYPE
	keyword whole Long SUPPORT_TYPE
	keyword whole Int SUPPORT_TYPE
	keyword whole Short SUPPORT_TYPE
	keyword whole Byte SUPPORT_TYPE
	keyword whole Char SUPPORT_TYPE
	keyword whole Boolean SUPPORT_TYPE
	keyword whole Array SUPPORT_TYPE
	keyword whole String SUPPORT_TYPE
	keyword whole ByteArray SUPPORT_TYPE
	keyword whole ByteSequence SUPPORT_TYPE

# comment
context exclusive /\* \*/ COMMENT_BLOCK
context exclusive // \n COMMENT_LINE

context """ """ STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_OTHER_PLACEHOLDER
    keyword %\[#0\s-\+,\]\[0123456789\*\]\[.\]\[0123456789\*\]\[L\]\{eEfgGoxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[0\s-\+,\]\[0123456789\*\]\[.\]\[0123456789\*\]\[hl\]\{diuxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[hl\]n CONSTANT_OTHER_PLACEHOLDER
    keyword %\[-\]\[0123456789\*\]\[.\]\[0123456789\*\]s CONSTANT_OTHER_PLACEHOLDER
    keyword %[*] CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword %p CONSTANT_OTHER_PLACEHOLDER
    keyword $\[0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\] VARIABLE_OTHER
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE

context ' ' STRING_QUOTED_SINGLE

context " " STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_OTHER_PLACEHOLDER
    keyword %\[#0\s-\+,\]\[0123456789\*\]\[.\]\[0123456789\*\]\[L\]\{eEfgGoxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[0\s-\+,\]\[0123456789\*\]\[.\]\[0123456789\*\]\[hl\]\{diuxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[hl\]n CONSTANT_OTHER_PLACEHOLDER
    keyword %\[-\]\[0123456789\*\]\[.\]\[0123456789\*\]s CONSTANT_OTHER_PLACEHOLDER
    keyword %[*] CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword %p CONSTANT_OTHER_PLACEHOLDER
    keyword $\[0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\] VARIABLE_OTHER
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE
