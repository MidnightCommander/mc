    keyword whole MAILDIR VARIABLE_OTHER
    keyword whole DEFAULT VARIABLE_OTHER
    keyword whole LOGFILE VARIABLE_OTHER
    keyword whole VERBOSE VARIABLE_OTHER
    keyword whole LOGABSTRACT VARIABLE_OTHER
    keyword whole LOG VARIABLE_OTHER
