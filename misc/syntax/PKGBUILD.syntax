context # \n COMMENT_LINE
    spellcheck

context exclusive whole <<\[\s\]\[-\]\[\s\]\[\\\]EOF EOF STRING_QUOTED_OTHER
context exclusive whole <<\[\s\]\[-\]\[\s\]\[\\\]END END STRING_QUOTED_OTHER

context ' ' STRING_QUOTED_SINGLE

context " " STRING_QUOTED_DOUBLE
    keyword whole $srcdir VARIABLE_OTHER
    keyword whole $pkgdir VARIABLE_OTHER
    keyword whole $startdir VARIABLE_OTHER
    keyword whole ${srcdir} VARIABLE_OTHER
    keyword whole ${pkgdir} VARIABLE_OTHER
