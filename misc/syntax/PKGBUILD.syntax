    keyword \\* CONSTANT_CHARACTER_ESCAPE
    keyword \\@ CONSTANT_CHARACTER_ESCAPE
    keyword \\$ CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\` CONSTANT_CHARACTER_ESCAPE
