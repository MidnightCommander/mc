    keyword whole UMASK VARIABLE_OTHER
    keyword whole SHELLMETAS VARIABLE_OTHER
    keyword whole SHELLFLAGS VARIABLE_OTHER
    keyword whole SENDMAIL VARIABLE_OTHER
    keyword whole SENDMAILFLAGS VARIABLE_OTHER
    keyword whole NORESRETRY VARIABLE_OTHER
    keyword whole SUSPEND VARIABLE_OTHER
    keyword whole LINEBUF VARIABLE_OTHER
    keyword whole DELIVERED VARIABLE_OTHER
    keyword whole TRAP VARIABLE_OTHER
    keyword whole EXITCODE VARIABLE_OTHER
    keyword whole LASTFOLDER VARIABLE_OTHER
