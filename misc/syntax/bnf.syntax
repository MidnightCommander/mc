# BNF family (BNF, EBNF, ABNF, WBNF etc.) Syntax Highlighting Definition
# Version 3.0.1 2026-03-25
# See updates and changelog at https://github.com/jip/syntax-highlighting
#
# Backus-Naur form (BNF) is a notation technique for context-free grammars
#
# This file is part of GNU Midnight Commander
# https://midnight-commander.org/
#
# SPDX-FileCopyrightText: 2026 Igor Zhuravlov <zhuravlov.ip@ya.ru>
# SPDX-License-Identifier: GPL-3.0-or-later

# for the default (lightgray on blue)
define _alerthi KEYWORD_OTHER_TODO red
define _alertmi KEYWORD_OTHER_TODO yellow
define _alertlo KEYWORD_OTHER_TODO cyan
define _lbl     ENTITY_NAME_OTHER blue underline

context default
    # labels
    keyword \{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._\]: _lbl
    # nonterminals
    keyword <\{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._\]> VARIABLE_OTHER
    keyword \{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._\] VARIABLE_OTHER
    # decimal integer numbers
    keyword wholeleft 0 CONSTANT_NUMERIC
    keyword wholeleft \{123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    keyword wholeleft -\{123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    # repeaters (EBNF)
    keyword (/ PUNCTUATION_SECTION
    keyword /) PUNCTUATION_SECTION
    keyword (: PUNCTUATION_SECTION
    keyword :) PUNCTUATION_SECTION
    # exclude from highlighting
    keyword ::== KEYWORD_OPERATOR blue
    # assignments
    keyword :≡ KEYWORD_OPERATOR
    keyword :== KEYWORD_OPERATOR
    keyword := KEYWORD_OPERATOR
    keyword ::= KEYWORD_OPERATOR
    keyword :: KEYWORD_OPERATOR
    keyword : KEYWORD_OPERATOR
    keyword => KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword <- KEYWORD_OPERATOR
    keyword -> KEYWORD_OPERATOR
    keyword <= KEYWORD_OPERATOR
    keyword ← KEYWORD_OPERATOR
    keyword → KEYWORD_OPERATOR
    keyword ⇐ KEYWORD_OPERATOR
    keyword ⇒ KEYWORD_OPERATOR
    keyword ≜ KEYWORD_OPERATOR
    # combinators
    keyword | KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword \\ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword , PUNCTUATION_SEPARATOR
    # operators
    keyword ! KEYWORD_OPERATOR
    keyword # KEYWORD_OPERATOR
    keyword $ KEYWORD_OPERATOR
#    keyword % _oper
    keyword & KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword ? KEYWORD_OPERATOR
    keyword @ KEYWORD_OPERATOR
    keyword ^ KEYWORD_OPERATOR
    keyword ~ KEYWORD_OPERATOR
    # grouping
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword < PUNCTUATION_SECTION
    keyword > PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    # concatenator,separator,terminator
    keyword \{.;\} PUNCTUATION_TERMINATOR

# strings

context ' ' STRING_QUOTED_SINGLE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE
    keyword \\x\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\} CONSTANT_CHARACTER_ESCAPE
    keyword \\u\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\} CONSTANT_CHARACTER_ESCAPE
    keyword \\U\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\} CONSTANT_CHARACTER_ESCAPE

context " " STRING_QUOTED_DOUBLE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE
    keyword \\x\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\} CONSTANT_CHARACTER_ESCAPE
    keyword \\u\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\} CONSTANT_CHARACTER_ESCAPE
    keyword \\U\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\} CONSTANT_CHARACTER_ESCAPE

# special sequence

context ` ` STRING_QUOTED_OTHER
    keyword \\` CONSTANT_CHARACTER_ESCAPE

# comments

context % % COMMENT_BLOCK
    keyword \\% COMMENT_BLOCK
    keyword whole BUG        _alerthi
    keyword whole DEPRECATED _alertmi
    keyword whole FIXME      _alerthi
    keyword whole NOTE       _alertlo
    keyword whole TEST       _alertlo
    keyword whole TODO       _alertmi
    keyword whole WARN       _alertmi
    spellcheck
