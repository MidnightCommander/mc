    keyword /\* COMMENT_BLOCK
    keyword \*/ COMMENT_BLOCK
    keyword -- COMMENT_LINE

    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword . KEYWORD_OPERATOR

# PostgreSQL specific
    keyword aggregate KEYWORD_OTHER
    keyword checkpoint KEYWORD_OTHER
    keyword cluster KEYWORD_OTHER
    keyword conversion KEYWORD_OTHER
    keyword listen KEYWORD_OTHER
    keyword notify KEYWORD_OTHER
    keyword operator KEYWORD_OTHER
    keyword reindex KEYWORD_OTHER
    keyword savepoint KEYWORD_OTHER
    keyword unlisten KEYWORD_OTHER
    keyword vacuum KEYWORD_OTHER

    keyword createdb KEYWORD_OTHER
    keyword createuser KEYWORD_OTHER
    keyword nocreatedb KEYWORD_OTHER
    keyword nocreateuser KEYWORD_OTHER
    keyword password KEYWORD_OTHER
    keyword sysid KEYWORD_OTHER

    keyword currval SUPPORT_FUNCTION
    keyword nextval SUPPORT_FUNCTION
    keyword pg_database SUPPORT_TYPE
    keyword pg_group SUPPORT_TYPE
    keyword pg_shadow SUPPORT_TYPE
    keyword setval SUPPORT_FUNCTION
    keyword stdin KEYWORD_OTHER

# PostgreSQL sequences
    keyword cache KEYWORD_OTHER
    keyword increment KEYWORD_OTHER
    keyword maxvalue KEYWORD_OTHER
    keyword minvalue KEYWORD_OTHER
    keyword start KEYWORD_OTHER

# Oracle specific
    keyword dual SUPPORT_TYPE
    keyword whole lag SUPPORT_FUNCTION
    keyword whole lead SUPPORT_FUNCTION
    keyword whole nvl SUPPORT_FUNCTION
    keyword whole over KEYWORD_OTHER
    keyword whole partition KEYWORD_OTHER
    keyword whole pragma KEYWORD_OTHER
    keyword whole varchar2 STORAGE_TYPE
    keyword whole sys_refcursor STORAGE_TYPE

# MySQL comment
context linestart # \n COMMENT_LINE
    spellcheck

# ANSI SQL comment
context exclusive -- \n COMMENT_LINE
    spellcheck

context exclusive /\* \*/ COMMENT_BLOCK
    spellcheck

context ' ' STRING_QUOTED_SINGLE
    keyword \\' CONSTANT_CHARACTER_ESCAPE

context " " STRING_QUOTED_DOUBLE
    keyword \\" CONSTANT_CHARACTER_ESCAPE

# Beckticks are used to escape reserved words in MySQL
context ` ` STRING_QUOTED_OTHER
    keyword . KEYWORD_OPERATOR
