# Syntax highlighting rules for syntax highlighting rules
# check-tokens: literal colors by design

# Use \[\] at the end of keywords to suppress their special meaning

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.\\[]{}

context default
# Invalid combinations, not highlighted
    keyword whole linestart\[\t\s\]whole
    keyword whole linestart\[\t\s\]wholeleft
    keyword whole linestart\[\t\s\]wholeright

# Combinations below are valid
    keyword whole whole\[\t\s\]linestart KEYWORD_OTHER_RESERVED
    keyword whole wholeleft\[\t\s\]linestart KEYWORD_OTHER_RESERVED
    keyword whole wholeright\[\t\s\]linestart KEYWORD_OTHER_RESERVED
    keyword whole whole\[\] KEYWORD_OTHER_RESERVED
    keyword whole wholeleft\[\] KEYWORD_OTHER_RESERVED
    keyword whole wholeright\[\] KEYWORD_OTHER_RESERVED
    keyword whole linestart\[\] KEYWORD_OTHER_RESERVED

    keyword whole wholechars\[\t\s\]left KEYWORD_OTHER_RESERVED
    keyword whole wholechars\[\t\s\]right KEYWORD_OTHER_RESERVED
    keyword whole wholechars\[\] KEYWORD_OTHER_RESERVED
    keyword whole define\[\] KEYWORD_OTHER_RESERVED

    keyword whole spellcheck\[\] KEYWORD_OTHER_RESERVED
    keyword whole keyword\[\] KEYWORD_OTHER_RESERVED
    keyword whole context\[\t\s\]exclusive KEYWORD_OTHER_RESERVED
    keyword whole context\[\t\s\]default KEYWORD_OTHER_RESERVED
    keyword whole context\[\] KEYWORD_OTHER_RESERVED
    keyword whole caseinsensitive\[\] KEYWORD_OTHER_RESERVED

    keyword whole linestart file\[\] KEYWORD_CONTROL_IMPORT
    keyword whole linestart include\[\] KEYWORD_CONTROL_IMPORT

    keyword whole black black blue
    keyword whole red red
    keyword whole green green
    keyword whole brown brown
    keyword whole blue blue black
    keyword whole magenta magenta
    keyword whole cyan cyan
    keyword whole lightgray lightgray
    keyword whole gray gray black
    keyword whole brightred brightred
    keyword whole brightgreen brightgreen
    keyword whole yellow yellow
    keyword whole brightblue brightblue black
    keyword whole brightmagenta brightmagenta
    keyword whole brightcyan brightcyan
    keyword whole white white

context linestart # \n COMMENT_LINE
    spellcheck

# Ideally we would have defined comments with "context linestart \[\s\]# ...",
# but contexts can't start with a character class. So we define comments twice.
context linestart \s\[\s\]# \n COMMENT_LINE
    spellcheck
