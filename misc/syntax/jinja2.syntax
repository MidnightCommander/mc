# Jinja2 template syntax highlighting
#
# Reference:
#   https://jinja.palletsprojects.com/en/stable/templates/
#
# Highlights the Jinja2 template constructs:
#   {{ ... }}    output / expression tags
#   {% ... %}    statement / block tags (if / for / set / block / macro / ...)
#   {# ... #}    comments
#   # ...        line comments (typical in config templates)
#   "..." '...'  strings
#   numbers
# and colors every builtin filter, test and global function as a builtin name.

context default
    # numbers in the template body (engine takes the first matching rule at a
    # position, so most specific forms go first: decimal+exp, exp, decimal, int)
    keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{\+-\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\{eE\}\{\+-\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\} CONSTANT_NUMERIC

    # jinja2 statement / block tag: {% ... %}
    context {% %} META_PREPROCESSOR
        # statement keywords
        keyword whole if KEYWORD_CONTROL
        keyword whole elif KEYWORD_CONTROL
        keyword whole else KEYWORD_CONTROL
        keyword whole endif KEYWORD_CONTROL
        keyword whole for KEYWORD_CONTROL
        keyword whole endfor KEYWORD_CONTROL
        keyword whole set KEYWORD_OTHER
        keyword whole endset KEYWORD_OTHER
        keyword whole macro KEYWORD_OTHER
        keyword whole endmacro KEYWORD_OTHER
        keyword whole call KEYWORD_OTHER
        keyword whole endcall KEYWORD_OTHER
        keyword whole filter KEYWORD_OTHER
        keyword whole endfilter KEYWORD_OTHER
        keyword whole extends KEYWORD_CONTROL_IMPORT
        keyword whole block KEYWORD_OTHER
        keyword whole endblock KEYWORD_OTHER
        keyword whole include KEYWORD_CONTROL_IMPORT
        keyword whole import KEYWORD_CONTROL_IMPORT
        keyword whole from KEYWORD_CONTROL_IMPORT
        keyword whole as KEYWORD_OTHER
        keyword whole raw KEYWORD_OTHER
        keyword whole endraw KEYWORD_OTHER
        keyword whole autoescape KEYWORD_OTHER
        keyword whole endautoescape KEYWORD_OTHER
        keyword whole scoped KEYWORD_OTHER
        keyword whole required KEYWORD_OTHER
        keyword whole recursive KEYWORD_OTHER
        keyword whole ignore KEYWORD_OTHER
        keyword whole missing KEYWORD_OTHER
        keyword whole with KEYWORD_OTHER
        keyword whole without KEYWORD_OTHER
        keyword whole context KEYWORD_OTHER

        # operators
        keyword whole and KEYWORD_OPERATOR_WORD
        keyword whole or KEYWORD_OPERATOR_WORD
        keyword whole not KEYWORD_OPERATOR_WORD
        keyword whole in KEYWORD_OPERATOR_WORD
        keyword whole is KEYWORD_OPERATOR_WORD

        # literals
        keyword whole true CONSTANT_LANGUAGE
        keyword whole false CONSTANT_LANGUAGE
        keyword whole none CONSTANT_LANGUAGE

        # pipe (filter separator)
        keyword | KEYWORD_OPERATOR

        # builtin filters
        keyword whole abs SUPPORT_FUNCTION
        keyword whole attr SUPPORT_FUNCTION
        keyword whole batch SUPPORT_FUNCTION
        keyword whole capitalize SUPPORT_FUNCTION
        keyword whole center SUPPORT_FUNCTION
        keyword whole default SUPPORT_FUNCTION
        keyword whole dictsort SUPPORT_FUNCTION
        keyword whole escape SUPPORT_FUNCTION
        keyword whole filesizeformat SUPPORT_FUNCTION
        keyword whole first SUPPORT_FUNCTION
        keyword whole float SUPPORT_FUNCTION
        keyword whole forceescape SUPPORT_FUNCTION
        keyword whole format SUPPORT_FUNCTION
        keyword whole groupby SUPPORT_FUNCTION
        keyword whole indent SUPPORT_FUNCTION
        keyword whole int SUPPORT_FUNCTION
        keyword whole items SUPPORT_FUNCTION
        keyword whole join SUPPORT_FUNCTION
        keyword whole last SUPPORT_FUNCTION
        keyword whole length SUPPORT_FUNCTION
        keyword whole list SUPPORT_FUNCTION
        keyword whole lower SUPPORT_FUNCTION
        keyword whole map SUPPORT_FUNCTION
        keyword whole max SUPPORT_FUNCTION
        keyword whole min SUPPORT_FUNCTION
        keyword whole pprint SUPPORT_FUNCTION
        keyword whole random SUPPORT_FUNCTION
        keyword whole reject SUPPORT_FUNCTION
        keyword whole rejectattr SUPPORT_FUNCTION
        keyword whole replace SUPPORT_FUNCTION
        keyword whole reverse SUPPORT_FUNCTION
        keyword whole round SUPPORT_FUNCTION
        keyword whole safe SUPPORT_FUNCTION
        keyword whole select SUPPORT_FUNCTION
        keyword whole selectattr SUPPORT_FUNCTION
        keyword whole slice SUPPORT_FUNCTION
        keyword whole sort SUPPORT_FUNCTION
        keyword whole string SUPPORT_FUNCTION
        keyword whole striptags SUPPORT_FUNCTION
        keyword whole sum SUPPORT_FUNCTION
        keyword whole title SUPPORT_FUNCTION
        keyword whole tojson SUPPORT_FUNCTION
        keyword whole trim SUPPORT_FUNCTION
        keyword whole truncate SUPPORT_FUNCTION
        keyword whole unique SUPPORT_FUNCTION
        keyword whole upper SUPPORT_FUNCTION
        keyword whole urlencode SUPPORT_FUNCTION
        keyword whole urlize SUPPORT_FUNCTION
        keyword whole wordcount SUPPORT_FUNCTION
        keyword whole wordwrap SUPPORT_FUNCTION
        keyword whole xmlattr SUPPORT_FUNCTION

        # builtin tests
        keyword whole boolean SUPPORT_FUNCTION
        keyword whole callable SUPPORT_FUNCTION
        keyword whole defined SUPPORT_FUNCTION
        keyword whole divisibleby SUPPORT_FUNCTION
        keyword whole eq SUPPORT_FUNCTION
        keyword whole escaped SUPPORT_FUNCTION
        keyword whole even SUPPORT_FUNCTION
        keyword whole ge SUPPORT_FUNCTION
        keyword whole gt SUPPORT_FUNCTION
        keyword whole integer SUPPORT_FUNCTION
        keyword whole iterable SUPPORT_FUNCTION
        keyword whole le SUPPORT_FUNCTION
        keyword whole lt SUPPORT_FUNCTION
        keyword whole mapping SUPPORT_FUNCTION
        keyword whole ne SUPPORT_FUNCTION
        keyword whole number SUPPORT_FUNCTION
        keyword whole odd SUPPORT_FUNCTION
        keyword whole sameas SUPPORT_FUNCTION
        keyword whole sequence SUPPORT_FUNCTION
        keyword whole test SUPPORT_FUNCTION
        keyword whole undefined SUPPORT_FUNCTION

        # builtin global functions
        keyword whole cycler SUPPORT_FUNCTION
        keyword whole dict SUPPORT_FUNCTION
        keyword whole joiner SUPPORT_FUNCTION
        keyword whole lipsum SUPPORT_FUNCTION
        keyword whole namespace SUPPORT_FUNCTION
        keyword whole range SUPPORT_FUNCTION

        # numbers (most specific first, see note in default context)
        keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{\+-\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\}\[0123456789\]\{eE\}\{\+-\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\} CONSTANT_NUMERIC

    # jinja2 expression tag: {{ ... }}
    context {{ }} META_PREPROCESSOR
        # operators (incl. inline if-expression)
        keyword whole and KEYWORD_OPERATOR_WORD
        keyword whole or KEYWORD_OPERATOR_WORD
        keyword whole not KEYWORD_OPERATOR_WORD
        keyword whole in KEYWORD_OPERATOR_WORD
        keyword whole is KEYWORD_OPERATOR_WORD
        keyword whole if KEYWORD_CONTROL
        keyword whole else KEYWORD_CONTROL

        # literals
        keyword whole true CONSTANT_LANGUAGE
        keyword whole false CONSTANT_LANGUAGE
        keyword whole none CONSTANT_LANGUAGE

        # pipe (filter separator)
        keyword | KEYWORD_OPERATOR

        # builtin filters
        keyword whole abs SUPPORT_FUNCTION
        keyword whole attr SUPPORT_FUNCTION
        keyword whole batch SUPPORT_FUNCTION
        keyword whole capitalize SUPPORT_FUNCTION
        keyword whole center SUPPORT_FUNCTION
        keyword whole default SUPPORT_FUNCTION
        keyword whole dictsort SUPPORT_FUNCTION
        keyword whole escape SUPPORT_FUNCTION
        keyword whole filesizeformat SUPPORT_FUNCTION
        keyword whole first SUPPORT_FUNCTION
        keyword whole float SUPPORT_FUNCTION
        keyword whole forceescape SUPPORT_FUNCTION
        keyword whole format SUPPORT_FUNCTION
        keyword whole groupby SUPPORT_FUNCTION
        keyword whole indent SUPPORT_FUNCTION
        keyword whole int SUPPORT_FUNCTION
        keyword whole items SUPPORT_FUNCTION
        keyword whole join SUPPORT_FUNCTION
        keyword whole last SUPPORT_FUNCTION
        keyword whole length SUPPORT_FUNCTION
        keyword whole list SUPPORT_FUNCTION
        keyword whole lower SUPPORT_FUNCTION
        keyword whole map SUPPORT_FUNCTION
        keyword whole max SUPPORT_FUNCTION
        keyword whole min SUPPORT_FUNCTION
        keyword whole pprint SUPPORT_FUNCTION
        keyword whole random SUPPORT_FUNCTION
        keyword whole reject SUPPORT_FUNCTION
        keyword whole rejectattr SUPPORT_FUNCTION
        keyword whole replace SUPPORT_FUNCTION
        keyword whole reverse SUPPORT_FUNCTION
        keyword whole round SUPPORT_FUNCTION
        keyword whole safe SUPPORT_FUNCTION
        keyword whole select SUPPORT_FUNCTION
        keyword whole selectattr SUPPORT_FUNCTION
        keyword whole slice SUPPORT_FUNCTION
        keyword whole sort SUPPORT_FUNCTION
        keyword whole string SUPPORT_FUNCTION
        keyword whole striptags SUPPORT_FUNCTION
        keyword whole sum SUPPORT_FUNCTION
        keyword whole title SUPPORT_FUNCTION
        keyword whole tojson SUPPORT_FUNCTION
        keyword whole trim SUPPORT_FUNCTION
        keyword whole truncate SUPPORT_FUNCTION
        keyword whole unique SUPPORT_FUNCTION
        keyword whole upper SUPPORT_FUNCTION
        keyword whole urlencode SUPPORT_FUNCTION
        keyword whole urlize SUPPORT_FUNCTION
        keyword whole wordcount SUPPORT_FUNCTION
        keyword whole wordwrap SUPPORT_FUNCTION
        keyword whole xmlattr SUPPORT_FUNCTION

        # builtin tests
        keyword whole boolean SUPPORT_FUNCTION
        keyword whole callable SUPPORT_FUNCTION
        keyword whole defined SUPPORT_FUNCTION
        keyword whole divisibleby SUPPORT_FUNCTION
        keyword whole eq SUPPORT_FUNCTION
        keyword whole escaped SUPPORT_FUNCTION
        keyword whole even SUPPORT_FUNCTION
        keyword whole ge SUPPORT_FUNCTION
        keyword whole gt SUPPORT_FUNCTION
        keyword whole integer SUPPORT_FUNCTION
        keyword whole iterable SUPPORT_FUNCTION
        keyword whole le SUPPORT_FUNCTION
        keyword whole lt SUPPORT_FUNCTION
        keyword whole mapping SUPPORT_FUNCTION
        keyword whole ne SUPPORT_FUNCTION
        keyword whole number SUPPORT_FUNCTION
        keyword whole odd SUPPORT_FUNCTION
        keyword whole sameas SUPPORT_FUNCTION
        keyword whole sequence SUPPORT_FUNCTION
        keyword whole test SUPPORT_FUNCTION
        keyword whole undefined SUPPORT_FUNCTION

        # builtin global functions
        keyword whole cycler SUPPORT_FUNCTION
        keyword whole dict SUPPORT_FUNCTION
        keyword whole joiner SUPPORT_FUNCTION
        keyword whole lipsum SUPPORT_FUNCTION
        keyword whole namespace SUPPORT_FUNCTION
        keyword whole range SUPPORT_FUNCTION

        # builtin function
        keyword whole super VARIABLE_LANGUAGE

        # numbers (most specific first, see note in default context)
        keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{\+-\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\}\[0123456789\]\{eE\}\{\+-\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\}\[0123456789\] CONSTANT_NUMERIC
        keyword whole \{0123456789\} CONSTANT_NUMERIC

    # jinja2 comment: {# ... #}
    context {# #} COMMENT_BLOCK

    # line comment: # to end of line
    context # \n COMMENT_LINE

    # strings
    context " " STRING_QUOTED_DOUBLE
    context ' ' STRING_QUOTED_SINGLE
