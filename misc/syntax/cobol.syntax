# syntax highlighting for cobol.
# the author is Wuerl, see https://github.com/MidnightCommander/mc/issues/1987
# adapted to use in mcedit version 4.8.24 by alex bodnaru <alexbodn@gmail.com>

caseinsensitive

context default
    keyword ;; KEYWORD_CONTROL
    keyword \\@ CONSTANT_CHARACTER_ESCAPE
    keyword \\$ CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\` CONSTANT_CHARACTER_ESCAPE
    keyword ` PUNCTUATION_SECTION
    keyword ; PUNCTUATION_TERMINATOR
    keyword $(*) VARIABLE_OTHER
    keyword ${*} VARIABLE_OTHER
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION

    keyword whole linestart #!\[\s\]*\n COMMENT_LINE black

    keyword $\* VARIABLE_OTHER
    keyword $@ VARIABLE_OTHER
    keyword $# VARIABLE_OTHER
    keyword $? VARIABLE_OTHER
    keyword $- VARIABLE_OTHER
    keyword $$ VARIABLE_OTHER
    keyword $! VARIABLE_OTHER
    keyword $_ VARIABLE_OTHER

    keyword wholeright $\[0123456789\] VARIABLE_OTHER

    keyword wholeright $+ VARIABLE_OTHER

    keyword $ VARIABLE_OTHER

    keyword wholeleft linestart function*() ENTITY_NAME_FUNCTION
    keyword wholeleft linestart function\[\s\]+ KEYWORD_OTHER_RESERVED
    keyword wholeright +() ENTITY_NAME_FUNCTION

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._

