# Syntax rules for the C (and partially C++) programming languages.

#
# Rewritten and extended with defines by Morthimer McMare
#    <mailto:morthimer_second@list.ru>
#
# Tab size: 4.
# Feel free to improve the highlighting file.
#
# Date:
#   Initial 2024.04.24;
#   Updated 2024.06.26 (first public release. Classic Midnight Commander C-syntax theme set by default, added keywords from the C23 standard).
#


define _comment_word	KEYWORD_OTHER_TODO brown
define _comment_exmark	KEYWORD_OTHER_TODO yellow
define _comment_qnmark	KEYWORD_OTHER_TODO brown

# I think this highlighting is easier for the eyes for the black background themes. Can be also used with the blue background:
#define _punctuation		yellow
#define _punct_operator 	brightmagenta
#define _punct_semicolon	brightmagenta
#define _punct_bracket	yellow
#define _punct_sqbracket	brown
#define _punct_field		yellow
#define _punct_comma		yellow
#define _punct_ternary	white
#define _punct_bitwise	yellow
#define _label			brightcyan
#define _preproc			lightgray
#define _preproc_str		white
#define _preproc_nl_esc	white
#define _preproc_indent	lightgray
#define _keyword			brightcyan
#define _datatype		brightcyan
#define _datatype_void	brightcyan
#define _datatype_mod	brightcyan
#define _datatype_scope 	brightblue
#define _const			lightgray
#define _num_integer		red
#define _num_hex			red
#define _num_oct			red
#define _num_float		magenta
#define _string			brightgreen
#define _string_specsymb	brightcyan
#define _string_escchar 	brightcyan
#define _char			brightgreen
#define _comment			gray
#define _comment_word	black gray
#define _comment_exmark	black yellow
#define _comment_qnmark	black brown


context default
    keyword whole asm KEYWORD_OTHER_RESERVED
    keyword whole break KEYWORD_CONTROL
    keyword whole case KEYWORD_CONTROL
    keyword whole const STORAGE_MODIFIER
    keyword whole continue KEYWORD_CONTROL
    keyword whole do KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole enum STORAGE_TYPE_CLASS
    keyword whole for KEYWORD_CONTROL
    keyword whole goto KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole inline STORAGE_MODIFIER
    keyword whole restrict STORAGE_MODIFIER
    keyword whole return KEYWORD_CONTROL
    keyword whole sizeof KEYWORD_OPERATOR_WORD
    keyword whole struct STORAGE_TYPE_CLASS
    keyword whole switch KEYWORD_CONTROL
    keyword whole typedef STORAGE_TYPE
    keyword whole union STORAGE_TYPE_CLASS
    keyword whole volatile STORAGE_MODIFIER
    keyword whole while KEYWORD_CONTROL

    # C11/C23 extensions:
    keyword whole alignas KEYWORD_OTHER_RESERVED
    keyword whole alignof KEYWORD_OTHER_RESERVED
    keyword whole constexpr STORAGE_MODIFIER
    keyword whole typeof KEYWORD_OTHER_RESERVED
    keyword whole typeof_unqual KEYWORD_OTHER_RESERVED
    keyword whole static_assert KEYWORD_OTHER_RESERVED
    keyword whole thread_local STORAGE_MODIFIER
    keyword whole _Alignas KEYWORD_OTHER_RESERVED
    keyword whole _Alignof KEYWORD_OTHER_RESERVED
    keyword whole _Atomic STORAGE_MODIFIER
    keyword whole _Bool STORAGE_TYPE_PRIMITIVE
    keyword whole _Complex STORAGE_TYPE_PRIMITIVE
    keyword whole _Decimal32 STORAGE_TYPE_PRIMITIVE
    keyword whole _Decimal64 STORAGE_TYPE_PRIMITIVE
    keyword whole _Decimal128 STORAGE_TYPE_PRIMITIVE
    keyword whole _Generic KEYWORD_OTHER_RESERVED
    keyword whole _Imaginary STORAGE_TYPE_PRIMITIVE
    keyword whole _Noreturn STORAGE_MODIFIER
    keyword whole _Static_assert KEYWORD_OTHER_RESERVED
    keyword whole _Thread_local STORAGE_MODIFIER

    keyword whole auto STORAGE_MODIFIER
    keyword whole extern STORAGE_MODIFIER
    keyword whole register STORAGE_MODIFIER
    keyword whole static STORAGE_MODIFIER

    keyword whole void STORAGE_TYPE_PRIMITIVE
    keyword whole int STORAGE_TYPE_PRIMITIVE
    keyword whole char STORAGE_TYPE_PRIMITIVE
    keyword whole float STORAGE_TYPE_PRIMITIVE
    keyword whole double STORAGE_TYPE_PRIMITIVE
    keyword whole wchar_t STORAGE_TYPE_PRIMITIVE
    keyword whole short STORAGE_TYPE_PRIMITIVE
    keyword whole long STORAGE_TYPE_PRIMITIVE
    keyword whole signed STORAGE_TYPE_PRIMITIVE
    keyword whole unsigned STORAGE_TYPE_PRIMITIVE
    keyword whole wchar_t STORAGE_TYPE_PRIMITIVE
    keyword whole ... PUNCTUATION_SEPARATOR

    keyword NULL CONSTANT_LANGUAGE
    # Since C23:
    keyword true CONSTANT_LANGUAGE
    keyword false CONSTANT_LANGUAGE
    keyword nullptr CONSTANT_LANGUAGE

    keyword linestart \{\s\t\}\[\s\t\]#*\n META_PREPROCESSOR
    keyword whole linestart \[\s\t\]\{ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\}\[0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\]: ENTITY_NAME_LABEL
    keyword whole \[\s\t\]default KEYWORD_CONTROL

    # Comments:
    keyword /\* COMMENT_BLOCK
    keyword \*/ COMMENT_BLOCK
    keyword // COMMENT_LINE

    # Characters:
    keyword '\\\{"abtnvfr\}' CONSTANT_CHARACTER
    keyword '\\\{0123\}\{01234567\}\{01234567\}' CONSTANT_CHARACTER_ESCAPE
    keyword '\\'' CONSTANT_CHARACTER_ESCAPE
    keyword '\\\\' CONSTANT_CHARACTER_ESCAPE
    keyword '\\0' CONSTANT_CHARACTER_ESCAPE
    keyword '\{\s!"#$%&()\*\+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~ ¡¢£¤¥¦§¨©ª«¬­®¯°±²³´µ¶·¸¹º»¼½¾¿ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ×ØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿ\}' CONSTANT_CHARACTER

    # Punctuation characters, sorted by ASCII code:
    keyword ! KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword && KEYWORD_OPERATOR
    # Note: the '&' symbol uses both in the reference/address and in the bitwise operation.
    keyword & KEYWORD_OPERATOR
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword \* KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword , PUNCTUATION_SEPARATOR
    keyword . PUNCTUATION_SEPARATOR
    keyword -> PUNCTUATION_SEPARATOR
    keyword - KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword < KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword > KEYWORD_OPERATOR
    keyword ? PUNCTUATION_SEPARATOR
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword ^ KEYWORD_OPERATOR
    keyword { PUNCTUATION_SECTION
    keyword || KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    keyword } PUNCTUATION_SECTION
    keyword ~ KEYWORD_OPERATOR

    # Numbers:
    wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.

    keyword whole 0x\{0123456789abcdefABCDEF_\}\[0123456789abcdefABCDEF_\] CONSTANT_NUMERIC
    keyword whole 0\{01234567_\}\[01234567_\] CONSTANT_NUMERIC
    keyword whole 0 CONSTANT_NUMERIC
    keyword whole 0\{lu\} CONSTANT_NUMERIC
    keyword whole \{123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    keyword whole \{123456789_\}\[0123456789_\]\{lu\} CONSTANT_NUMERIC
    # Float-point values:
    keyword whole \[0123456789_\]\.\{0123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    keyword whole \{0123456789_\}\[0123456789_\]\.\[0123456789_\] CONSTANT_NUMERIC
    keyword whole \{0123456789_\}\[0123456789_\]\{eE\}\{0123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    keyword whole \{0123456789_\}\[0123456789_\]\{eE\}\{\-\+\}\{0123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    keyword whole \{0123456789_\}\[0123456789_\]\.\{0123456789_\}\[0123456789_\]\{eE\}\{0123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    keyword whole \{0123456789_\}\[0123456789_\]\.\{0123456789_\}\[0123456789_\]\{eE\}\{\-\+\}\{0123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    # Explicit float (not double):
    keyword whole \[0123456789_\]\.\{0123456789_\}\[0123456789_\]f CONSTANT_NUMERIC
    keyword whole \{0123456789_\}\[0123456789_\]\.\[0123456789_\]f CONSTANT_NUMERIC
    keyword whole \{0123456789_\}\[0123456789_\]\{eE\}\{0123456789_\}\[0123456789_\]f CONSTANT_NUMERIC
    keyword whole \{0123456789_\}\[0123456789_\]\{eE\}\{\-\+\}\{0123456789_\}\[0123456789_\]f CONSTANT_NUMERIC
    keyword whole \{0123456789_\}\[0123456789_\]\.\{0123456789_\}\[0123456789_\]\{eE\}\{0123456789_\}\[0123456789_\]f CONSTANT_NUMERIC
    keyword whole \{0123456789_\}\[0123456789_\]\.\{0123456789_\}\[0123456789_\]\{eE\}\{\-\+\}\{0123456789_\}\[0123456789_\]f CONSTANT_NUMERIC


context exclusive /\* \*/ COMMENT_BLOCK
    keyword whole BUG 	_comment_word
    keyword whole FixMe _comment_word
    keyword whole FIXME _comment_word
    keyword whole Note 	_comment_word
    keyword whole NOTE 	_comment_word
    keyword whole ToDo 	_comment_word
    keyword whole TODO 	_comment_word
    keyword !!\[!\] 	_comment_exmark
    keyword ??\[?\] 	_comment_qnmark
    spellcheck

context exclusive // \n COMMENT_LINE
    keyword whole BUG:		_comment_word
    keyword whole FixMe: 	_comment_word
    keyword whole FIXME: 	_comment_word
    keyword whole Note: 	_comment_word
    keyword whole NOTE: 	_comment_word
    keyword whole ToDo: 	_comment_word
    keyword whole TODO: 	_comment_word
    keyword !!\[!\] 		_comment_exmark
    keyword ??\[?\] 		_comment_qnmark
    spellcheck

context linestart # \n META_PREPROCESSOR
    keyword \\\n PUNCTUATION_SEPARATOR_CONTINUATION
    keyword /\**\*/ COMMENT_BLOCK
    keyword //*\n COMMENT_LINE
    keyword "+" STRING_QUOTED_OTHER
    keyword <+> STRING_QUOTED_OTHER

context " " STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_OTHER_PLACEHOLDER
    keyword %\[#0\s-\+,\]\[0123456789\*\]\[.\]\[0123456789\*\]\[L\]\{eEfgGoxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[0\s-\+,\]\[0123456789\*\]\[.\]\[0123456789\*\]\[hl\]\{diuxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[hl\]n CONSTANT_OTHER_PLACEHOLDER
    keyword %\[-\]\[0123456789\*\]\[.\]\[0123456789\*\]s CONSTANT_OTHER_PLACEHOLDER
    keyword %[*] CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword %p CONSTANT_OTHER_PLACEHOLDER
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_OTHER_PLACEHOLDER
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE
