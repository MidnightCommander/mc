# Sytnax highlighting for Eiffel
# Daniel F Moisset - dmoisset@grulic.org.ar
# Based on mc's pascal.syntax

context default

    keyword whole agent KEYWORD_OTHER_RESERVED
    keyword whole alias KEYWORD_OTHER_RESERVED
    keyword whole as KEYWORD_OTHER_RESERVED
    keyword whole check KEYWORD_CONTROL
    keyword whole class STORAGE_TYPE_CLASS
    keyword whole create KEYWORD_OTHER_NEW
    keyword whole creation KEYWORD_OTHER_RESERVED
    keyword whole debug KEYWORD_OTHER_RESERVED
    keyword whole deferred STORAGE_MODIFIER
    keyword whole do KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole elseif KEYWORD_CONTROL
    keyword whole end KEYWORD_CONTROL
    keyword whole ensure KEYWORD_CONTROL
    keyword whole expanded STORAGE_MODIFIER
    keyword whole export KEYWORD_OTHER_RESERVED
    keyword whole external STORAGE_MODIFIER
    keyword whole feature KEYWORD_OTHER_RESERVED
    keyword whole from KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole is KEYWORD_OTHER_RESERVED
    keyword whole indexing KEYWORD_OTHER_RESERVED
    keyword whole inherit KEYWORD_CONTROL_IMPORT
    keyword whole inspect KEYWORD_CONTROL
    keyword whole invariant KEYWORD_OTHER_RESERVED
    keyword whole like KEYWORD_OTHER_RESERVED
    keyword whole local KEYWORD_OTHER_RESERVED
    keyword whole loop KEYWORD_CONTROL
    keyword whole obsolete KEYWORD_OTHER_RESERVED
    keyword whole old KEYWORD_OTHER_RESERVED
    keyword whole once STORAGE_MODIFIER
    keyword whole redefine KEYWORD_OTHER_RESERVED
    keyword whole reference STORAGE_MODIFIER
    keyword whole rename KEYWORD_OTHER_RESERVED
    keyword whole require KEYWORD_CONTROL
    keyword whole rescue KEYWORD_CONTROL
    keyword whole retry KEYWORD_CONTROL
    keyword whole select KEYWORD_CONTROL
    keyword whole then KEYWORD_CONTROL
    keyword whole undefine KEYWORD_OTHER_RESERVED
    keyword whole unique KEYWORD_OTHER_RESERVED
    keyword whole until KEYWORD_CONTROL
    keyword whole variant KEYWORD_OTHER_RESERVED
    keyword whole when KEYWORD_CONTROL

    keyword whole Current VARIABLE_LANGUAGE
    keyword whole Precursor VARIABLE_LANGUAGE
    keyword whole Result VARIABLE_LANGUAGE
    keyword whole Void CONSTANT_LANGUAGE

# prevents - keyword from interfering with comment
    keyword -- COMMENT_LINE

    keyword := KEYWORD_OPERATOR
    keyword ?= KEYWORD_OPERATOR
    keyword ! KEYWORD_OPERATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION

    keyword {*} STORAGE_TYPE

    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword ^ KEYWORD_OPERATOR
    keyword \\ KEYWORD_OPERATOR
    keyword @ KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    keyword whole and KEYWORD_OPERATOR_WORD
    keyword whole implies KEYWORD_OPERATOR_WORD
    keyword whole not KEYWORD_OPERATOR_WORD
    keyword whole xor KEYWORD_OPERATOR_WORD
    keyword whole or KEYWORD_OPERATOR_WORD

# Uncomment this to highlight tabs and trailing spaces
#    keyword \t yellow red
#    keyword \s\[\s\]\n yellow red

# Comments
context exclusive -- \n    COMMENT_LINE
    keyword `*' MARKUP_RAW

# Strings and characters
context " "    STRING_QUOTED_DOUBLE
    keyword %N CONSTANT_CHARACTER_ESCAPE
    keyword %R CONSTANT_CHARACTER_ESCAPE
    keyword %U CONSTANT_CHARACTER_ESCAPE
    keyword %" CONSTANT_CHARACTER_ESCAPE
    keyword %' CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_CHARACTER_ESCAPE
    keyword %/\[0123456789\]/ CONSTANT_CHARACTER_ESCAPE

context ' '    STRING_QUOTED_SINGLE
    keyword %N CONSTANT_CHARACTER_ESCAPE
    keyword %R CONSTANT_CHARACTER_ESCAPE
    keyword %U CONSTANT_CHARACTER_ESCAPE
    keyword %" CONSTANT_CHARACTER_ESCAPE
    keyword %' CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_CHARACTER_ESCAPE
    keyword %/\[0123456789\]/ CONSTANT_CHARACTER_ESCAPE
