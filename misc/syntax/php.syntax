    keyword whole YPERR_YPERR CONSTANT_OTHER
    keyword whole YPERR_YPSERV CONSTANT_OTHER

# Zip File Functions (Read Only Access)
    keyword whole zip\_\[_abcdefghijklmnopqrstuvwxyz\] SUPPORT_FUNCTION

