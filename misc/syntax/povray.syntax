# Constructions
    keyword whole #switch KEYWORD_CONTROL
    keyword whole #break KEYWORD_CONTROL
    keyword whole #case KEYWORD_CONTROL
    keyword whole #end KEYWORD_CONTROL
    keyword whole #declare KEYWORD_OTHER
    keyword whole #macro KEYWORD_OTHER
    keyword whole #local KEYWORD_OTHER
    keyword whole #while KEYWORD_CONTROL
    keyword whole #ifndef KEYWORD_CONTROL
    keyword whole #version KEYWORD_OTHER
    keyword whole #ifdef KEYWORD_CONTROL
    keyword whole #debug KEYWORD_OTHER
    keyword whole #include KEYWORD_CONTROL_IMPORT
    keyword whole #if KEYWORD_CONTROL
    keyword whole function STORAGE_TYPE_FUNCTION
    keyword whole array STORAGE_TYPE

# Predefined constants
    keyword whole on CONSTANT_LANGUAGE
    keyword whole off CONSTANT_LANGUAGE
    keyword whole true CONSTANT_LANGUAGE
    keyword whole false CONSTANT_LANGUAGE
    keyword whole no CONSTANT_LANGUAGE
    keyword whole yes CONSTANT_LANGUAGE

# Built-in functions
    keyword whole sqrt SUPPORT_FUNCTION
