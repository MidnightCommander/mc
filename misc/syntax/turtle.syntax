context default
    spellcheck

# declarations
    keyword whole @base KEYWORD_CONTROL_IMPORT
    keyword whole @prefix KEYWORD_CONTROL_IMPORT

    keyword whole a KEYWORD_OTHER_RESERVED

    keyword ^^ KEYWORD_OPERATOR

# Collection
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION

# Shorthand prefix
    keyword wholeleft \{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\}\[\abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-\]: ENTITY_NAME_TAG
    keyword wholeleft : PUNCTUATION_SEPARATOR

# Anonymous node
    keyword wholeleft _: ENTITY_NAME_TAG
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION

# Decimal integers
    keyword whole \{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{-+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC

# Decimal floating point arbitrary precision number
    keyword whole \{0123456789\}.\[0123456789\] CONSTANT_NUMERIC
    keyword whole .\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{-+\}\{0123456789\}.\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{-+\}.\{0123456789\}\[0123456789\] CONSTANT_NUMERIC

# Decimal floating point double/fixed precision number
    keyword whole \{0123456789\}.\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}.\[0123456789\]\{-+\}\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole .\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole .\{0123456789\}\[0123456789\]\{-+\}\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{-+\}\{0123456789\}.\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{-+\}\{0123456789\}.\[0123456789\]\{-+\}\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{-+\}.\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{-+\}.\{0123456789\}\[0123456789\]\{-+\}\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC

# Boolean
    keyword whole true CONSTANT_LANGUAGE
    keyword whole false CONSTANT_LANGUAGE

# Language
    keyword wholeright @\{abcdefghijklmnopqrstuvwxyz\}\[abcdefghijklmnopqrstuvwxyz0123456789-\]\[abcdefghijklmnopqrstuvwxyz0123456789\] CONSTANT_OTHER
    keyword wholeright @\{abcdefghijklmnopqrstuvwxyz\}\[abcdefghijklmnopqrstuvwxyz0123456789\] CONSTANT_OTHER

# Punctuation
    keyword , PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
#    keyword . black white
    keyword . PUNCTUATION_TERMINATOR brightmagenta

# URL
#    keyword whole <*> brightred
context < > STRING_QUOTED_OTHER

# TODO: enable when context ending at newline doesn't ruin next context
# syntax violation
#    keyword  +\n black red

# String escape
    keyword \\u\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\} CONSTANT_CHARACTER_ESCAPE
    keyword \\U\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\{tnr>\\} CONSTANT_CHARACTER_ESCAPE

# Single-line literals
context exclusive " " STRING_QUOTED_DOUBLE
    spellcheck

# TODO: enable when context ending at newline doesn't ruin next context
# syntax violation
#    keyword +\n black red

# String escape
    keyword \\u\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\} CONSTANT_CHARACTER_ESCAPE
    keyword \\U\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\{tnr"\\} CONSTANT_CHARACTER_ESCAPE

# Multi-line literals
context """ """ STRING_QUOTED_DOUBLE
    spellcheck

# String escape
    keyword \\u\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\} CONSTANT_CHARACTER_ESCAPE
    keyword \\U\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\}\{0123456789abcdef\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\{tnr"\\} CONSTANT_CHARACTER_ESCAPE

# Comment
context linestart # \n COMMENT_LINE
    spellcheck

# Ideally we would have defined comments with "context linestart \[\s\]# ...",
# but contexts can't start with a character class. So we define comments twice.
context linestart \s\[\s\]# \n COMMENT_LINE
    spellcheck
