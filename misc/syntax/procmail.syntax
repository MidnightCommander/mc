    keyword STRG VARIABLE_OTHER
    keyword SHOW_FILTER VARIABLE_OTHER
    keyword TMPSPAM VARIABLE_OTHER

##############################################################
# Vars used by other recipes from the procmail mailinglist
    keyword PROCMAIL_DIR VARIABLE_OTHER
    keyword PROCMAILDIR VARIABLE_OTHER
    keyword PROCDIR VARIABLE_OTHER
    keyword OCTET VARIABLE_OTHER
    keyword DOTQUAD VARIABLE_OTHER
    keyword RCVD VARIABLE_OTHER
    keyword RCVD_COUNT VARIABLE_OTHER
    keyword FROMX VARIABLE_OTHER
    keyword RETX VARIABLE_OTHER
    keyword GPGFROM VARIABLE_OTHER
    keyword GPGGET VARIABLE_OTHER
    keyword GPGEXP VARIABLE_OTHER
    keyword EMAIL VARIABLE_OTHER
    keyword DUMMY_EXEC VARIABLE_OTHER
    keyword DUMMY VARIABLE_OTHER
    keyword TMPVAL VARIABLE_OTHER
    keyword TMPVAR VARIABLE_OTHER
    keyword HOMEDIR VARIABLE_OTHER
    keyword NULL VARIABLE_OTHER
    keyword whole H_From* VARIABLE_OTHER

    keyword whole on CONSTANT_LANGUAGE
    keyword whole true CONSTANT_LANGUAGE
    keyword whole yes CONSTANT_LANGUAGE
    keyword whole off CONSTANT_LANGUAGE
    keyword whole false CONSTANT_LANGUAGE
    keyword whole no CONSTANT_LANGUAGE
    keyword whole all CONSTANT_OTHER

    keyword whole :0*\n        KEYWORD_CONTROL magenta
    keyword whole \**\n STRING_REGEXP

    keyword whole |*\n KEYWORD_OPERATOR
    keyword whole !*\n KEYWORD_OPERATOR

    keyword ${*} VARIABLE_OTHER

    keyword ` PUNCTUATION_SECTION
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION

context  " "            STRING_QUOTED_DOUBLE
    keyword ${*} VARIABLE_OTHER

context exclusive ` `        STRING_QUOTED_OTHER black
    keyword '*' STRING_QUOTED_SINGLE
    keyword " STRING_QUOTED_DOUBLE
    keyword \\` CONSTANT_CHARACTER_ESCAPE
    keyword ; PUNCTUATION_TERMINATOR
    keyword $(*) VARIABLE_OTHER
    keyword ${*} VARIABLE_OTHER
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword -eq KEYWORD_OPERATOR
    keyword -ne KEYWORD_OPERATOR

    keyword wholeright $+ VARIABLE_OTHER
    keyword $ VARIABLE_OTHER

    keyword >/dev/null KEYWORD_OPERATOR
    keyword 2>&1 KEYWORD_OPERATOR
    keyword 1>&2 KEYWORD_OPERATOR

    keyword && KEYWORD_OPERATOR
    keyword || KEYWORD_OPERATOR
    keyword >> KEYWORD_OPERATOR

    keyword ES=$? VARIABLE_OTHER

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._

    keyword | KEYWORD_OPERATOR
    keyword whole --* VARIABLE_PARAMETER
    keyword whole -*\s VARIABLE_PARAMETER
    keyword whole \+* VARIABLE_PARAMETER
    keyword whole \** VARIABLE_PARAMETER
    keyword whole /* VARIABLE_PARAMETER
    keyword whole *: VARIABLE_PARAMETER

    keyword whole bash SUPPORT_FUNCTION
    keyword whole bc SUPPORT_FUNCTION
    keyword whole cp SUPPORT_FUNCTION
    keyword whole cut SUPPORT_FUNCTION
    keyword whole date SUPPORT_FUNCTION
    keyword whole echo SUPPORT_FUNCTION
    keyword whole egrep SUPPORT_FUNCTION
    keyword whole env SUPPORT_FUNCTION
    keyword whole expand SUPPORT_FUNCTION
    keyword whole formail SUPPORT_FUNCTION
    keyword whole gpg SUPPORT_FUNCTION
    keyword whole grep SUPPORT_FUNCTION
    keyword whole head SUPPORT_FUNCTION
    keyword whole killall SUPPORT_FUNCTION
    keyword whole md5sum VARIABLE_PARAMETER
    keyword whole mimedecode SUPPORT_FUNCTION
    keyword whole mkdir SUPPORT_FUNCTION
    keyword whole mv SUPPORT_FUNCTION
    keyword whole rm SUPPORT_FUNCTION
    keyword whole sed SUPPORT_FUNCTION
    keyword whole sendmail SUPPORT_FUNCTION
    keyword whole sort SUPPORT_FUNCTION
    keyword whole tail SUPPORT_FUNCTION
    keyword whole tddebbtsd SUPPORT_FUNCTION
    keyword whole tdnetsound SUPPORT_FUNCTION
    keyword whole test SUPPORT_FUNCTION
    keyword whole touch SUPPORT_FUNCTION
    keyword whole tr SUPPORT_FUNCTION
    keyword whole wc SUPPORT_FUNCTION
    keyword whole which SUPPORT_FUNCTION

    keyword whole if KEYWORD_CONTROL
    keyword whole then KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole fi KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole in KEYWORD_CONTROL
    keyword whole do KEYWORD_CONTROL
    keyword whole done KEYWORD_CONTROL
