context <A >                    ENTITY_NAME_TAG
    keyword = KEYWORD_OPERATOR

    keyword "http:*" STRING_QUOTED_DOUBLE
    keyword "ftp:*" STRING_QUOTED_DOUBLE
    keyword "news:*" STRING_QUOTED_DOUBLE
    keyword "mailto:*" STRING_QUOTED_DOUBLE
    keyword "gopher:*" STRING_QUOTED_DOUBLE
    keyword "telnet:*" STRING_QUOTED_DOUBLE
    keyword "file:*" STRING_QUOTED_DOUBLE
    keyword "javascript:*" STRING_QUOTED_DOUBLE

    keyword "Alternate" CONSTANT_OTHER
    keyword "Stylesheet" CONSTANT_OTHER
    keyword "Start" CONSTANT_OTHER
    keyword "Next" CONSTANT_OTHER
    keyword "Prev" CONSTANT_OTHER
    keyword "Contents" CONSTANT_OTHER
    keyword "Index" CONSTANT_OTHER
    keyword "Glossary" CONSTANT_OTHER
    keyword "Copyright" CONSTANT_OTHER
    keyword "Chapter" CONSTANT_OTHER
    keyword "Section" CONSTANT_OTHER
    keyword "Subsection" CONSTANT_OTHER
    keyword "Appendix" CONSTANT_OTHER
    keyword "Help" CONSTANT_OTHER
    keyword "Bookmark" CONSTANT_OTHER

    keyword "_blank" CONSTANT_OTHER
    keyword "_self" CONSTANT_OTHER
    keyword "_parent" CONSTANT_OTHER
    keyword "_top" CONSTANT_OTHER

    keyword "*" STRING_QUOTED_DOUBLE

#    keyword whole charset       yellow/24
#    keyword whole type          yellow/24
    keyword whole name ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole href ENTITY_OTHER_ATTRIBUTE_NAME
#    keyword whole hreflang      yellow/24
#    keyword whole rel           yellow/24
