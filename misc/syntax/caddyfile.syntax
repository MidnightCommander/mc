# Caddyfile syntax highlighting
# Reference: https://caddyserver.com/docs/caddyfile

context default

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.

# Snippet definitions - match the opening parenthesis and name
    keyword linestart (*) ENTITY_NAME_SECTION

# Named routes
    keyword linestart &(*) ENTITY_NAME_SECTION

# Site addresses and labels (at start of line, not indented)
    keyword linestart http:// ENTITY_NAME_SECTION
    keyword linestart https:// ENTITY_NAME_SECTION
    keyword linestart localhost ENTITY_NAME_SECTION

# Block delimiters
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION

# Separators and operators
    keyword , PUNCTUATION_SEPARATOR
    keyword = KEYWORD_OPERATOR

# All types of placeholders with dots and underscores
    keyword {http.*} VARIABLE_OTHER
    keyword {system.*} VARIABLE_OTHER
    keyword {client_ip} VARIABLE_OTHER
    keyword {uri} VARIABLE_OTHER
    keyword {path} VARIABLE_OTHER
    keyword {query} VARIABLE_OTHER
    keyword {host} VARIABLE_OTHER
    keyword {method} VARIABLE_OTHER
    keyword {scheme} VARIABLE_OTHER
    keyword {remote} VARIABLE_OTHER
    keyword {file} VARIABLE_OTHER
    keyword {dir} VARIABLE_OTHER
    keyword {\{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.\]} VARIABLE_OTHER

# Environment variables
    keyword {$*} VARIABLE_OTHER
    keyword {%*%} VARIABLE_OTHER

# Boolean values
    keyword whole true CONSTANT_LANGUAGE
    keyword whole false CONSTANT_LANGUAGE
    keyword whole on CONSTANT_LANGUAGE
    keyword whole off CONSTANT_LANGUAGE

# HTTP methods
    keyword whole GET CONSTANT_OTHER
    keyword whole POST CONSTANT_OTHER
    keyword whole PUT CONSTANT_OTHER
    keyword whole DELETE CONSTANT_OTHER
    keyword whole PATCH CONSTANT_OTHER
    keyword whole HEAD CONSTANT_OTHER
    keyword whole OPTIONS CONSTANT_OTHER

# Common protocols
    keyword whole http CONSTANT_OTHER
    keyword whole https CONSTANT_OTHER

# Standard HTTP Directives (Caddy v1)
    keyword whole basicauth KEYWORD_OTHER_RESERVED
    keyword whole bind KEYWORD_OTHER_RESERVED
    keyword whole browse KEYWORD_OTHER_RESERVED
    keyword whole errors KEYWORD_OTHER_RESERVED
    keyword whole expvar KEYWORD_OTHER_RESERVED
    keyword whole ext KEYWORD_OTHER_RESERVED
    keyword whole fastcgi KEYWORD_OTHER_RESERVED
    keyword whole gzip KEYWORD_OTHER_RESERVED
    keyword whole header KEYWORD_OTHER_RESERVED
    keyword whole import KEYWORD_OTHER_RESERVED
    keyword whole index KEYWORD_OTHER_RESERVED
    keyword whole internal KEYWORD_OTHER_RESERVED
    keyword whole limits KEYWORD_OTHER_RESERVED
    keyword whole log KEYWORD_OTHER_RESERVED
    keyword whole markdown KEYWORD_OTHER_RESERVED
    keyword whole mime KEYWORD_OTHER_RESERVED
    keyword whole on KEYWORD_OTHER_RESERVED
    keyword whole pprof KEYWORD_OTHER_RESERVED
    keyword whole proxy KEYWORD_OTHER_RESERVED
    keyword whole push KEYWORD_OTHER_RESERVED
    keyword whole redir KEYWORD_OTHER_RESERVED
    keyword whole request_id KEYWORD_OTHER_RESERVED
    keyword whole rewrite KEYWORD_OTHER_RESERVED
    keyword whole root KEYWORD_OTHER_RESERVED
    keyword whole status KEYWORD_OTHER_RESERVED
    keyword whole templates KEYWORD_OTHER_RESERVED
    keyword whole timeouts KEYWORD_OTHER_RESERVED
    keyword whole tls KEYWORD_OTHER_RESERVED
    keyword whole websocket KEYWORD_OTHER_RESERVED

# Caddy v2 directives
    keyword whole file_server KEYWORD_OTHER_RESERVED
    keyword whole reverse_proxy KEYWORD_OTHER_RESERVED
    keyword whole respond KEYWORD_OTHER_RESERVED
    keyword whole route KEYWORD_OTHER_RESERVED
    keyword whole handle KEYWORD_OTHER_RESERVED
    keyword whole handle_path KEYWORD_OTHER_RESERVED
    keyword whole handle_errors KEYWORD_OTHER_RESERVED
    keyword whole encode KEYWORD_OTHER_RESERVED
    keyword whole php_fastcgi KEYWORD_OTHER_RESERVED
    keyword whole uri KEYWORD_OTHER_RESERVED
    keyword whole try_files KEYWORD_OTHER_RESERVED
    keyword whole vars KEYWORD_OTHER_RESERVED
    keyword whole request_body KEYWORD_OTHER_RESERVED
    keyword whole abort KEYWORD_OTHER_RESERVED
    keyword whole acme_server KEYWORD_OTHER_RESERVED
    keyword whole basic_auth KEYWORD_OTHER_RESERVED
    keyword whole forward_auth KEYWORD_OTHER_RESERVED
    keyword whole fs KEYWORD_OTHER_RESERVED
    keyword whole intercept KEYWORD_OTHER_RESERVED
    keyword whole invoke KEYWORD_OTHER_RESERVED
    keyword whole log_append KEYWORD_OTHER_RESERVED
    keyword whole log_skip KEYWORD_OTHER_RESERVED
    keyword whole log_name KEYWORD_OTHER_RESERVED
    keyword whole map KEYWORD_OTHER_RESERVED
    keyword whole method KEYWORD_OTHER_RESERVED
    keyword whole metrics KEYWORD_OTHER_RESERVED
    keyword whole push KEYWORD_OTHER_RESERVED
    keyword whole request_header KEYWORD_OTHER_RESERVED
    keyword whole tracing KEYWORD_OTHER_RESERVED

# Popular plugin directives
    keyword whole cache KEYWORD_OTHER_RESERVED
    keyword whole cors KEYWORD_OTHER_RESERVED
    keyword whole jwt KEYWORD_OTHER_RESERVED
    keyword whole ratelimit KEYWORD_OTHER_RESERVED
    keyword whole realip KEYWORD_OTHER_RESERVED
    keyword whole filter KEYWORD_OTHER_RESERVED
    keyword whole git KEYWORD_OTHER_RESERVED
    keyword whole prometheus KEYWORD_OTHER_RESERVED
    keyword whole ipfilter KEYWORD_OTHER_RESERVED
    keyword whole forwardproxy KEYWORD_OTHER_RESERVED
    keyword whole login KEYWORD_OTHER_RESERVED
    keyword whole authz KEYWORD_OTHER_RESERVED
    keyword whole minify KEYWORD_OTHER_RESERVED
    keyword whole expires KEYWORD_OTHER_RESERVED
    keyword whole locale KEYWORD_OTHER_RESERVED
    keyword whole webdav KEYWORD_OTHER_RESERVED
    keyword whole awslambda KEYWORD_OTHER_RESERVED
    keyword whole awses KEYWORD_OTHER_RESERVED

# Common subdirectives and options (with underscores)
    keyword whole to ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole transparent ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole upstream ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole policy ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole health_check ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole header_upstream ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole header_downstream ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole header_up ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole header_down ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole websocket ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole preset ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole except ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole only ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole not ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole match ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole matcher ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole strip_prefix ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole strip_suffix ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole lb_policy ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole lb_try_duration ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole lb_try_interval ENTITY_OTHER_ATTRIBUTE_NAME

# AWS Lambda specific subdirectives
    keyword whole aws_access ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole aws_secret ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole aws_region ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole function_name ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole aws_endpoint ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole qualifier ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole include_body ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole timeout ENTITY_OTHER_ATTRIBUTE_NAME

# TLS options
    keyword whole self_signed ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole dns ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole ca ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole protocols ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole ciphers ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole curves ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole alpn ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole must_staple ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole key_type ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole load ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole clients ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole client_auth ENTITY_OTHER_ATTRIBUTE_NAME

# Global options (top-level block)
    keyword whole debug ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole http_port ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole https_port ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole default_bind ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole order ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole storage ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole storage_clean_interval ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole admin ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole persist_config ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole grace_period ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole shutdown_delay ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole metrics ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole auto_https ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole email ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole default_sni ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole fallback_sni ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole local_certs ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole skip_install_trust ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole acme_ca ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole acme_ca_root ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole acme_eab ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole acme_dns ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole dns ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole ech ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole on_demand_tls ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole cert_issuer ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole renew_interval ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole cert_lifetime ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole ocsp_interval ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole ocsp_stapling ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole preferred_chains ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole servers ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole filesystem ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole pki ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole events ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole keepalive_interval ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole client_ip_headers ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole trusted_proxies ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole trusted_proxies_strict ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole log_credentials ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole strict_sni_host ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole enable_full_duplex ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole max_header_size ENTITY_OTHER_ATTRIBUTE_NAME

# Matchers
    keyword whole path ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole path_regexp ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole method ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole query ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole header_regexp ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole protocol ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole expression ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole file ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole remote_ip ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole host ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole client_ip ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole vars ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole vars_regexp ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole not ENTITY_OTHER_ATTRIBUTE_NAME

# Named matcher token
    keyword @\{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-_\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_\] ENTITY_NAME_SECTION

# Arguments that start with + or - (like +header or -header)
    keyword +\{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-_\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_\] KEYWORD_OPERATOR
    keyword -\{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-_\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_\] KEYWORD_OPERATOR

# Numbers (ports, status codes, sizes)
    keyword whole :\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]k CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]m CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]g CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]s CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]ms CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]h CONSTANT_NUMERIC

# Comments
context # \n COMMENT_LINE
    spellcheck

# String literals with quotes
context " " STRING_QUOTED_DOUBLE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword {*} VARIABLE_OTHER

# Backtick-quoted strings
context ` ` STRING_QUOTED_OTHER
    keyword \\` CONSTANT_CHARACTER_ESCAPE
    keyword {*} VARIABLE_OTHER

# Heredocs (common markers)
context whole <<\[\s\]\[-\]\[\s\]CSS CSS STRING_QUOTED_OTHER
context whole <<\[\s\]\[-\]\[\s\]HTML HTML STRING_QUOTED_OTHER
context whole <<\[\s\]\[-\]\[\s\]JSON JSON STRING_QUOTED_OTHER
context whole <<\[\s\]\[-\]\[\s\]JAVASCRIPT JAVASCRIPT STRING_QUOTED_OTHER
context whole <<\[\s\]\[-\]\[\s\]JS JS STRING_QUOTED_OTHER
context whole <<\[\s\]\[-\]\[\s\]XML XML STRING_QUOTED_OTHER
