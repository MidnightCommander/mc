    keyword whole STDIN CONSTANT_OTHER
    keyword whole STDOUT CONSTANT_OTHER
    keyword whole STDERR CONSTANT_OTHER

####################################
# expressions, operators and other

    keyword whole var STORAGE_MODIFIER
    keyword whole as KEYWORD_OTHER_RESERVED
    keyword whole and KEYWORD_OPERATOR_WORD
    keyword whole or KEYWORD_OPERATOR_WORD
    keyword whole xor KEYWORD_OPERATOR_WORD

# Magic constants (https://www.php.net/manual/en/language.constants.magic.php)
    keyword whole __LINE__ CONSTANT_OTHER
    keyword whole __FILE__ CONSTANT_OTHER
    keyword whole __DIR__ CONSTANT_OTHER
    keyword whole __FUNCTION__ CONSTANT_OTHER
    keyword whole __CLASS__ CONSTANT_OTHER
    keyword whole __TRAIT__ CONSTANT_OTHER
    keyword whole __METHOD__ CONSTANT_OTHER
    keyword whole __PROPERTY__ CONSTANT_OTHER
    keyword whole __NAMESPACE__ CONSTANT_OTHER

    keyword whole parent VARIABLE_LANGUAGE
    keyword whole $this VARIABLE_LANGUAGE

    keyword wholeright $+ VARIABLE_OTHER

    keyword /\* COMMENT_BLOCK
    keyword \*/ COMMENT_BLOCK
    keyword // COMMENT_LINE

    keyword <?php PUNCTUATION_SECTION
    keyword <? PUNCTUATION_SECTION
    keyword ?> PUNCTUATION_SECTION
    keyword <html ENTITY_NAME_TAG
    keyword <HTML ENTITY_NAME_TAG
    keyword <doctype ENTITY_NAME_TAG
    keyword <DOCTYPE ENTITY_NAME_TAG

    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword != KEYWORD_OPERATOR
    keyword == KEYWORD_OPERATOR
    keyword & KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    keyword :: KEYWORD_OPERATOR
    keyword -> KEYWORD_OPERATOR
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR

context " " STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\n CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_OTHER_PLACEHOLDER
    keyword %\[#0\s-\+,\]\[0123456789\]\[.\]\[0123456789\]\[L\]\{eEfgGoxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[0\s-\+,\]\[0123456789\]\[.\]\[0123456789\]\[hl\]\{diu\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[hl\]n CONSTANT_OTHER_PLACEHOLDER
    keyword %\[.\]\[0123456789\]s CONSTANT_OTHER_PLACEHOLDER
    keyword %[*] CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE

context ' ' STRING_QUOTED_SINGLE
    spellcheck
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE

context exclusive <? ?> META_EMBEDDED
    keyword whole &*; CONSTANT_CHARACTER_ESCAPE
context <html > ENTITY_NAME_TAG
    keyword whole &*; CONSTANT_CHARACTER_ESCAPE
context <HTML > ENTITY_NAME_TAG
    keyword whole &*; CONSTANT_CHARACTER_ESCAPE
context <!doctype > ENTITY_NAME_TAG
    keyword whole &*; CONSTANT_CHARACTER_ESCAPE
context <!DOCTYPE > ENTITY_NAME_TAG
    keyword whole &*; CONSTANT_CHARACTER_ESCAPE

context exclusive /\* \*/ COMMENT_BLOCK
    spellcheck

context exclusive // \n COMMENT_LINE
    spellcheck

context # \n COMMENT_LINE
    spellcheck

