# Syntax rules for Protobuf files and gRPC extensions

context default
    keyword whole enum STORAGE_TYPE_CLASS
    keyword whole extend KEYWORD_OTHER
    keyword whole extensions KEYWORD_OTHER
    keyword whole import KEYWORD_CONTROL_IMPORT
    keyword whole map KEYWORD_OTHER
    keyword whole message STORAGE_TYPE_CLASS
    keyword whole oneof KEYWORD_OTHER
    keyword whole option KEYWORD_OTHER
    keyword whole optional STORAGE_MODIFIER
    keyword whole package KEYWORD_OTHER
    keyword whole public STORAGE_MODIFIER
    keyword whole repeated STORAGE_MODIFIER
    keyword whole required STORAGE_MODIFIER
    keyword whole reserved KEYWORD_OTHER
    keyword whole returns KEYWORD_OTHER
    keyword whole rpc KEYWORD_OTHER
    keyword whole service STORAGE_TYPE_CLASS
    keyword whole stream KEYWORD_OTHER

    keyword whole double STORAGE_TYPE_PRIMITIVE
    keyword whole float STORAGE_TYPE_PRIMITIVE
    keyword whole int32 STORAGE_TYPE_PRIMITIVE
    keyword whole int64 STORAGE_TYPE_PRIMITIVE
    keyword whole uint32 STORAGE_TYPE_PRIMITIVE
    keyword whole uint64 STORAGE_TYPE_PRIMITIVE
    keyword whole sint32 STORAGE_TYPE_PRIMITIVE
    keyword whole sint64 STORAGE_TYPE_PRIMITIVE
    keyword whole fixed32 STORAGE_TYPE_PRIMITIVE
    keyword whole fixed64 STORAGE_TYPE_PRIMITIVE
    keyword whole sfixed32 STORAGE_TYPE_PRIMITIVE
    keyword whole sfixed64 STORAGE_TYPE_PRIMITIVE
    keyword whole bool STORAGE_TYPE_PRIMITIVE
    keyword whole string STORAGE_TYPE_PRIMITIVE
    keyword whole bytes STORAGE_TYPE_PRIMITIVE

    keyword // COMMENT_LINE

# punctuation characters, sorted by ASCII code
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword = KEYWORD_OPERATOR
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION

context exclusive // \n COMMENT_LINE
    spellcheck

context " " STRING_QUOTED_DOUBLE
    spellcheck
