# Highlighting for various diffs including those generated by CVS

context default
    keyword linestart @@*@@ META_DIFF_RANGE
    keyword linestart Index:\s META_DIFF_HEADER
    keyword linestart \s default white
    keyword linestart \*\*\*\*\*\*\*\*\*\*\*\*\*\*\* META_DIFF_RANGE
    keyword linestart \*\*\**\*\*\*\* META_DIFF_RANGE
    keyword linestart ---*---- META_DIFF_RANGE
context exclusive linestart @@*@@ \n META_DIFF_RANGE
context exclusive linestart Index:\s \n META_DIFF_HEADER white
context exclusive linestart \s \n
context exclusive linestart \t \n
context linestart diff \n META_DIFF_HEADER red
context linestart ---\s \n META_DIFF_HEADER
context linestart \+\+\+\s \n META_DIFF_HEADER
context linestart \*\*\*\s \n META_DIFF_HEADER
context linestart === \n META_DIFF_HEADER
context linestart \+ \n MARKUP_INSERTED
context linestart > \n MARKUP_INSERTED
context linestart - \n MARKUP_DELETED
context linestart < \n MARKUP_DELETED
context linestart ! \n MARKUP_CHANGED
context linestart ? \n COMMENT_LINE
context linestart RCS\s \n META_DIFF_HEADER
context linestart retrieving\s \n META_DIFF_HEADER
context linestart Only\s \n META_DIFF_HEADER black
context linestart Common\s \n META_DIFF_HEADER black
context linestart File\s \n META_DIFF_HEADER black
context linestart Files\s \n META_DIFF_HEADER black
context linestart Binary\s \n META_DIFF_HEADER black
context linestart # \n COMMENT_LINE
