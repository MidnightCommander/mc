    keyword  whole  $list SUPPORT_FUNCTION
    keyword  whole  $log SUPPORT_FUNCTION
    keyword  whole  $nokey SUPPORT_FUNCTION
    keyword  whole  $nolog SUPPORT_FUNCTION
    keyword  whole  $reset SUPPORT_FUNCTION
    keyword  whole  $reset_count SUPPORT_FUNCTION
    keyword  whole  $reset_value SUPPORT_FUNCTION
    keyword  whole  $restart SUPPORT_FUNCTION
    keyword  whole  $save SUPPORT_FUNCTION
    keyword  whole  $scale SUPPORT_FUNCTION
    keyword  whole  $scope SUPPORT_FUNCTION
    keyword  whole  $showscopes SUPPORT_FUNCTION
    keyword  whole  $showvars SUPPORT_FUNCTION
    keyword  whole  $sreadmemb SUPPORT_FUNCTION
    keyword  whole  $sreadmemh SUPPORT_FUNCTION

    keyword > KEYWORD_OTHER_RESERVED
    keyword < KEYWORD_OTHER_RESERVED
    keyword \+ KEYWORD_OTHER_RESERVED
    keyword - KEYWORD_OTHER_RESERVED
    keyword \* KEYWORD_OTHER_RESERVED
    keyword / KEYWORD_OTHER_RESERVED
    keyword % KEYWORD_OTHER_RESERVED
    keyword = KEYWORD_OTHER_RESERVED
    keyword != KEYWORD_OTHER_RESERVED
    keyword == KEYWORD_OTHER_RESERVED
    keyword || KEYWORD_OTHER_RESERVED
    keyword && KEYWORD_OTHER_RESERVED
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword . PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ? PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword | KEYWORD_OPERATOR
    keyword & KEYWORD_OPERATOR
    keyword ~ KEYWORD_OPERATOR
    keyword ^ KEYWORD_OPERATOR


context exclusive /\* \*/ COMMENT_BLOCK
    spellcheck

context exclusive // \n COMMENT_LINE
    spellcheck

context " " STRING_QUOTED_DOUBLE
