# CMake syntax highlighting
#
# Author: Henrik Pauli <henrik.pauli@uhusystems.com>

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-/\

caseinsensitive
context default

	keyword ( PUNCTUATION_SECTION
	keyword ) PUNCTUATION_SECTION

