# Syntax rules for the gputils .lkr files.

context default

    #=========================
    # Predefined constants
    #
    keyword whole _CRUNTIME CONSTANT_OTHER green
    keyword whole _DEBUG CONSTANT_OTHER green
    keyword whole _DEBUGCODESTART CONSTANT_OTHER green
    keyword whole _DEBUGCODELEN CONSTANT_OTHER green
    keyword whole _DEBUGDATASTART CONSTANT_OTHER green
    keyword whole _DEBUGDATALEN CONSTANT_OTHER green
    keyword whole _EXTENDEDMODE CONSTANT_OTHER green

    #=========================
    # Keywords
    #
    keyword whole LIBPATH KEYWORD_OTHER
    keyword whole LKRPATH KEYWORD_OTHER
    keyword whole FILES KEYWORD_OTHER

    keyword whole #DEFINE META_PREPROCESSOR
    keyword whole #IFDEF META_PREPROCESSOR
    keyword whole #ELSE META_PREPROCESSOR
    keyword whole #FI META_PREPROCESSOR

    keyword whole ACCESSBANK KEYWORD_OTHER
    keyword whole CODEPAGE KEYWORD_OTHER
    keyword whole DATABANK KEYWORD_OTHER
    keyword whole LINEARMEM KEYWORD_OTHER
    keyword whole PROTECTED KEYWORD_OTHER
    keyword whole RESERVED KEYWORD_OTHER
    keyword whole SECTION KEYWORD_OTHER
    keyword whole SHAREBANK KEYWORD_OTHER
    keyword whole SHADOW KEYWORD_OTHER
    keyword whole STACK KEYWORD_OTHER

    keyword whole END KEYWORD_OTHER
    keyword whole NAME KEYWORD_OTHER
    keyword whole SIZE KEYWORD_OTHER
    keyword whole START KEYWORD_OTHER

    keyword whole RAM CONSTANT_OTHER
    keyword whole ROM CONSTANT_OTHER

wholechars 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_

    #=========================
    # Numbers
    #
    keyword whole 0b\{01_\}\[01_\] CONSTANT_NUMERIC
    keyword whole 0q\{0123456_\}\[0123456_\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    keyword whole 0x\{0123456789ABCDEFabcdef_\}\[0123456789ABCDEFabcdef_\] CONSTANT_NUMERIC

    #=========================
    # Comments
    #
    keyword //*\n COMMENT_LINE magenta

    #=========================
    # Special symbols
    #
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword << KEYWORD_OPERATOR
    keyword >> KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword . KEYWORD_OPERATOR
    keyword : PUNCTUATION_SEPARATOR
