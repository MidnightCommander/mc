caseinsensitive

context default
    keyword linestart \**\n COMMENT_LINE
    keyword $*\n COMMENT_LINE
    keyword ;*\n COMMENT_LINE
    keyword //*\n COMMENT_LINE
    keyword linestart \+ PUNCTUATION_SEPARATOR_CONTINUATION

    # dot commands
    keyword whole .ac KEYWORD_OTHER_RESERVED
    keyword whole .control KEYWORD_OTHER_RESERVED
    keyword whole .csparam KEYWORD_OTHER_RESERVED
    keyword whole .dc KEYWORD_OTHER_RESERVED
    keyword whole .disto KEYWORD_OTHER_RESERVED
    keyword whole .else KEYWORD_OTHER_RESERVED
    keyword whole .elseif KEYWORD_OTHER_RESERVED
    keyword whole .end KEYWORD_OTHER_RESERVED
    keyword whole .endc KEYWORD_OTHER_RESERVED
    keyword whole .endif KEYWORD_OTHER_RESERVED
    keyword whole .ends KEYWORD_OTHER_RESERVED
    keyword whole .four KEYWORD_OTHER_RESERVED
    keyword whole .func KEYWORD_OTHER_RESERVED
