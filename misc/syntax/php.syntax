    keyword whole gzclose SUPPORT_FUNCTION
    keyword whole gzcompress SUPPORT_FUNCTION
    keyword whole gzdeflate SUPPORT_FUNCTION
    keyword whole gzencode SUPPORT_FUNCTION
    keyword whole gzeof SUPPORT_FUNCTION
    keyword whole gzfile SUPPORT_FUNCTION
    keyword whole gzgetc SUPPORT_FUNCTION
    keyword whole gzgets SUPPORT_FUNCTION
    keyword whole gzgetss SUPPORT_FUNCTION
    keyword whole gzinflate SUPPORT_FUNCTION
    keyword whole gzopen SUPPORT_FUNCTION
    keyword whole gzpassthru SUPPORT_FUNCTION
    keyword whole gzputs SUPPORT_FUNCTION
    keyword whole gzread SUPPORT_FUNCTION
    keyword whole gzrewind SUPPORT_FUNCTION
    keyword whole gzseek SUPPORT_FUNCTION
    keyword whole gztell SUPPORT_FUNCTION
    keyword whole gzuncompress SUPPORT_FUNCTION
    keyword whole gzwrite SUPPORT_FUNCTION
    keyword whole readgzfile SUPPORT_FUNCTION
    keyword whole zlib_get_coding_type SUPPORT_FUNCTION

# Zlib Compression Functions constants
    keyword whole FORCE_DEFLATE CONSTANT_OTHER
    keyword whole FORCE_GZIP CONSTANT_OTHER


########################
# predefined constants
# core

# Helper command:
#   wget -q -O - https://www.php.net/manual/en/reserved.constants.php | \
#   grep -Eo "<strong><code><a href=.*>(PHP|ZEND|DEBUG|PEAR|DEFAULT|E)_.*</a></code></strong>" | \
#   grep -Eo '(PHP_|ZEND_|DEBUG_|PEAR_|DEFAULT_|E_)[_A-Z]*' | \
#   sort -u | sed 's/\(.*\)/    keyword whole \1 white/g'
#
    keyword whole DEBUG_BACKTRACE_IGNORE_ARGS CONSTANT_OTHER
    keyword whole DEBUG_BACKTRACE_PROVIDE_OBJECT CONSTANT_OTHER
    keyword whole DEFAULT_INCLUDE_PATH CONSTANT_OTHER
    keyword whole E_ALL CONSTANT_OTHER
    keyword whole E_COMPILE_ERROR CONSTANT_OTHER
    keyword whole E_COMPILE_WARNING CONSTANT_OTHER
    keyword whole E_CORE_ERROR CONSTANT_OTHER
    keyword whole E_CORE_WARNING CONSTANT_OTHER
    keyword whole E_DEPRECATED CONSTANT_OTHER
    keyword whole E_ERROR CONSTANT_OTHER
    keyword whole E_NOTICE CONSTANT_OTHER
    keyword whole E_PARSE CONSTANT_OTHER
    keyword whole E_RECOVERABLE_ERROR CONSTANT_OTHER
    keyword whole E_STRICT CONSTANT_OTHER
    keyword whole E_USER_DEPRECATED CONSTANT_OTHER
    keyword whole E_USER_ERROR CONSTANT_OTHER
    keyword whole E_USER_NOTICE CONSTANT_OTHER
    keyword whole E_USER_WARNING CONSTANT_OTHER
    keyword whole E_WARNING CONSTANT_OTHER
    keyword whole PEAR_EXTENSION_DIR CONSTANT_OTHER
    keyword whole PEAR_INSTALL_DIR CONSTANT_OTHER
    keyword whole PHP_BINARY CONSTANT_OTHER
    keyword whole PHP_BINDIR CONSTANT_OTHER
    keyword whole PHP_CLI_PROCESS_TITLE CONSTANT_OTHER
    keyword whole PHP_CONFIG_FILE_PATH CONSTANT_OTHER
    keyword whole PHP_CONFIG_FILE_SCAN_DIR CONSTANT_OTHER
    keyword whole PHP_DATADIR CONSTANT_OTHER
    keyword whole PHP_DEBUG CONSTANT_OTHER
    keyword whole PHP_EOL CONSTANT_OTHER
    keyword whole PHP_EXTENSION_DIR CONSTANT_OTHER
    keyword whole PHP_EXTRA_VERSION CONSTANT_OTHER
    keyword whole PHP_FD_SETSIZE CONSTANT_OTHER
    keyword whole PHP_FLOAT_DIG CONSTANT_OTHER
    keyword whole PHP_FLOAT_EPSILON CONSTANT_OTHER
    keyword whole PHP_FLOAT_MAX CONSTANT_OTHER
    keyword whole PHP_FLOAT_MIN CONSTANT_OTHER
    keyword whole PHP_INT_MAX CONSTANT_OTHER
    keyword whole PHP_INT_MIN CONSTANT_OTHER
    keyword whole PHP_INT_SIZE CONSTANT_OTHER
    keyword whole PHP_LIBDIR CONSTANT_OTHER
    keyword whole PHP_LOCALSTATEDIR CONSTANT_OTHER
    keyword whole PHP_MAJOR_VERSION CONSTANT_OTHER
    keyword whole PHP_MANDIR CONSTANT_OTHER
    keyword whole PHP_MAXPATHLEN CONSTANT_OTHER
    keyword whole PHP_MINOR_VERSION CONSTANT_OTHER
    keyword whole PHP_OS CONSTANT_OTHER
    keyword whole PHP_OS_FAMILY CONSTANT_OTHER
    keyword whole PHP_PREFIX CONSTANT_OTHER
    keyword whole PHP_RELEASE_VERSION CONSTANT_OTHER
