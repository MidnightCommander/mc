#! @PYTHON@
#
#  Midnight Commander compatible EXTFS for accessing Amazon Web Services S3
#  and S3-compatible object storage services.
#  Written by Jakob Kemi <jakob.kemi@gmail.com> 2009
#
#  This program is free software: you can redistribute it and/or modify
#  it under the terms of the GNU General Public License as published by
#  the Free Software Foundation, either version 3 of the License, or
#  (at your option) any later version.
#
#  This program is distributed in the hope that it will be useful,
#  but WITHOUT ANY WARRANTY; without even the implied warranty of
#  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#  GNU General Public License for more details.
#
#  You should have received a copy of the GNU General Public License
#  along with this program.  If not, see <https://www.gnu.org/licenses/>.
#
#
# Notes:
#  This EXTFS exposes buckets as directories and keys as files
#  Due to EXTFS limitations all buckets & keys have to be read initially which might
#  take quite some time.
#
#
# Installation:
#  Make sure that boto3 <https://github.com/boto/boto3> (python3-boto3 in Debian) is installed.
#
#  Save as executable file /usr/libexec/mc/extfs/s3 (or wherever your mc expects to find extfs modules)
#
# Settings: (should be set via environment)
#  Credentials:
#    AWS_ACCESS_KEY_ID         : access key
#    AWS_SECRET_ACCESS_KEY     : secret access key
#    Instead of these two variables, any other source of credentials known to boto3
#    can be used, e.g. a profile in ~/.aws/credentials selected with AWS_PROFILE.
#  Optional:
#    MCVFS_EXTFS_S3_ENDPOINT   : URL of an S3-compatible service, e.g. "https://s3.example.com"
#                                (default: Amazon S3, or the endpoint configured for boto3)
#    MCVFS_EXTFS_S3_REGION     : region used to sign requests (default: the region configured
#                                for boto3, e.g. AWS_DEFAULT_REGION, otherwise "us-east-1")
#    MCVFS_EXTFS_S3_ADDRESSING_STYLE : "auto" (default), "path" or "virtual"; many
#                                S3-compatible services need "path"
#    MCVFS_EXTFS_S3_LOCATION   : where to create new buckets: "EU" - default, "US", or a region name
#    MCVFS_EXTFS_S3_DEBUGFILE  : write debug info to this file (no info by default)
#    MCVFS_EXTFS_S3_DEBUGLEVEL : debug messages level ("WARNING" - default, "DEBUG" - verbose)
#
#
# Usage:
#  Open dialog "Quick cd" (<alt-c>) and type: s3:// <enter> (or simply type `cd s3://' in shell line)
#
#
# History:
#
#  2026-11-12 Deepak Jain <fusionfoto@gmail.com>
#   - Port to boto3; the original boto library does not work with current Python versions.
#   - Support S3-compatible services: endpoint, signing region and addressing style settings.
#   - Credentials can come from any source boto3 knows about.
#   - Large files are transferred in parts.
#   - List modification time in local time using the standard library only.
#
#  2015-07-22 Dmitry Koterov <dmitry.koterov@gmail.com>
#   - Support for non-ASCII characters in filenames (system encoding detection).
#
#  2015-05-21 Dmitry Koterov <dmitry.koterov@gmail.com>
#   - Resolve "Please use AWS4-HMAC-SHA256" error: enforce the new V4 authentication method.
#     It is required in many (if not all) locations nowadays.
#   - Now s3+ works with buckets in different regions: locations are auto-detected.
#   - Debug level specification support (MCVFS_EXTFS_S3_DEBUGLEVEL).
#
#  2009-02-07 Jakob Kemi <jakob.kemi@gmail.com>
#   - Updated instructions.
#   - Improved error reporting.
#
#  2009-02-06 Jakob Kemi <jakob.kemi@gmail.com>
#   - Threaded list command.
#   - Handle rm of empty "subdirectories" (as seen in mc).
#   - List most recent datetime and total size of keys as directory properties.
#   - List modification time in local time.
#
#  2009-02-05 Jakob Kemi <jakob.kemi@gmail.com>
#   - Initial version.
#

import datetime
import json
import os
import shlex
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor


# Get settings from environment
USER = os.getenv('USER', '0')
ENDPOINT = os.getenv('MCVFS_EXTFS_S3_ENDPOINT') or None
REGION = os.getenv('MCVFS_EXTFS_S3_REGION') or None
ADDRESSING_STYLE = os.getenv('MCVFS_EXTFS_S3_ADDRESSING_STYLE', 'auto')
S3LOCATION = os.getenv('MCVFS_EXTFS_S3_LOCATION', 'EU')
DEBUGFILE = os.getenv('MCVFS_EXTFS_S3_DEBUGFILE')
DEBUGLEVEL = os.getenv('MCVFS_EXTFS_S3_DEBUGLEVEL', 'WARNING')

# Used by the extfs helpers tester instead of a live service, see
# tests/src/vfs/extfs/helpers-list/README
TEST_LIST_CMD = os.getenv('MC_TEST_EXTFS_LIST_CMD')

if ADDRESSING_STYLE not in ('auto', 'path', 'virtual'):
    sys.stderr.write('MCVFS_EXTFS_S3_ADDRESSING_STYLE must be "auto", "path" or "virtual".\n')
    sys.exit(1)

if S3LOCATION.upper() == 'EU':
    S3LOCATION = 'eu-central-1'
elif S3LOCATION.upper() == 'US':
    S3LOCATION = 'us-east-1'

# Setup logging
if DEBUGFILE:
    import logging
    logging.basicConfig(
        filename=DEBUGFILE,
        level=logging.DEBUG,
        format='%(asctime)s %(levelname)s %(message)s')
    for name in ('boto3', 'botocore', 's3transfer'):
        logging.getLogger(name).setLevel(getattr(logging, DEBUGLEVEL))
else:
    class Void(object):
        def __getattr__(self, attr):
            return self

        def __call__(self, *args, **kw):
            return self
    logging = Void()

logger = logging.getLogger('s3extfs')


def fail(msg):
    logger.error(msg)
    sys.stderr.write(msg + '\n')
    sys.exit(1)


def get_client():
    """
    Creates the S3 client from the settings above and boto3's own configuration.
    """
    try:
        import boto3
        from botocore.config import Config
    except ImportError:
        fail('The s3+ extfs needs boto3 (python3-boto3 in Debian).')

    session = boto3.session.Session()
    if session.get_credentials() is None:
        fail('Missing S3 credentials: set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, or configure boto3.')
    region = REGION or session.region_name or 'us-east-1'
    config = Config(signature_version='s3v4', s3={'addressing_style': ADDRESSING_STYLE})
    client = session.client('s3', endpoint_url=ENDPOINT, region_name=region, config=config)
    logger.debug('endpoint %s, region %s, addressing style %s', client.meta.endpoint_url, region, ADDRESSING_STYLE)
    return client


def client_errors():
    """
    The exceptions an S3 request can raise.
    """
    from botocore.exceptions import BotoCoreError, ClientError
    return (BotoCoreError, ClientError)


def handle_server_error(msg):
    fail('%s, reason: %s' % (msg, sys.exc_info()[1]))


def split_path(storedfilename):
    if '/' not in storedfilename:
        fail('Not a key inside a bucket: "%s"' % storedfilename)
    return storedfilename.split('/', 1)


def conv_date(dt):
    """
    S3 times are timezone-aware; list them as MM-DD-YYYY hh:mm in local time.
    """
    return dt.astimezone().strftime('%m-%d-%Y %H:%M')


def test_listing():
    """
    Reads the listing from the extfs helpers tester instead of a live service:
    a JSON document {"Buckets": [{"Name": ..., "Contents": [{"Key": ..., "Size": ...,
    "LastModified": "2024-01-31T12:34:56.000Z"}, ...]}, ...]}.
    """
    data = json.loads(subprocess.check_output(shlex.split(TEST_LIST_CMD)))
    listing = []
    for b in data['Buckets']:
        objects = [dict(o, LastModified=datetime.datetime.fromisoformat(o['LastModified'].replace('Z', '+00:00')))
                   for o in b.get('Contents', [])]
        listing.append((b['Name'], objects))
    return listing


logger.debug('started')
logger.debug('argv: ' + str(sys.argv))
try:
    cmd = sys.argv[1]
    args = sys.argv[2:]
except IndexError:
    sys.stderr.write('This program should be called from within MC\n')
    sys.exit(1)

#
# Lists all S3 contents
#
if cmd == 'list':
    logger.info('list')

    if TEST_LIST_CMD:
        listing = test_listing()
    else:
        s3 = get_client()

        def bucket_objects(name):
            objects = []
            for page in s3.get_paginator('list_objects_v2').paginate(Bucket=name):
                objects.extend(page.get('Contents', []))
            return name, objects

        try:
            names = [b['Name'] for b in s3.list_buckets().get('Buckets', [])]
            # Buckets in other regions are handled by botocore's region redirection.
            with ThreadPoolExecutor(max_workers=16) as pool:
                listing = list(pool.map(bucket_objects, names))
        except client_errors():
            handle_server_error('Unable to list buckets')

    epoch = datetime.datetime(1970, 1, 1, tzinfo=datetime.timezone.utc)
    for name, objects in listing:
        totsz = 0
        mostrecent = epoch
        lines = []
        for k in objects:
            if k['Key'].endswith('/'):
                # Sometimes someone create S3 keys which are ended with "/".
                # Extfs cannot work with them as with files, and such keys may
                # hide same-name directories, so we skip them.
                continue
            mostrecent = max(mostrecent, k['LastModified'])
            lines.append('%10s %3d %-8s %-8s %d %s %s\n' % (
                '-rw-r--r--', 1, USER, USER, k['Size'], conv_date(k['LastModified']), name + '/' + k['Key']))
            totsz += k['Size']

        sys.stdout.write('%10s %3d %-8s %-8s %d %s %s\n' % (
            'drwxr-xr-x', 1, USER, USER, totsz, conv_date(mostrecent), name))
        sys.stdout.writelines(lines)

#
# Fetch file from S3
#
elif cmd == 'copyout':
    archivename = args[0]
    storedfilename = args[1]
    extractto = args[2]

    bucket, key = split_path(storedfilename)
    logger.info('copyout bucket: %s, key: %s' % (bucket, key))

    try:
        get_client().download_file(bucket, key, extractto)
    except client_errors():
        handle_server_error('Unable to fetch key "%s"' % (key))

#
# Upload file to S3
#
elif cmd == 'copyin':
    archivename = args[0]
    storedfilename = args[1]
    sourcefile = args[2]

    bucket, key = split_path(storedfilename)
    logger.info('copyin bucket: %s, key: %s' % (bucket, key))

    try:
        get_client().upload_file(sourcefile, bucket, key)
    except client_errors():
        handle_server_error('Unable to upload key "%s"' % (key))

#
# Remove file from S3
#
elif cmd == 'rm':
    archivename = args[0]
    storedfilename = args[1]

    bucket, key = split_path(storedfilename)
    logger.info('rm bucket: %s, key: %s' % (bucket, key))

    try:
        get_client().delete_object(Bucket=bucket, Key=key)
    except client_errors():
        handle_server_error('Unable to remove key "%s"' % (key))

#
# Create directory
#
elif cmd == 'mkdir':
    archivename = args[0]
    dirname = args[1]

    logger.info('mkdir dir: %s' % (dirname))
    if '/' in dirname:
        logger.warning('skipping mkdir')
    else:
        bucket = dirname
        try:
            if S3LOCATION == 'us-east-1':
                get_client().create_bucket(Bucket=bucket)
            else:
                get_client().create_bucket(Bucket=bucket,
                                           CreateBucketConfiguration={'LocationConstraint': S3LOCATION})
        except client_errors():
            handle_server_error('Unable to create bucket "%s"' % (bucket))

#
# Remove directory
#
elif cmd == 'rmdir':
    archivename = args[0]
    dirname = args[1]

    logger.info('rmdir dir: %s' % (dirname))
    if '/' in dirname:
        logger.warning('skipping rmdir')
    else:
        bucket = dirname
        try:
            get_client().delete_bucket(Bucket=bucket)
        except client_errors():
            handle_server_error('Unable to delete bucket "%s"' % (bucket))

#
# Run from S3
#
elif cmd == 'run':
    archivename = args[0]
    storedfilename = args[1]
    arguments = args[2:]

    bucket, key = split_path(storedfilename)
    logger.info('run bucket: %s, key: %s' % (bucket, key))

    os.execv(storedfilename, arguments)
else:
    logger.error('unhandled, bye')
    sys.exit(1)

logger.debug('command handled')
sys.exit(0)
