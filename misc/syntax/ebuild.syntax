    keyword whole while KEYWORD_CONTROL

# here goes usable subset for .ebuild commands
    keyword whole awk SUPPORT_FUNCTION
    keyword whole sed SUPPORT_FUNCTION

    keyword whole /dev/audio CONSTANT_OTHER
    keyword whole /dev/dsp CONSTANT_OTHER
    keyword whole /dev/null CONSTANT_OTHER
    keyword whole /dev/mixed CONSTANT_OTHER
    keyword whole /dev/stdin CONSTANT_OTHER
    keyword whole /dev/stdout CONSTANT_OTHER
    keyword whole /dev/stderr CONSTANT_OTHER
