# Yum repo syntax highlighting
#
# Author: Andy Shevchenko <andy.shevchenko@gmail.com>

context default
    keyword whole enabled=0 CONSTANT_LANGUAGE
    keyword whole gpgcheck=0 CONSTANT_LANGUAGE
    keyword whole enabled=1 CONSTANT_LANGUAGE
    keyword whole gpgcheck=1 CONSTANT_LANGUAGE

context # \n COMMENT_LINE
    spellcheck

context [ ] ENTITY_NAME_SECTION
context exclusive = \n STRING_UNQUOTED
