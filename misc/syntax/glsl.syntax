# Deprecated variables

    keyword whole gl_FragColor VARIABLE_OTHER
    keyword whole gl_FragData VARIABLE_OTHER
    keyword whole gl_MaxVarying VARIABLE_OTHER
    keyword whole gl_MaxVaryingFloats VARIABLE_OTHER
    keyword whole gl_MaxVaryingComponents VARIABLE_OTHER

# Comments
    keyword /\* COMMENT_BLOCK
    keyword \*/ COMMENT_BLOCK
    keyword // COMMENT_LINE

# Preprocessor
    keyword # META_PREPROCESSOR

# Punctuation
    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword != KEYWORD_OPERATOR
    keyword == KEYWORD_OPERATOR
    keyword & KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    keyword :: KEYWORD_OPERATOR
    keyword -> KEYWORD_OPERATOR
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR

context exclusive # \n META_PREPROCESSOR
    keyword \\\n PUNCTUATION_SEPARATOR_CONTINUATION
    keyword /\**\*/ COMMENT_BLOCK
    keyword //*\n COMMENT_LINE
    keyword "+" STRING_QUOTED_DOUBLE
    keyword <+> STRING_QUOTED_OTHER
context exclusive /\* \*/ COMMENT_BLOCK
    spellcheck
context exclusive // \n COMMENT_LINE
    spellcheck

context " " STRING_QUOTED_DOUBLE
    spellcheck
context ' ' STRING_QUOTED_SINGLE
    spellcheck
