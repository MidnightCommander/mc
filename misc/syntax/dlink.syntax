    keyword whole \*\*\*\*\*\*\*\* CONSTANT_OTHER
    keyword whole \[1234567890\].\[1234567890\].\[1234567890\].\[1234567890\]/\[1234567890\] CONSTANT_OTHER
    keyword whole \[1234567890\].\[1234567890\].\[1234567890\].\[1234567890\] CONSTANT_NUMERIC
    keyword whole \[1234567890abcdefABCDEDF\]:\[1234567890abcdefABCDEF\]:\[1234567890abcdefABCDEF\]:\[1234567890abcdefABCDEF\]:\[1234567890abcdefABCDEF\]:\[1234567890abcdefABCDEF\] CONSTANT_OTHER
    keyword whole \[1234567890abcdefABCDEDF\]-\[1234567890abcdefABCDEF\]-\[1234567890abcdefABCDEF\]-\[1234567890abcdefABCDEF\]-\[1234567890abcdefABCDEF\]-\[1234567890abcdefABCDEF\] CONSTANT_OTHER
