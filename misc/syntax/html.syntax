
# html highlighting with tags in caps always. if you want everything in lowercase
# use tr

# i got upto IMG in the netscape comprehensive tags reference. thereafter will get
# done later - paul

caseinsensitive

context default
    keyword whole &*; CONSTANT_CHARACTER_ESCAPE
    spellcheck

    keyword </A> ENTITY_NAME_TAG
    keyword </ADDRESS> ENTITY_NAME_TAG
    keyword </APPLET> ENTITY_NAME_TAG
    keyword </AREA> ENTITY_NAME_TAG
    keyword </B> ENTITY_NAME_TAG
