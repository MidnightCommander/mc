# TREE-META (both source and object code) Syntax Highlighting Definition
# Version 1.0.0 2026-03-19
# See updates and changelog at https://github.com/jip/syntax-highlighting
#
# TREE-META is a metacompiler developed by D. Andrews and J. Rulifson in
# the 1967, see:
# Andrews, D. I., Rulifson, J. F. (1967). Tree Meta (Working Draft):
# A Meta Compiler for the SDS 940. Stanford Research Institute, Menlo
# Park, CA. Engelbart Collection, Stanford University Archive.
#
# This file is part of GNU Midnight Commander
# https://midnight-commander.org/
#
# SPDX-FileCopyrightText: 2026 Igor Zhuravlov <zhuravlov.ip@ya.ru>
# SPDX-License-Identifier: GPL-3.0-or-later

caseinsensitive

# for the default (lightgray on blue)
define _alerthi KEYWORD_OTHER_TODO red
define _alertmi KEYWORD_OTHER_TODO yellow
define _alertlo KEYWORD_OTHER_TODO cyan
define _sep     PUNCTUATION_SEPARATOR

context default
    # object code
    keyword whole ADD KEYWORD_OTHER_RESERVED
    keyword whole AND KEYWORD_OTHER_RESERVED
    keyword whole BF KEYWORD_OTHER_RESERVED
    keyword whole BRARG KEYWORD_OTHER_RESERVED
    keyword whole BR KEYWORD_OTHER_RESERVED
    keyword whole BT KEYWORD_OTHER_RESERVED
    keyword whole CALL KEYWORD_OTHER_RESERVED
    keyword whole CBTP KEYWORD_OTHER_RESERVED
    keyword whole CELL KEYWORD_OTHER_RESERVED
    keyword whole CGER KEYWORD_OTHER_RESERVED
    keyword whole CHASE KEYWORD_OTHER_RESERVED
    keyword whole CHRCODE KEYWORD_OTHER_RESERVED
    keyword whole CHR KEYWORD_OTHER_RESERVED
    keyword whole CKBR KEYWORD_OTHER_RESERVED
    keyword whole CKCHR KEYWORD_OTHER_RESERVED
    keyword whole CKDIG KEYWORD_OTHER_RESERVED
    keyword whole CKHEX KEYWORD_OTHER_RESERVED
    keyword whole CKID KEYWORD_OTHER_RESERVED
    keyword whole CKLAB KEYWORD_OTHER_RESERVED
    keyword whole CKLET KEYWORD_OTHER_RESERVED
    keyword whole CKNDNAM KEYWORD_OTHER_RESERVED
    keyword whole CKNUM KEYWORD_OTHER_RESERVED
    keyword whole CKOCT KEYWORD_OTHER_RESERVED
    keyword whole CKSR KEYWORD_OTHER_RESERVED
    keyword whole CKTXT KEYWORD_OTHER_RESERVED
    keyword whole CLABS KEYWORD_OTHER_RESERVED
    keyword whole CMPEQ KEYWORD_OTHER_RESERVED
    keyword whole CMPL KEYWORD_OTHER_RESERVED
    keyword whole CMPNEQ KEYWORD_OTHER_RESERVED
    keyword whole CMPSGET KEYWORD_OTHER_RESERVED
    keyword whole CMPSGT KEYWORD_OTHER_RESERVED
    keyword whole CMPSLET KEYWORD_OTHER_RESERVED
    keyword whole CMPSLT KEYWORD_OTHER_RESERVED
    keyword whole CMPUGET KEYWORD_OTHER_RESERVED
    keyword whole CMPUGT KEYWORD_OTHER_RESERVED
    keyword whole CMPULET KEYWORD_OTHER_RESERVED
    keyword whole CMPULT KEYWORD_OTHER_RESERVED
    keyword whole CNTCK KEYWORD_OTHER_RESERVED
    keyword whole DIG KEYWORD_OTHER_RESERVED
    keyword whole DUMP KEYWORD_OTHER_RESERVED
    keyword whole EOR KEYWORD_OTHER_RESERVED
    keyword whole ERCHK KEYWORD_OTHER_RESERVED
    keyword whole ERSTR KEYWORD_OTHER_RESERVED
    keyword whole FUNC KEYWORD_OTHER_RESERVED
    keyword whole GNLB KEYWORD_OTHER_RESERVED
    keyword whole HEX KEYWORD_OTHER_RESERVED
    keyword whole ID KEYWORD_OTHER_RESERVED
    keyword whole LBARG KEYWORD_OTHER_RESERVED
    keyword whole LET KEYWORD_OTHER_RESERVED
    keyword whole LNEG KEYWORD_OTHER_RESERVED
    keyword whole LOADI KEYWORD_OTHER_RESERVED
    keyword whole LOAD KEYWORD_OTHER_RESERVED
    keyword whole LSH KEYWORD_OTHER_RESERVED
    keyword whole MOVTO KEYWORD_OTHER_RESERVED
    keyword whole MUL KEYWORD_OTHER_RESERVED
    keyword whole NDLBL KEYWORD_OTHER_RESERVED
    keyword whole NDMK KEYWORD_OTHER_RESERVED
    keyword whole NEG KEYWORD_OTHER_RESERVED
    keyword whole NUM KEYWORD_OTHER_RESERVED
    keyword whole NXTBR KEYWORD_OTHER_RESERVED
    keyword whole OCT KEYWORD_OTHER_RESERVED
    keyword whole OER KEYWORD_OTHER_RESERVED
    keyword whole ONL KEYWORD_OTHER_RESERVED
    keyword whole OR KEYWORD_OTHER_RESERVED
    keyword whole OUTCH KEYWORD_OTHER_RESERVED
    keyword whole OUTCL KEYWORD_OTHER_RESERVED
    keyword whole OUTRE KEYWORD_OTHER_RESERVED
    keyword whole OUTSR KEYWORD_OTHER_RESERVED
    keyword whole RC KEYWORD_OTHER_RESERVED
    keyword whole RSTBR KEYWORD_OTHER_RESERVED
    keyword whole RSTRP KEYWORD_OTHER_RESERVED
    keyword whole R KEYWORD_OTHER_RESERVED
    keyword whole SAVEP KEYWORD_OTHER_RESERVED
    keyword whole SBTP KEYWORD_OTHER_RESERVED
    keyword whole SDIV KEYWORD_OTHER_RESERVED
    keyword whole SET KEYWORD_OTHER_RESERVED
    keyword whole SMOD KEYWORD_OTHER_RESERVED
    keyword whole SRARG KEYWORD_OTHER_RESERVED
    keyword whole SRCHECK KEYWORD_OTHER_RESERVED
    keyword whole SRINIT KEYWORD_OTHER_RESERVED
    keyword whole SRP KEYWORD_OTHER_RESERVED
    keyword whole SRSH KEYWORD_OTHER_RESERVED
    keyword whole SR KEYWORD_OTHER_RESERVED
    keyword whole STORE KEYWORD_OTHER_RESERVED
    keyword whole SUB KEYWORD_OTHER_RESERVED
    keyword whole TST KEYWORD_OTHER_RESERVED
    keyword whole UDIV KEYWORD_OTHER_RESERVED
    keyword whole UMOD KEYWORD_OTHER_RESERVED
    keyword whole URSH KEYWORD_OTHER_RESERVED
    # - label
    keyword whole linestart %\{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\]: ENTITY_NAME_LABEL
    keyword whole linestart \{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\]: ENTITY_NAME_LABEL
    # source
    # - keywords
    wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.
    keyword whole .CHR KEYWORD_OTHER_RESERVED
    keyword whole .DELIM KEYWORD_OTHER_RESERVED
    keyword whole .DIG KEYWORD_OTHER_RESERVED
    keyword whole .EMPTY KEYWORD_OTHER_RESERVED
    keyword whole .END KEYWORD_OTHER_RESERVED
    keyword whole .HEX KEYWORD_OTHER_RESERVED
    keyword whole .ID KEYWORD_OTHER_RESERVED
    keyword whole .LET KEYWORD_OTHER_RESERVED
    keyword whole .LIST KEYWORD_OTHER_RESERVED
    keyword whole .META KEYWORD_OTHER_RESERVED
    keyword whole .NUM KEYWORD_OTHER_RESERVED
    keyword whole .OCT KEYWORD_OTHER_RESERVED
    keyword whole .SR KEYWORD_OTHER_RESERVED
    wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
    # - functions
    keyword whole CLEAR SUPPORT_FUNCTION
    keyword whole CODE SUPPORT_FUNCTION
    keyword whole CONV SUPPORT_FUNCTION
    keyword whole ENTER SUPPORT_FUNCTION
    keyword whole LEN SUPPORT_FUNCTION
    keyword whole LOOK SUPPORT_FUNCTION
    keyword whole OUTC SUPPORT_FUNCTION
    keyword whole OUTL SUPPORT_FUNCTION
    keyword whole OUTS SUPPORT_FUNCTION
    keyword whole OUT SUPPORT_FUNCTION
    keyword whole POP SUPPORT_FUNCTION
    keyword whole PUSH SUPPORT_FUNCTION
    keyword whole XCONV SUPPORT_FUNCTION
    # - identifier
    keyword whole \{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\] VARIABLE_OTHER
    # - natural decimal integer numbers
    keyword whole 0 CONSTANT_NUMERIC
    keyword whole \{123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    # - label
    keyword whole #\{1234\} KEYWORD_OTHER_RESERVED
    # - assignment
    keyword := KEYWORD_OPERATOR
    keyword => KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    # - operators
    keyword %% KEYWORD_OPERATOR
    keyword // KEYWORD_OPERATOR
    keyword <- KEYWORD_OPERATOR
    keyword << KEYWORD_OPERATOR
    keyword >>> KEYWORD_OPERATOR
    keyword >> KEYWORD_OPERATOR
    keyword <= KEYWORD_OPERATOR
    keyword >= KEYWORD_OPERATOR
    keyword \{!#$%&\*\+-.<=>?@^~\} KEYWORD_OPERATOR
    # - alternation
    keyword / KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    # - parentheses
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    # - separators,terminator
    keyword \{,:;\} _sep

# strings

context ' ' STRING_QUOTED_SINGLE

context " " STRING_QUOTED_DOUBLE

# comments

context £ £ COMMENT_BLOCK
    keyword whole BUG        _alerthi
    keyword whole DEPRECATED _alertmi
    keyword whole FIXME      _alerthi
    keyword whole NOTE       _alertlo
    keyword whole TEST       _alertlo
    keyword whole TODO       _alertmi
    keyword whole WARN       _alertmi
    spellcheck
