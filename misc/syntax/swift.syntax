define keywords KEYWORD_CONTROL
define attributes STORAGE_MODIFIER
define operators KEYWORD_OPERATOR
define comments COMMENT_LINE
define strings STRING_QUOTED_DOUBLE
define escapedchars CONSTANT_CHARACTER_ESCAPE
define interpolation VARIABLE_OTHER
define unicode CONSTANT_CHARACTER_ESCAPE
define brackets PUNCTUATION_SECTION
define punctuation PUNCTUATION_SEPARATOR
define range KEYWORD_OPERATOR
define semicolon PUNCTUATION_TERMINATOR
define compilerstatements META_PREPROCESSOR

context default
    keyword whole associatedtype STORAGE_TYPE
    keyword whole class STORAGE_TYPE_CLASS
    keyword whole deinit STORAGE_TYPE_FUNCTION
    keyword whole enum STORAGE_TYPE_CLASS
    keyword whole extension STORAGE_TYPE_CLASS
    keyword whole fileprivate STORAGE_MODIFIER
    keyword whole func STORAGE_TYPE_FUNCTION
    keyword whole import KEYWORD_CONTROL_IMPORT
    keyword whole init STORAGE_TYPE_FUNCTION
    keyword whole inout STORAGE_MODIFIER
    keyword whole internal STORAGE_MODIFIER
    keyword whole let STORAGE_TYPE
    keyword whole open STORAGE_MODIFIER
    keyword whole operator STORAGE_MODIFIER
    keyword whole private STORAGE_MODIFIER
    keyword whole protocol STORAGE_TYPE_CLASS
    keyword whole public STORAGE_MODIFIER
    keyword whole rethrows STORAGE_MODIFIER
    keyword whole static STORAGE_MODIFIER
    keyword whole struct STORAGE_TYPE_CLASS
    keyword whole subscript STORAGE_TYPE_FUNCTION
    keyword whole typealias STORAGE_TYPE
    keyword whole var STORAGE_TYPE

    keyword whole break KEYWORD_CONTROL
    keyword whole case KEYWORD_CONTROL
    keyword whole continue KEYWORD_CONTROL
    keyword whole default KEYWORD_CONTROL
    keyword whole defer KEYWORD_CONTROL
    keyword whole do KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole fallthrough KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole guard KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole in KEYWORD_CONTROL
    keyword whole repeat KEYWORD_CONTROL
    keyword whole return KEYWORD_CONTROL
    keyword whole switch KEYWORD_CONTROL
    keyword whole where KEYWORD_CONTROL
    keyword whole while KEYWORD_CONTROL

    keyword whole as KEYWORD_OPERATOR_WORD
    keyword whole catch KEYWORD_CONTROL
    keyword whole false CONSTANT_LANGUAGE
    keyword whole is KEYWORD_OPERATOR_WORD
    keyword whole nil CONSTANT_LANGUAGE
    keyword whole self VARIABLE_LANGUAGE
    keyword whole Self VARIABLE_LANGUAGE
    keyword whole super VARIABLE_LANGUAGE
    keyword whole throws STORAGE_MODIFIER
    keyword whole throw KEYWORD_CONTROL
    keyword whole true CONSTANT_LANGUAGE
    keyword whole try KEYWORD_CONTROL

    keyword whole associativity KEYWORD_OTHER_RESERVED
    keyword whole convenience STORAGE_MODIFIER
    keyword whole didSet KEYWORD_OTHER_RESERVED
    keyword whole dynamic STORAGE_MODIFIER
    keyword whole final STORAGE_MODIFIER
    keyword whole get KEYWORD_OTHER_RESERVED
    keyword whole indirect STORAGE_MODIFIER
    keyword whole infix STORAGE_MODIFIER
    keyword whole lazy STORAGE_MODIFIER
    keyword whole left KEYWORD_OTHER_RESERVED
    keyword whole mutating STORAGE_MODIFIER
    keyword whole none KEYWORD_OTHER_RESERVED
    keyword whole nonmutating STORAGE_MODIFIER
    keyword whole optional STORAGE_MODIFIER
    keyword whole override STORAGE_MODIFIER
    keyword whole postfix STORAGE_MODIFIER
    keyword whole precedence KEYWORD_OTHER_RESERVED
    keyword whole prefix STORAGE_MODIFIER
    keyword whole Protocol KEYWORD_OTHER_RESERVED
    keyword whole required STORAGE_MODIFIER
    keyword whole right KEYWORD_OTHER_RESERVED
    keyword whole set KEYWORD_OTHER_RESERVED
    keyword whole Type KEYWORD_OTHER_RESERVED
    keyword whole unowned STORAGE_MODIFIER
    keyword whole weak STORAGE_MODIFIER
    keyword whole willSet KEYWORD_OTHER_RESERVED

    keyword whole Any SUPPORT_TYPE
    keyword whole Bool STORAGE_TYPE_PRIMITIVE
    keyword whole Double STORAGE_TYPE_PRIMITIVE
    keyword whole Float STORAGE_TYPE_PRIMITIVE
    keyword whole Character SUPPORT_TYPE
    keyword whole Int STORAGE_TYPE_PRIMITIVE
    keyword whole Int16 STORAGE_TYPE_PRIMITIVE
    keyword whole Int32 STORAGE_TYPE_PRIMITIVE
    keyword whole Int64 STORAGE_TYPE_PRIMITIVE
    keyword whole Int8 STORAGE_TYPE_PRIMITIVE
    keyword whole String SUPPORT_TYPE
    keyword whole UInt STORAGE_TYPE_PRIMITIVE
    keyword whole UInt16 STORAGE_TYPE_PRIMITIVE
    keyword whole UInt32 STORAGE_TYPE_PRIMITIVE
    keyword whole UInt64 STORAGE_TYPE_PRIMITIVE
    keyword whole UInt8 STORAGE_TYPE_PRIMITIVE

    keyword whole assert SUPPORT_FUNCTION
    keyword whole precondition SUPPORT_FUNCTION

    keyword // COMMENT_LINE
    keyword /\* COMMENT_BLOCK
    keyword *\*/ COMMENT_BLOCK

    keyword > operators
    keyword < operators
    keyword \+ operators
    keyword - operators
    keyword \* operators
    keyword / operators
    keyword % operators
    keyword = operators
    keyword != operators
    keyword == operators
    keyword | operators
    keyword & operators
    keyword ^ operators
    keyword ~ operators
    keyword ! operators
    keyword whole _ operators
    keyword { brackets
    keyword } brackets
    keyword ( brackets
    keyword ) brackets
    keyword [ brackets
    keyword ] brackets
    keyword . PUNCTUATION_SEPARATOR
    keyword , PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ? PUNCTUATION_SEPARATOR
    keyword ... range
    keyword ..< range
    keyword ; semicolon

    keyword `*` VARIABLE_OTHER

    keyword whole @available STORAGE_MODIFIER
    keyword whole @escaping STORAGE_MODIFIER
    keyword whole @unavailable STORAGE_MODIFIER
    keyword whole @introduced STORAGE_MODIFIER
    keyword whole @deprecated STORAGE_MODIFIER
    keyword whole @obsolete STORAGE_MODIFIER
    keyword whole @message STORAGE_MODIFIER
    keyword whole @main STORAGE_MODIFIER
    keyword whole @renamed STORAGE_MODIFIER
    keyword whole @discardableResult STORAGE_MODIFIER
    keyword whole @dynamicCallable STORAGE_MODIFIER
    keyword whole @dynamicMemberLookup STORAGE_MODIFIER
    keyword whole @frozen STORAGE_MODIFIER
    keyword whole @GKInspectable STORAGE_MODIFIER
    keyword whole @inlinable STORAGE_MODIFIER
    keyword whole @nonobjc STORAGE_MODIFIER
    keyword whole @NSApplicationMain STORAGE_MODIFIER
    keyword whole @NSCopying STORAGE_MODIFIER
    keyword whole @objc STORAGE_MODIFIER
    keyword whole @NSManaged STORAGE_MODIFIER
    keyword whole @objcMembers STORAGE_MODIFIER
    keyword whole @propertyWrapper STORAGE_MODIFIER
    keyword whole @requires_stored_property_inits STORAGE_MODIFIER
    keyword whole @testable STORAGE_MODIFIER
    keyword whole @UIApplicationMain STORAGE_MODIFIER
    keyword whole @usableFromInline STORAGE_MODIFIER
    keyword whole @warn_unqualified_access STORAGE_MODIFIER
    keyword whole @autoclosure STORAGE_MODIFIER
    keyword whole @convention STORAGE_MODIFIER
    keyword whole @escaping STORAGE_MODIFIER
    keyword whole @unknown STORAGE_MODIFIER


context exclusive /\* \*/ COMMENT_BLOCK
    spellcheck


context exclusive // \n COMMENT_LINE
    spellcheck


context linestart # \n META_PREPROCESSOR


context #""" """# STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\(*) interpolation
    keyword \\\{0tnr"'\\\} escapedchars
    keyword \\u{*} unicode


context """ """ STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\(*) interpolation
    keyword \\\{0tnr"'\\\} escapedchars
    keyword \\u{*} unicode


context #" "# STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\(*) interpolation
    keyword \\\{0tnr"'\\\} escapedchars
    keyword \\u{*} unicode


context " " STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\(*) interpolation
    keyword \\\{0tnr"'\\\} escapedchars
    keyword \\u{*} unicode
