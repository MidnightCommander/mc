#
# Dan Dascalescu
# Template::Toolkit syntax file
# HTML entities
#
context default
    keyword &\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\]; CONSTANT_CHARACTER_ESCAPE
    keyword &#\{xX\}\[0123456789abcdefABCDEF\]; CONSTANT_CHARACTER_ESCAPE
    keyword &#\[0123456789\]; CONSTANT_CHARACTER_ESCAPE

# Although TT is most often used to generate HTML, it's not *only* used for that, so assuming HTML around it may be presumptuous anyway.
# Since cooledit doesn't support sub-context, we can't have TT *in* HTML, like <img src="[% image_url %]">
# The best possible workaround, which still sucks, is to uncomment the line below, which will highlight any HTML tags that don't contain a '[', but without special highlight for strings, and without any HTML-specific keywords
#    keyword <\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ01234567890\s"#$%&'()*+,-.=?@\\\]^_`{|}~\]> green
    spellcheck

# TT directives - https://template-toolkit.org/docs/manual/Directives.html
context [% %] META_PREPROCESSOR black
    keyword whole GET KEYWORD_OTHER_RESERVED
    keyword whole CALL KEYWORD_OTHER_RESERVED
    keyword whole SET KEYWORD_OTHER_RESERVED
    keyword whole DEFAULT KEYWORD_OTHER_RESERVED

    keyword whole INSERT KEYWORD_OTHER_RESERVED
    keyword whole INCLUDE KEYWORD_OTHER_RESERVED
    keyword whole PROCESS KEYWORD_OTHER_RESERVED
    keyword whole WRAPPER KEYWORD_OTHER_RESERVED
    keyword whole BLOCK KEYWORD_OTHER_RESERVED

    keyword whole IF KEYWORD_CONTROL
    keyword whole UNLESS KEYWORD_CONTROL
    keyword whole ELSIF KEYWORD_CONTROL
    keyword whole ELSE KEYWORD_CONTROL
    keyword whole SWITCH KEYWORD_CONTROL
    keyword whole CASE KEYWORD_CONTROL

    keyword whole FOREACH KEYWORD_CONTROL
    keyword whole IN KEYWORD_CONTROL
    keyword whole WHILE KEYWORD_CONTROL

    keyword whole FILTER KEYWORD_OTHER_RESERVED
    keyword whole USE KEYWORD_OTHER_RESERVED
    keyword whole MACRO KEYWORD_OTHER_RESERVED
    keyword whole PERL KEYWORD_OTHER_RESERVED
    keyword whole RAWPERL KEYWORD_OTHER_RESERVED

    keyword whole TRY KEYWORD_CONTROL
    keyword whole THROW KEYWORD_CONTROL
    keyword whole CATCH KEYWORD_CONTROL
    keyword whole FINAL KEYWORD_CONTROL

    keyword whole NEXT KEYWORD_CONTROL
    keyword whole LAST KEYWORD_CONTROL
    keyword whole RETURN KEYWORD_CONTROL
    keyword whole STOP KEYWORD_CONTROL
    keyword whole CLEAR KEYWORD_OTHER_RESERVED
    keyword whole META KEYWORD_OTHER_RESERVED
    keyword whole TAGS KEYWORD_OTHER_RESERVED
    keyword whole DEBUG KEYWORD_OTHER_RESERVED

    keyword whole END KEYWORD_CONTROL

# AND, OR and NOT are apparently not documented
    keyword whole AND KEYWORD_OPERATOR_WORD
    keyword whole OR KEYWORD_OPERATOR_WORD
    keyword whole NOT KEYWORD_OPERATOR_WORD
    keyword | KEYWORD_OPERATOR

# TT VMethods - https://template-toolkit.org/docs/manual/VMethods.html
    keyword .defined SUPPORT_FUNCTION
    keyword .length SUPPORT_FUNCTION
    keyword .repeat SUPPORT_FUNCTION
    keyword .replace SUPPORT_FUNCTION
    keyword .remove SUPPORT_FUNCTION
    keyword .match SUPPORT_FUNCTION
    keyword .search SUPPORT_FUNCTION
    keyword .split SUPPORT_FUNCTION
    keyword .chunk SUPPORT_FUNCTION
    keyword .substr SUPPORT_FUNCTION
    keyword .list SUPPORT_FUNCTION
    keyword .hash SUPPORT_FUNCTION
    keyword .size SUPPORT_FUNCTION
    keyword .keys SUPPORT_FUNCTION
    keyword .values SUPPORT_FUNCTION
    keyword .items SUPPORT_FUNCTION
    keyword .each SUPPORT_FUNCTION
    keyword .pairs SUPPORT_FUNCTION
    keyword .sort SUPPORT_FUNCTION
    keyword .nsort SUPPORT_FUNCTION
    keyword .import SUPPORT_FUNCTION
    keyword .exists SUPPORT_FUNCTION
    keyword .delete SUPPORT_FUNCTION
    keyword .item SUPPORT_FUNCTION
    keyword .first SUPPORT_FUNCTION
    keyword .last SUPPORT_FUNCTION
    keyword .max SUPPORT_FUNCTION
    keyword .reverse SUPPORT_FUNCTION
    keyword .join SUPPORT_FUNCTION
    keyword .grep SUPPORT_FUNCTION
    keyword .unshift SUPPORT_FUNCTION
    keyword .push SUPPORT_FUNCTION
    keyword .shift SUPPORT_FUNCTION
    keyword .pop SUPPORT_FUNCTION
    keyword .unique SUPPORT_FUNCTION
    keyword .merge SUPPORT_FUNCTION
    keyword .slice SUPPORT_FUNCTION
    keyword .splice SUPPORT_FUNCTION

    keyword "*" STRING_QUOTED_DOUBLE
    keyword '*' STRING_QUOTED_SINGLE

# HTML comments
context <!-- --> COMMENT_BLOCK
    spellcheck

# HTML DOCTYPE
context <! > META_PREPROCESSOR
    spellcheck

# HTML end tags
context </ > ENTITY_NAME_TAG

# HTML open tags - enabling this will hide TT syntax in HTML, e.g. <img src="[% image_url %]">
#context < > brightcyan
#   keyword "*" green
#   keyword = yellow
