context linestart #! \n COMMENT_LINE black

context exclusive whole <\[\s\\\]EOF EOF STRING_QUOTED_OTHER

context # \n COMMENT_LINE
    spellcheck

context exclusive linestart = linestart =cut COMMENT_BLOCK
    spellcheck

context " " STRING_QUOTED_DOUBLE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE

context ' ' STRING_QUOTED_SINGLE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE

context exclusive qw( ) STRING_QUOTED_OTHER

context exclusive ` ` STRING_QUOTED_OTHER black

context whole __END__ guacomale_pudding COMMENT_BLOCK
