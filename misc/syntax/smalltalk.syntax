# I guess this is not very syntax strict, but it makes the code
# a lot more readable.

context default
    keyword whole methodsFor KEYWORD_OTHER_RESERVED
    keyword whole subclass KEYWORD_OTHER_RESERVED
    keyword whole class STORAGE_TYPE_CLASS
    keyword whole nil CONSTANT_LANGUAGE
    keyword whole self VARIABLE_LANGUAGE
    keyword whole instanceVariableNames KEYWORD_OTHER_RESERVED
    keyword whole classVariableNames KEYWORD_OTHER_RESERVED
    keyword whole poolDictionaries KEYWORD_OTHER_RESERVED
    keyword whole category KEYWORD_OTHER_RESERVED
    keyword whole super VARIABLE_LANGUAGE
    keyword whole category KEYWORD_OTHER_RESERVED
    keyword whole variableSubclass KEYWORD_OTHER_RESERVED
    keyword whole variableByteSubclass KEYWORD_OTHER_RESERVED
    keyword whole variableWordSubclass KEYWORD_OTHER_RESERVED
    keyword whole superclass KEYWORD_OTHER_RESERVED

    keyword whole not KEYWORD_OPERATOR_WORD
    keyword whole comment SUPPORT_FUNCTION
    keyword whole error SUPPORT_FUNCTION
    keyword whole at SUPPORT_FUNCTION
    keyword whole put SUPPORT_FUNCTION
    keyword whole add SUPPORT_FUNCTION
    keyword whole remove SUPPORT_FUNCTION
    keyword whole new SUPPORT_FUNCTION
    keyword whole ifTrue KEYWORD_CONTROL
    keyword whole ifFalse KEYWORD_CONTROL
    keyword whole whileTrue KEYWORD_CONTROL
    keyword whole whileFalse KEYWORD_CONTROL
    keyword whole ifAbsent KEYWORD_CONTROL
    keyword whole init SUPPORT_FUNCTION
    keyword whole do KEYWORD_CONTROL
    keyword whole from KEYWORD_OTHER_RESERVED
    keyword whole with KEYWORD_OTHER_RESERVED
    keyword whole do KEYWORD_CONTROL
    keyword whole true CONSTANT_LANGUAGE
    keyword whole false CONSTANT_LANGUAGE
    keyword whole or KEYWORD_OPERATOR_WORD
    keyword whole and KEYWORD_OPERATOR_WORD
    keyword whole to KEYWORD_CONTROL
    keyword whole by KEYWORD_CONTROL

    keyword whole Smalltalk SUPPORT_CLASS
    keyword whole Object SUPPORT_CLASS
    keyword whole Autoload SUPPORT_CLASS
    keyword whole Behavior SUPPORT_CLASS
    keyword whole ClassDescription SUPPORT_CLASS
    keyword whole Class SUPPORT_CLASS
    keyword whole MetaClass SUPPORT_CLASS
    keyword whole BlockContext SUPPORT_CLASS
    keyword whole Boolean SUPPORT_CLASS
    keyword whole False SUPPORT_CLASS
    keyword whole True SUPPORT_CLASS
    keyword whole CFunctionDescriptor SUPPORT_CLASS
    keyword whole CObject SUPPORT_CLASS
    keyword whole Collection SUPPORT_CLASS
    keyword whole Bag SUPPORT_CLASS
    keyword whole MappedCollection SUPPORT_CLASS
    keyword whole SequenceableCollection SUPPORT_CLASS
    keyword whole ArrayedCollection SUPPORT_CLASS
    keyword whole Array SUPPORT_CLASS
    keyword whole ByteArray SUPPORT_CLASS
    keyword whole CompiledCollection SUPPORT_CLASS
    keyword whole String SUPPORT_CLASS
    keyword whole Symbol SUPPORT_CLASS
    keyword whole Interval SUPPORT_CLASS
    keyword whole LinkedList SUPPORT_CLASS
    keyword whole Semaphore SUPPORT_CLASS
    keyword whole OrderedCollection SUPPORT_CLASS
    keyword whole SortedCollection SUPPORT_CLASS
    keyword whole Set SUPPORT_CLASS
    keyword whole Dictionary SUPPORT_CLASS
    keyword whole IdentityDictionary SUPPORT_CLASS
    keyword whole SystemDictionary SUPPORT_CLASS
    keyword whole Delay SUPPORT_CLASS
    keyword whole FileSegment SUPPORT_CLASS
    keyword whole Link SUPPORT_CLASS
    keyword whole Process SUPPORT_CLASS
    keyword whole SymLink SUPPORT_CLASS
    keyword whole Magnitude SUPPORT_CLASS
    keyword whole Character SUPPORT_CLASS
    keyword whole Date SUPPORT_CLASS
    keyword whole LookupKey SUPPORT_CLASS
    keyword whole Association SUPPORT_CLASS
    keyword whole Number SUPPORT_CLASS
    keyword whole Float SUPPORT_CLASS
    keyword whole Integer SUPPORT_CLASS
    keyword whole Time SUPPORT_CLASS
    keyword whole Memory SUPPORT_CLASS
    keyword whole ByteMemory SUPPORT_CLASS
    keyword whole WordMemory SUPPORT_CLASS
    keyword whole Message SUPPORT_CLASS
    keyword whole MethodContext SUPPORT_CLASS
    keyword whole MethodInfo SUPPORT_CLASS
    keyword whole ProcessorScheduler SUPPORT_CLASS
    keyword whole SharedQueue SUPPORT_CLASS
    keyword whole Stream SUPPORT_CLASS
    keyword whole PositionableStream SUPPORT_CLASS
    keyword whole ReadStream SUPPORT_CLASS
    keyword whole WriteStream SUPPORT_CLASS
    keyword whole ReadWriteStream SUPPORT_CLASS
    keyword whole FileStream SUPPORT_CLASS
    keyword whole Random SUPPORT_CLASS
    keyword whole TokenStream SUPPORT_CLASS
    keyword whole UndefinedObject SUPPORT_CLASS

    keyword wholeright !! PUNCTUATION_TERMINATOR
    keyword wholeright ! PUNCTUATION_TERMINATOR
    keyword wholeleft ! PUNCTUATION_TERMINATOR
    keyword wholeright . PUNCTUATION_TERMINATOR

    keyword > KEYWORD_OPERATOR
    keyword <> KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    keyword # KEYWORD_OPERATOR
    keyword @ KEYWORD_OPERATOR
    keyword ^ KEYWORD_OPERATOR
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword & KEYWORD_OPERATOR
    keyword $ KEYWORD_OPERATOR
    keyword . PUNCTUATION_TERMINATOR
    keyword ! PUNCTUATION_TERMINATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword _ KEYWORD_OPERATOR
    keyword ~ KEYWORD_OPERATOR
    keyword ? KEYWORD_OPERATOR

context $ ; CONSTANT_CHARACTER

context " " COMMENT_BLOCK

context ' ' STRING_QUOTED_SINGLE

    keyword \\\n CONSTANT_CHARACTER_ESCAPE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
