# ASP.NET syntax highlighting
#
# Author: Juan C. Olivares <juancri@juancri.com>
# https://www.juancri.com

context default
    keyword "*" STRING_QUOTED_DOUBLE
    keyword '*' STRING_QUOTED_SINGLE

    spellcheck

context <!-- --> COMMENT_BLOCK
    spellcheck

context <! > META_PREPROCESSOR
    keyword '+' STRING_QUOTED_SINGLE
    keyword "+" STRING_QUOTED_DOUBLE
    keyword \( PUNCTUATION_SECTION
    keyword \) PUNCTUATION_SECTION
    keyword \* KEYWORD_OPERATOR
    keyword \? KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword \| KEYWORD_OPERATOR
    keyword \, PUNCTUATION_SEPARATOR
    spellcheck

context <% %> META_PREPROCESSOR
    keyword Application KEYWORD_OTHER
    keyword Assembly KEYWORD_OTHER
    keyword Control KEYWORD_OTHER
    keyword Implements KEYWORD_OTHER
    keyword Import KEYWORD_OTHER
    keyword Inherits KEYWORD_OTHER
    keyword OutputCache KEYWORD_OTHER
    keyword Page KEYWORD_OTHER
    keyword Reference KEYWORD_OTHER
    keyword Register KEYWORD_OTHER
    keyword WebService KEYWORD_OTHER
    keyword \s+\= KEYWORD_OPERATOR
    keyword '*' STRING_QUOTED_SINGLE
    keyword "*" STRING_QUOTED_DOUBLE
    spellcheck

context < > ENTITY_NAME_TAG
    keyword \s+\= KEYWORD_OPERATOR
    keyword "server" STRING_QUOTED_DOUBLE
    keyword '*' STRING_QUOTED_SINGLE
    keyword "*" STRING_QUOTED_DOUBLE
    spellcheck
