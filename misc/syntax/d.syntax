context exclusive /\*\* \*/ COMMENT_BLOCK_DOCUMENTATION
    keyword \*/ COMMENT_BLOCK
    spellcheck
# ddoc
    keyword Authors: KEYWORD_OTHER
    keyword Author: KEYWORD_OTHER
    keyword BUGS: KEYWORD_OTHER
    keyword Bugs: KEYWORD_OTHER
    keyword Date: KEYWORD_OTHER
    keyword Deprecated: KEYWORD_OTHER
