context default

    keyword linestart \s\s\* MARKUP_LIST
    keyword linestart \s-- PUNCTUATION_SEPARATOR
    keyword linestart \s\s\s\s\+ MARKUP_LIST

    keyword <*@*> CONSTANT_OTHER
    keyword whole experimental; CONSTANT_OTHER
    keyword whole unstable; CONSTANT_OTHER
    keyword whole stable; CONSTANT_OTHER
    keyword whole urgency=low CONSTANT_OTHER
    keyword whole urgency=medium CONSTANT_OTHER
    keyword whole urgency=high CONSTANT_OTHER
    keyword whole urgency=LOW CONSTANT_OTHER
    keyword whole urgency=MEDIUM CONSTANT_OTHER
    keyword whole urgency=HIGH CONSTANT_OTHER

    keyword whole bug KEYWORD_OTHER
    keyword whole Bug KEYWORD_OTHER
    keyword whole BUG KEYWORD_OTHER
