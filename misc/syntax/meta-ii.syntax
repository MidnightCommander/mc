# META II (both source and object code) Syntax Highlighting Definition
# Version 1.0.0 2026-03-19
# See updates and changelog at https://github.com/jip/syntax-highlighting
#
# META II is a metacompiler developed by D.V. Schorre in the 1964
# http://doi.acm.org/10.1145/800257.808896
#
# This file is part of GNU Midnight Commander
# https://midnight-commander.org/
#
# SPDX-FileCopyrightText: 2026 Igor Zhuravlov <zhuravlov.ip@ya.ru>
# SPDX-License-Identifier: GPL-3.0-or-later

caseinsensitive

# for the default (lightgray on blue)
define _alerthi KEYWORD_OTHER_TODO red
define _alertmi KEYWORD_OTHER_TODO yellow
define _alertlo KEYWORD_OTHER_TODO cyan

context default
    # object code
    # - input
    keyword whole TST KEYWORD_OTHER
    keyword whole ID KEYWORD_OTHER
    keyword whole NUM KEYWORD_OTHER
    keyword whole SR KEYWORD_OTHER
    # - procedures
    keyword whole CLL KEYWORD_OTHER
    keyword whole R KEYWORD_OTHER
    # - branch flag
    keyword whole SET KEYWORD_OTHER
    # - execution flow
    keyword whole BT KEYWORD_OTHER
    keyword whole BF KEYWORD_OTHER
    keyword whole BE KEYWORD_OTHER
    keyword whole B KEYWORD_OTHER
    # - output recognized information
    keyword whole CL KEYWORD_OTHER
    keyword whole CI KEYWORD_OTHER
    # - generate labels
    keyword whole GN1 KEYWORD_OTHER
    keyword whole GN2 KEYWORD_OTHER
    # - control the output
    keyword whole LB KEYWORD_OTHER
    # - output
    keyword whole OUT KEYWORD_OTHER
    # - pseudo: begin, end
    keyword whole ADR KEYWORD_OTHER
    keyword whole END KEYWORD_OTHER
    # - extensions
    keyword whole GN KEYWORD_OTHER
    keyword whole NL KEYWORD_OTHER
    keyword whole TB KEYWORD_OTHER
    keyword whole LMI KEYWORD_OTHER
    keyword whole LMD KEYWORD_OTHER
    keyword whole CC KEYWORD_OTHER
    keyword whole CGE KEYWORD_OTHER
    keyword whole CLE KEYWORD_OTHER
    keyword whole CE KEYWORD_OTHER
    keyword whole LCH KEYWORD_OTHER
    keyword whole NOT KEYWORD_OTHER
    keyword whole TFT KEYWORD_OTHER
    keyword whole TFF KEYWORD_OTHER
    keyword whole RF KEYWORD_OTHER
    keyword whole SCN KEYWORD_OTHER
    # - label
    keyword whole linestart \{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\]\n ENTITY_NAME_TAG
    # source
    # - built-in keywords
    wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.
    keyword whole .SYNTAX KEYWORD_OTHER
    keyword whole .END KEYWORD_OTHER
    keyword whole .ID KEYWORD_OTHER
    keyword whole .STRING KEYWORD_OTHER
    keyword whole .NUMBER KEYWORD_OTHER
    keyword whole .LB KEYWORD_OTHER
    keyword whole .OUT KEYWORD_OTHER
    keyword whole .EMPTY KEYWORD_OTHER
    keyword whole .LABEL KEYWORD_OTHER
    # - extensions
    keyword whole .RESERVED KEYWORD_OTHER
    keyword whole .INCLUDE KEYWORD_OTHER
    keyword whole .CON KEYWORD_OTHER
    keyword whole .FILE KEYWORD_OTHER
    keyword whole .NL KEYWORD_OTHER
    keyword whole .TB KEYWORD_OTHER
    keyword whole .LM\+ KEYWORD_OTHER
    keyword whole .LM- KEYWORD_OTHER
    keyword whole .TOKEN KEYWORD_OTHER
    keyword whole .DELTOK KEYWORD_OTHER
    keyword whole .ANY KEYWORD_OTHER
    # - metalinguistic variables
    keyword \*\{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\] VARIABLE_OTHER
    keyword #\{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\] VARIABLE_OTHER
    keyword \{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\}\[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_\] VARIABLE_OTHER
    # - natural decimal integer numbers
    keyword whole 0 CONSTANT_NUMERIC
    keyword whole \{123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    # - assignment
    keyword \{:=\} KEYWORD_OPERATOR
    # - operators
    keyword \{$:\*#!\} KEYWORD_OPERATOR
    # - alternation
    keyword / KEYWORD_OPERATOR
    # - parentheses
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword < PUNCTUATION_SECTION
    keyword > PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    # - terminators
    keyword ., PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR

# strings

context ' ' STRING_QUOTED_SINGLE

context " " STRING_QUOTED_DOUBLE

# comments

context % % COMMENT_BLOCK
    keyword whole BUG        _alerthi
    keyword whole DEPRECATED _alertmi
    keyword whole FIXME      _alerthi
    keyword whole NOTE       _alertlo
    keyword whole TEST       _alertlo
    keyword whole TODO       _alertmi
    keyword whole WARN       _alertmi
    spellcheck
