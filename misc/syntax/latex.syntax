context % \n COMMENT_LINE

context exclusive \\begin{verbatim} \\end{verbatim} MARKUP_RAW

# mathematical formulas
context $ $ STRING_OTHER_MATH
context exclusive \\begin{equation} \\end{equation} STRING_OTHER_MATH
context exclusive \\begin{displaymath} \\end{displaymath} STRING_OTHER_MATH
context exclusive \\begin{eqnarray} \\end{eqnarray} STRING_OTHER_MATH
