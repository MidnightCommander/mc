# Pascal (BP7 IDE alike)

caseinsensitive

context default
    keyword whole absolute STORAGE_MODIFIER
    keyword whole abstract STORAGE_MODIFIER
    keyword whole and KEYWORD_OPERATOR_WORD
    keyword whole array STORAGE_TYPE
    keyword whole as KEYWORD_OPERATOR_WORD
    keyword whole asm KEYWORD_OTHER_RESERVED
    keyword whole assembler KEYWORD_OTHER
    keyword whole begin KEYWORD_CONTROL
    keyword whole break KEYWORD_CONTROL
    keyword whole case KEYWORD_CONTROL
    keyword whole cdecl STORAGE_MODIFIER
    keyword whole class STORAGE_TYPE_CLASS
    keyword whole const STORAGE_MODIFIER
    keyword whole continue KEYWORD_CONTROL
    keyword whole constructor KEYWORD_OTHER
    keyword whole destructor KEYWORD_OTHER
    keyword whole dispid KEYWORD_OTHER
    keyword whole dispinterface STORAGE_TYPE_CLASS
    keyword whole dispose SUPPORT_FUNCTION
    keyword whole div KEYWORD_OPERATOR_WORD
    keyword whole do KEYWORD_CONTROL
    keyword whole downto KEYWORD_CONTROL
    keyword whole dynamic STORAGE_MODIFIER
    keyword whole else KEYWORD_CONTROL
    keyword whole end KEYWORD_CONTROL
    keyword whole except KEYWORD_CONTROL
    keyword whole exit KEYWORD_CONTROL
    keyword whole export KEYWORD_CONTROL_IMPORT
    keyword whole exports KEYWORD_CONTROL_IMPORT
    keyword whole external STORAGE_MODIFIER
    keyword whole fail KEYWORD_CONTROL
    keyword whole far STORAGE_MODIFIER
    keyword whole false CONSTANT_LANGUAGE
    keyword whole file STORAGE_TYPE
    keyword whole finalisation KEYWORD_OTHER
    keyword whole finally KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole forward STORAGE_MODIFIER
    keyword whole function STORAGE_TYPE_FUNCTION
    keyword whole goto KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole implementation KEYWORD_OTHER
    keyword whole in KEYWORD_OPERATOR_WORD
    keyword whole inherited KEYWORD_OTHER
    keyword whole initialization KEYWORD_OTHER
    keyword whole inline STORAGE_MODIFIER
    keyword whole interface KEYWORD_OTHER
    keyword whole interrupt STORAGE_MODIFIER
    keyword whole is KEYWORD_OPERATOR_WORD
    keyword whole label KEYWORD_OTHER
    keyword whole library KEYWORD_OTHER
    keyword whole mod KEYWORD_OPERATOR_WORD
    keyword whole near STORAGE_MODIFIER
    keyword whole new KEYWORD_OTHER
    keyword whole nil CONSTANT_LANGUAGE
    keyword whole not KEYWORD_OPERATOR_WORD
    keyword whole object STORAGE_TYPE_CLASS
    keyword whole of KEYWORD_OTHER
    keyword whole on KEYWORD_OTHER
    keyword whole operator KEYWORD_OTHER
    keyword whole or KEYWORD_OPERATOR_WORD
    keyword whole otherwise KEYWORD_CONTROL
    keyword whole overload STORAGE_MODIFIER
    keyword whole override STORAGE_MODIFIER
    keyword whole packed STORAGE_MODIFIER
    keyword whole pascal STORAGE_MODIFIER
    keyword whole private STORAGE_MODIFIER
    keyword whole procedure STORAGE_TYPE_FUNCTION
    keyword whole program KEYWORD_OTHER
    keyword whole property KEYWORD_OTHER
    keyword whole protected STORAGE_MODIFIER
    keyword whole public STORAGE_MODIFIER
    keyword whole published STORAGE_MODIFIER
    keyword whole raise KEYWORD_CONTROL
    keyword whole read KEYWORD_OTHER
    keyword whole readonly STORAGE_MODIFIER
    keyword whole record STORAGE_TYPE_CLASS
    keyword whole register STORAGE_MODIFIER
    keyword whole repeat KEYWORD_CONTROL
    keyword whole safecall STORAGE_MODIFIER
    keyword whole self VARIABLE_LANGUAGE
    keyword whole set STORAGE_TYPE
    keyword whole shl KEYWORD_OPERATOR_WORD
    keyword whole shr KEYWORD_OPERATOR_WORD
    keyword whole stdcall STORAGE_MODIFIER
    keyword whole string STORAGE_TYPE
    keyword whole then KEYWORD_CONTROL
    keyword whole to KEYWORD_CONTROL
    keyword whole true CONSTANT_LANGUAGE
    keyword whole try KEYWORD_CONTROL
    keyword whole type STORAGE_TYPE
    keyword whole unit KEYWORD_OTHER
    keyword whole until KEYWORD_CONTROL
    keyword whole uses KEYWORD_CONTROL_IMPORT
    keyword whole var KEYWORD_OTHER
    keyword whole virtual STORAGE_MODIFIER
    keyword whole while KEYWORD_CONTROL
    keyword whole with KEYWORD_CONTROL
    keyword whole write KEYWORD_OTHER
    keyword whole writeln SUPPORT_FUNCTION
    keyword whole xor KEYWORD_OPERATOR_WORD
    keyword whole .. KEYWORD_OPERATOR

    keyword // COMMENT_LINE

    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword . PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
#    keyword {$*} brightred

context ' ' STRING_QUOTED_SINGLE
context exclusive // \n COMMENT_LINE
    keyword $+:*$ KEYWORD_OTHER green
context exclusive (\* \*) COMMENT_BLOCK
    keyword $+:*$ KEYWORD_OTHER green
context exclusive (\*\* \*) COMMENT_BLOCK_DOCUMENTATION black
    keyword $+:*$ KEYWORD_OTHER green
context {$ } META_PREPROCESSOR
context { } COMMENT_BLOCK
#    keyword \[ABCDEFGHIJKLMNOPQRSTUVWXYZ\]\[-\+\] brightgreen
#    keyword $* green
    keyword $+:*$ KEYWORD_OTHER green
    spellcheck
