    keyword whole regr_syy                                 SUPPORT_FUNCTION
    keyword whole histogram_numeric                        SUPPORT_FUNCTION
    keyword whole collect_set                              SUPPORT_FUNCTION
    keyword whole collect_list                             SUPPORT_FUNCTION
    keyword whole ntile                                    SUPPORT_FUNCTION

# Table-Generating Functions
    keyword whole explode                                  SUPPORT_FUNCTION
    keyword whole posexplode                               SUPPORT_FUNCTION
    keyword whole inline                                   SUPPORT_FUNCTION
    keyword whole stack                                    SUPPORT_FUNCTION
    keyword whole json_tuple                               SUPPORT_FUNCTION
    keyword whole parse_url                                SUPPORT_FUNCTION

# Window Functions
    keyword whole lead                                     SUPPORT_FUNCTION
    keyword whole lag                                      SUPPORT_FUNCTION
    keyword whole first_value                              SUPPORT_FUNCTION
    keyword whole last_value                               SUPPORT_FUNCTION
    keyword whole rank                                     SUPPORT_FUNCTION
    keyword whole row_number                               SUPPORT_FUNCTION
    keyword whole dense_rank                               SUPPORT_FUNCTION
    keyword whole cume_dist                                SUPPORT_FUNCTION
    keyword whole percent_rank                             SUPPORT_FUNCTION
    keyword whole ntile                                    SUPPORT_FUNCTION

# Variables
    # oozie variables
    keyword whole ${+}                                     VARIABLE_OTHER
    # hive variables
    keyword whole ${hiveconf:+}                            VARIABLE_OTHER


# Hive options
    keyword wholeright hive.+.+.+                          SUPPORT_CONSTANT
    keyword wholeright tez.+.+                             SUPPORT_CONSTANT
    keyword wholeright mapreduce.+.+                       SUPPORT_CONSTANT

# Literals
    # float
    keyword whole \[0123456789\]\{.\}\[0123456789\]                                           CONSTANT_NUMERIC
    # float e notation
    keyword whole \[0123456789\]\[.\]\[0123456789\]\{e\}\[\+-\]\{0123456789\}\[0123456789\]   CONSTANT_NUMERIC

    # tinyint
    keyword whole \{0123456789\}\[0123456789\]Y                CONSTANT_NUMERIC
    # smallint
    keyword whole \{0123456789\}\[0123456789\]S                CONSTANT_NUMERIC
    # bigint
    keyword whole \{0123456789\}\[0123456789\]L                CONSTANT_NUMERIC
    # int
    keyword whole \{0123456789\}\[0123456789\]                 CONSTANT_NUMERIC
    # big decimal
    keyword whole \{0123456789\}\[0123456789\]BD               CONSTANT_NUMERIC

context exclusive -- \n COMMENT_LINE
    spellcheck

context exclusive /\* \*/ COMMENT_BLOCK
    spellcheck

context ' ' STRING_QUOTED_SINGLE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    # oozie variables
    keyword whole ${+}                                         VARIABLE_OTHER
    # hive variables
    keyword whole ${hiveconf:+}                                VARIABLE_OTHER

context " " STRING_QUOTED_DOUBLE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
