#
# Lisp syntax highlighting
#
# Author: Mykolas Juraitis (juramyko@soften.ktu.lt)
# Version: 6 Aug, 2002
#

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-*0123456789

context default
    keyword whole apply SUPPORT_FUNCTION
    keyword whole and KEYWORD_OPERATOR_WORD
    keyword whole car SUPPORT_FUNCTION
    keyword whole caar SUPPORT_FUNCTION
    keyword whole cadr SUPPORT_FUNCTION
    keyword whole cdar SUPPORT_FUNCTION
    keyword whole cddr SUPPORT_FUNCTION
    keyword whole cdr SUPPORT_FUNCTION
    keyword whole close SUPPORT_FUNCTION
    keyword whole cond KEYWORD_CONTROL
    keyword whole cons SUPPORT_FUNCTION
    keyword whole count SUPPORT_FUNCTION
    keyword whole defvar KEYWORD_OTHER
    keyword whole defstruct KEYWORD_OTHER
    keyword whole defun STORAGE_TYPE_FUNCTION
    keyword whole do KEYWORD_CONTROL
    keyword whole eq SUPPORT_FUNCTION
    keyword whole eql SUPPORT_FUNCTION
    keyword whole equal SUPPORT_FUNCTION
    keyword whole eval SUPPORT_FUNCTION
    keyword whole format SUPPORT_FUNCTION
    keyword whole if KEYWORD_CONTROL
    keyword whole let* KEYWORD_OTHER
    keyword whole let KEYWORD_OTHER
    keyword whole list SUPPORT_FUNCTION
    keyword whole load SUPPORT_FUNCTION
    keyword whole make-package SUPPORT_FUNCTION
    keyword whole mapcar SUPPORT_FUNCTION
    keyword whole not KEYWORD_OPERATOR_WORD
    keyword whole null SUPPORT_FUNCTION
    keyword whole numberp SUPPORT_FUNCTION
    keyword whole open SUPPORT_FUNCTION
    keyword whole or KEYWORD_OPERATOR_WORD
    keyword whole pprint SUPPORT_FUNCTION
    keyword whole prin1 SUPPORT_FUNCTION
    keyword whole princ SUPPORT_FUNCTION
    keyword whole print SUPPORT_FUNCTION
    keyword whole provide SUPPORT_FUNCTION
    keyword whole read SUPPORT_FUNCTION
    keyword whole require SUPPORT_FUNCTION
    keyword whole set SUPPORT_FUNCTION
    keyword whole setf KEYWORD_OTHER
    keyword whole setq KEYWORD_OTHER
    keyword whole slot-value SUPPORT_FUNCTION
    keyword whole sort SUPPORT_FUNCTION
    keyword whole stringp SUPPORT_FUNCTION
    keyword whole terpri SUPPORT_FUNCTION
    keyword whole write SUPPORT_FUNCTION

    keyword whole lambda KEYWORD_OTHER
    keyword whole nil CONSTANT_LANGUAGE
    keyword whole t CONSTANT_LANGUAGE

    keyword #' KEYWORD_OPERATOR
    keyword ' KEYWORD_OPERATOR
    keyword , PUNCTUATION_SEPARATOR

    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION

# Keyword declarations and keywords

    keyword :\[ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_-*0123456789\] CONSTANT_OTHER
    keyword &\[ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_-*0123456789\] KEYWORD_OTHER

# Comments

context ; \n COMMENT_LINE

# Strings

context " " STRING_QUOTED_DOUBLE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
