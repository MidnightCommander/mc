context default
    keyword whole linestart #*procmail\n COMMENT_LINE black
    keyword whole #*\n COMMENT_LINE

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._

##############################################################
