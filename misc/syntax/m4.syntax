#
# M4 Macroprocessor/Autoconf syntax highlighting
# for MC Editor/CoolEdit
#
# Author: Vlad Romanenko <VladRomanenko@ukr.net>
#
# 2002-09-19  Vlad Romanenko <VladRomanenko@ukr.net>
#    * Initial public release.
#

context default

    #=========================
    # Built-in macros with mandatory parameters
    keyword whole builtin SUPPORT_FUNCTION
    keyword whole decr SUPPORT_FUNCTION
    keyword whole define SUPPORT_FUNCTION
    keyword whole defn SUPPORT_FUNCTION
    keyword whole esyscmd SUPPORT_FUNCTION
    keyword whole eval SUPPORT_FUNCTION
    keyword whole format SUPPORT_FUNCTION
    keyword whole ifdef KEYWORD_CONTROL
    keyword whole ifelse KEYWORD_CONTROL
    keyword whole include KEYWORD_CONTROL_IMPORT
    keyword whole incr SUPPORT_FUNCTION
    keyword whole index SUPPORT_FUNCTION
    keyword whole len SUPPORT_FUNCTION
    keyword whole maketemp SUPPORT_FUNCTION
    keyword whole patsubst SUPPORT_FUNCTION
    keyword whole popdef SUPPORT_FUNCTION
    keyword whole pushdef SUPPORT_FUNCTION
    keyword whole regexp SUPPORT_FUNCTION
    keyword whole sinclude KEYWORD_CONTROL_IMPORT
    keyword whole substr SUPPORT_FUNCTION
    keyword whole syscmd SUPPORT_FUNCTION
    keyword whole translit SUPPORT_FUNCTION
    keyword whole undefine SUPPORT_FUNCTION

    #=========================
    # Built-in macros with optional parameters
    keyword whole changecom SUPPORT_FUNCTION
    keyword whole changequote SUPPORT_FUNCTION
    keyword whole debugfile SUPPORT_FUNCTION
    keyword whole debugmode SUPPORT_FUNCTION
    keyword whole divert SUPPORT_FUNCTION
    keyword whole divnum SUPPORT_FUNCTION
    keyword whole dumpdef SUPPORT_FUNCTION
    keyword whole errprint SUPPORT_FUNCTION
    keyword whole indir SUPPORT_FUNCTION
    keyword whole m4exit SUPPORT_FUNCTION
    keyword whole m4wrap SUPPORT_FUNCTION
    keyword whole shift SUPPORT_FUNCTION
    keyword whole sysval SUPPORT_FUNCTION
    keyword whole traceoff SUPPORT_FUNCTION
    keyword whole traceon SUPPORT_FUNCTION
    keyword whole undivert SUPPORT_FUNCTION

    #=========================
    # Autoconf and Automake macros
    keyword whole AC_\[ABCDEFGHIJKLMNOPQRSTUVWXYZ_\] SUPPORT_FUNCTION
    keyword whole AS_\[ABCDEFGHIJKLMNOPQRSTUVWXYZ_\] SUPPORT_FUNCTION
    keyword whole AM_\[ABCDEFGHIJKLMNOPQRSTUVWXYZ_\] SUPPORT_FUNCTION

    #=========================
    # Variables
    keyword whole __file__ CONSTANT_OTHER
    keyword whole __gnu__ CONSTANT_OTHER
    keyword whole __line__ CONSTANT_OTHER
    keyword whole __unix__ CONSTANT_OTHER
    keyword wholeright $\{0123456789\}\[0123456789\] VARIABLE_PARAMETER
    keyword wholeright $\{@\*#\} VARIABLE_PARAMETER

    #=========================
    # Special symbols
    keyword ` STRING_QUOTED_OTHER
    keyword ' STRING_QUOTED_OTHER
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION


#=============================
# Comments

context # \n COMMENT_LINE
    spellcheck
    keyword whole BUG KEYWORD_OTHER_TODO
    keyword whole FixMe KEYWORD_OTHER_TODO
    keyword whole FIXME KEYWORD_OTHER_TODO
    keyword whole Note KEYWORD_OTHER_TODO
    keyword whole NOTE KEYWORD_OTHER_TODO
    keyword whole ToDo KEYWORD_OTHER_TODO
    keyword whole TODO KEYWORD_OTHER_TODO
    keyword !!\[!\] KEYWORD_OTHER_TODO
    keyword ??\[?\] KEYWORD_OTHER_TODO


context dnl \n COMMENT_LINE
    spellcheck
    keyword whole BUG KEYWORD_OTHER_TODO
    keyword whole FixMe KEYWORD_OTHER_TODO
    keyword whole FIXME KEYWORD_OTHER_TODO
    keyword whole Note KEYWORD_OTHER_TODO
    keyword whole NOTE KEYWORD_OTHER_TODO
    keyword whole ToDo KEYWORD_OTHER_TODO
    keyword whole TODO KEYWORD_OTHER_TODO
    keyword !!\[!\] KEYWORD_OTHER_TODO
    keyword ??\[?\] KEYWORD_OTHER_TODO
