# Puppet syntax file for GNU Midnight Commander
# Authors: Sergey Zhuga <sergey.zhuga@gmail.com>
#          Phil Friderici <phil.friderici@i-tee.de>

context default

# Operators

  keyword =>  KEYWORD_OPERATOR
  keyword !=  KEYWORD_OPERATOR
  keyword \+= KEYWORD_OPERATOR
  keyword \+> KEYWORD_OPERATOR
  keyword ->  KEYWORD_OPERATOR
  keyword ~>  KEYWORD_OPERATOR
  keyword <-  KEYWORD_OPERATOR
  keyword <~  KEYWORD_OPERATOR
  keyword =   KEYWORD_OPERATOR

# Exported/Virtual Resources & Collectors

  keyword @   KEYWORD_OPERATOR
  keyword |>  KEYWORD_OPERATOR
  keyword |>> KEYWORD_OPERATOR
  keyword <<| KEYWORD_OPERATOR
  keyword <|  KEYWORD_OPERATOR

# Braces

  keyword { PUNCTUATION_SECTION
  keyword } PUNCTUATION_SECTION
  keyword ( PUNCTUATION_SECTION
  keyword ) PUNCTUATION_SECTION
  keyword [ PUNCTUATION_SECTION
  keyword ] PUNCTUATION_SECTION
  keyword , PUNCTUATION_SEPARATOR
  keyword : PUNCTUATION_SEPARATOR

# Booleans

  keyword whole false CONSTANT_LANGUAGE
  keyword whole FALSE CONSTANT_LANGUAGE
  keyword whole nil   CONSTANT_LANGUAGE
  keyword whole NIL   CONSTANT_LANGUAGE
  keyword whole undef CONSTANT_LANGUAGE
  keyword whole UNDEF CONSTANT_LANGUAGE
  keyword whole true  CONSTANT_LANGUAGE
  keyword whole TRUE  CONSTANT_LANGUAGE

# Variables

  keyword wholeright $+\:\:+\:\:+\:\:+\:\:+ VARIABLE_OTHER
  keyword wholeright $+\:\:+\:\:+\:\:+ VARIABLE_OTHER
  keyword wholeright $+\:\:+\:\:+ VARIABLE_OTHER
  keyword wholeright $+\:\:+ VARIABLE_OTHER
  keyword wholeright $+ VARIABLE_OTHER

