context # \n COMMENT_LINE
    spellcheck

context ' ' STRING_QUOTED_SINGLE

# Basic support for heredocs with suppressed variable expansion: 'exclusive' keyword breaks the matching due
# to a conflict with the rules for quotes, so remove it in all cases, including `\`, for consistency.
wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'"\\
context whole <<\[\s\]\[-\]\[\s\]\\EOF EOF STRING_QUOTED_OTHER
context whole <<\[\s\]\[-\]\[\s\]\\END END STRING_QUOTED_OTHER
context whole <<\[\s\]\[-\]\[\s\]'EOF' EOF STRING_QUOTED_OTHER
context whole <<\[\s\]\[-\]\[\s\]'END' END STRING_QUOTED_OTHER
context whole <<\[\s\]\[-\]\[\s\]"EOF" EOF STRING_QUOTED_OTHER
context whole <<\[\s\]\[-\]\[\s\]"END" END STRING_QUOTED_OTHER
wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_

context " " STRING_QUOTED_DOUBLE
    keyword \\* CONSTANT_CHARACTER_ESCAPE
    keyword \\@ CONSTANT_CHARACTER_ESCAPE
    keyword \\$ CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\` CONSTANT_CHARACTER_ESCAPE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword $(*) VARIABLE_OTHER
    keyword ${*} VARIABLE_OTHER
    keyword $\* VARIABLE_OTHER
    keyword $@ VARIABLE_OTHER
    keyword $# VARIABLE_OTHER
    keyword $? VARIABLE_OTHER
    keyword $- VARIABLE_OTHER
    keyword $$ VARIABLE_OTHER
    keyword $! VARIABLE_OTHER
    keyword $_ VARIABLE_OTHER
    keyword wholeright $\[0123456789\] VARIABLE_OTHER

    keyword wholeright $+ VARIABLE_OTHER

    keyword $ VARIABLE_OTHER

# Basic support for heredocs with variable expansion
context exclusive whole <<\[\s\]\[-\]\[\s\]EOF EOF STRING_QUOTED_OTHER
    keyword \\* CONSTANT_CHARACTER_ESCAPE
