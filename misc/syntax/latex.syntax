context default
wholechars left \\
wholechars right abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ

    spellcheck

    keyword whole {\\it KEYWORD_OTHER
    keyword } PUNCTUATION_SECTION
    keyword whole {\\bf KEYWORD_OTHER
    keyword } PUNCTUATION_SECTION
    keyword { PUNCTUATION_SECTION

    keyword \\$ CONSTANT_CHARACTER_ESCAPE

# type style
    keyword whole \\tiny KEYWORD_OTHER
    keyword whole \\scriptsize KEYWORD_OTHER
    keyword whole \\footnotesize KEYWORD_OTHER
    keyword whole \\small KEYWORD_OTHER
    keyword whole \\normalsize KEYWORD_OTHER
    keyword whole \\large KEYWORD_OTHER
    keyword whole \\Large KEYWORD_OTHER
    keyword whole \\LARGE KEYWORD_OTHER
    keyword whole \\huge KEYWORD_OTHER
    keyword whole \\Huge KEYWORD_OTHER

# accents and symbols
    keyword whole \\\{`'^"~=.uvHtcdb\}{\{aeiouAEIOU\}} KEYWORD_OTHER
    keyword whole \\dag CONSTANT_OTHER
    keyword whole \\ddag CONSTANT_OTHER
    keyword whole \\S CONSTANT_OTHER
    keyword whole \\P CONSTANT_OTHER
    keyword whole \\copyright CONSTANT_OTHER
    keyword whole \\pounds CONSTANT_OTHER

# sectioning and table of contents
    keyword whole \\part[*]{*} ENTITY_NAME_SECTION
    keyword whole \\part{*} ENTITY_NAME_SECTION
    keyword whole \\part\*{*} ENTITY_NAME_SECTION
    keyword whole \\chapter[*]{*} ENTITY_NAME_SECTION
    keyword whole \\chapter{*} ENTITY_NAME_SECTION
    keyword whole \\chapter\*{*} ENTITY_NAME_SECTION
    keyword whole \\section[*]{*} ENTITY_NAME_SECTION
    keyword whole \\section{*} ENTITY_NAME_SECTION
    keyword whole \\section\*{*} ENTITY_NAME_SECTION
    keyword whole \\subsection[*]{*} ENTITY_NAME_SECTION
    keyword whole \\subsection{*} ENTITY_NAME_SECTION
    keyword whole \\subsection\*{*} ENTITY_NAME_SECTION
    keyword whole \\subsubsection[*]{*} ENTITY_NAME_SECTION
    keyword whole \\subsubsection{*} ENTITY_NAME_SECTION
    keyword whole \\subsubsection\*{*} ENTITY_NAME_SECTION
    keyword whole \\paragraph[*]{*} ENTITY_NAME_SECTION
    keyword whole \\paragraph{*} ENTITY_NAME_SECTION
    keyword whole \\paragraph\*{*} ENTITY_NAME_SECTION
    keyword whole \\subparagraph[*]{*} ENTITY_NAME_SECTION
    keyword whole \\subparagraph{*} ENTITY_NAME_SECTION
    keyword whole \\subparagraph\*{*} ENTITY_NAME_SECTION

    keyword whole \\appendix KEYWORD_OTHER
    keyword whole \\tableofcontents KEYWORD_OTHER

# misc
    keyword whole \\item[*] KEYWORD_OTHER
    keyword whole \\item KEYWORD_OTHER
    keyword whole \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\\s CONSTANT_CHARACTER_ESCAPE black
    keyword \\@ CONSTANT_CHARACTER_ESCAPE black
    keyword %% CONSTANT_CHARACTER_ESCAPE
    keyword \\% CONSTANT_CHARACTER_ESCAPE

# docuement and page styles
    keyword whole \\documentstyle[*]{*} KEYWORD_OTHER
    keyword whole \\documentstyle{*} KEYWORD_OTHER
    keyword whole \\pagestyle{*} KEYWORD_OTHER

# cross references
    keyword whole \\label{*} KEYWORD_OTHER
    keyword whole \\ref{*} KEYWORD_OTHER

# bibliography and citations
    keyword whole \\bibliography{*} KEYWORD_OTHER
    keyword whole \\bibitem[*]{*} KEYWORD_OTHER
    keyword whole \\bibitem{*} KEYWORD_OTHER
    keyword whole \\cite[*]{*} KEYWORD_OTHER
    keyword whole \\cite{*} KEYWORD_OTHER

# splitting the input
    keyword whole \\input{*} KEYWORD_CONTROL_IMPORT
    keyword whole \\include{*} KEYWORD_CONTROL_IMPORT
    keyword whole \\includeonly{*} KEYWORD_CONTROL_IMPORT

# line breaking
    keyword whole \\linebreak[\[01234\]] KEYWORD_OTHER
    keyword whole \\nolinebreak[\[01234\]] KEYWORD_OTHER
    keyword whole \\linebreak KEYWORD_OTHER
    keyword whole \\nolinebreak KEYWORD_OTHER
    keyword whole \\[+] KEYWORD_OTHER
    keyword whole \\- KEYWORD_OTHER
    keyword whole \\sloppy KEYWORD_OTHER

# page breaking
    keyword whole \\pagebreak[\[01234\]] KEYWORD_OTHER
    keyword whole \\nopagebreak[\[01234\]] KEYWORD_OTHER
    keyword whole \\pagebreak KEYWORD_OTHER
    keyword whole \\nopagebreak KEYWORD_OTHER
    keyword whole \\samepage KEYWORD_OTHER
    keyword whole \\newpage KEYWORD_OTHER
    keyword whole \\clearpage KEYWORD_OTHER

# definitions
    keyword \\newcommand{*}[*] KEYWORD_OTHER
    keyword \\newcommand{*} KEYWORD_OTHER
    keyword \\newenvironment{*}[*]{*} KEYWORD_OTHER
    keyword \\newenvironment{*}{*} KEYWORD_OTHER

# boxes

# begins and ends
    keyword \\begin{document} KEYWORD_CONTROL
    keyword \\begin{equation} KEYWORD_CONTROL
    keyword \\begin{displaymath} KEYWORD_CONTROL
    keyword \\begin{eqnarray} KEYWORD_CONTROL
    keyword \\begin{quote} KEYWORD_CONTROL
    keyword \\begin{quotation} KEYWORD_CONTROL
    keyword \\begin{center} KEYWORD_CONTROL
    keyword \\begin{verse} KEYWORD_CONTROL
    keyword \\begin{verbatim} KEYWORD_CONTROL
    keyword \\begin{itemize} KEYWORD_CONTROL
    keyword \\begin{enumerate} KEYWORD_CONTROL
    keyword \\begin{description} KEYWORD_CONTROL
    keyword \\begin{list} KEYWORD_CONTROL
    keyword \\begin{array} KEYWORD_CONTROL
    keyword \\begin{tabular} KEYWORD_CONTROL
    keyword \\begin{thebibliography}{*} KEYWORD_CONTROL
    keyword \\begin{sloppypar} KEYWORD_CONTROL

    keyword \\end{document} KEYWORD_CONTROL
    keyword \\end{equation} KEYWORD_CONTROL
    keyword \\end{displaymath} KEYWORD_CONTROL
    keyword \\end{eqnarray} KEYWORD_CONTROL
    keyword \\end{quote} KEYWORD_CONTROL
    keyword \\end{quotation} KEYWORD_CONTROL
    keyword \\end{center} KEYWORD_CONTROL
    keyword \\end{verse} KEYWORD_CONTROL
    keyword \\end{verbatim} KEYWORD_CONTROL
    keyword \\end{itemize} KEYWORD_CONTROL
    keyword \\end{enumerate} KEYWORD_CONTROL
    keyword \\end{description} KEYWORD_CONTROL
    keyword \\end{list} KEYWORD_CONTROL
    keyword \\end{array} KEYWORD_CONTROL
    keyword \\end{tabular} KEYWORD_CONTROL
    keyword \\end{thebibliography}{*} KEYWORD_CONTROL
    keyword \\end{sloppypar} KEYWORD_CONTROL

    keyword \\begin{*} KEYWORD_CONTROL
    keyword \\end{*} KEYWORD_CONTROL

    keyword \\theorem{*}{*} KEYWORD_OTHER

# if all else fails
    keyword whole \\begin KEYWORD_CONTROL
    keyword whole \\+[*][*]{*}{*}{*} KEYWORD_OTHER
    keyword whole \\+[*][*]{*}{*} KEYWORD_OTHER
    keyword whole \\+[*]{*}{*}{*} KEYWORD_OTHER
    keyword whole \\+[*]{*}{*} KEYWORD_OTHER
    keyword whole \\+[*]{*} KEYWORD_OTHER
    keyword whole \\+{*}{*}{*}{*} KEYWORD_OTHER
    keyword whole \\+{*}{*}{*} KEYWORD_OTHER
    keyword whole \\+{*}{*} KEYWORD_OTHER
    keyword whole \\+{*} KEYWORD_OTHER
    keyword whole \\+ KEYWORD_OTHER

