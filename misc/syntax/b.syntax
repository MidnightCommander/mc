# B language keywords
# by Gyorgy Rotter
#
# For the proper syntax highlight the order of the keywords are
# important. This is why the related keywords are not listed in a block.
# To create semantic relationship between the keywords I used groups.
# Some keywords are in a group (the name of the group is
# indicated in a commented line above the keyword definition)
#
# With the one-liner for example we could replace
# the color of the keywords which are the members of the
# "Sequences" group from "yellow" to "red"...
#
#  echo Sequences yellow red | xargs -l bash -c 'sed -z "s/\(# $0\n[^\n]*\)$1/\1$2/g" b.syntax'
#         ^         ^     ^
#         |         |     |
#         |         |     -- new_color
#         |         -- actual_color
#         -- groupname
#
#
# Usable groups:
#   Relations, Sequences, Logical, Arithmetic, Sets, Substitutions
#
# Usable colors:
#   described in the Syntax file
#

context default
    keyword whole ABSTRACT_CONSTANTS KEYWORD_OTHER_RESERVED
    keyword whole ABSTRACT_VARIABLES KEYWORD_OTHER_RESERVED
    keyword whole CONCRETE_CONSTANTS KEYWORD_OTHER_RESERVED
    keyword whole CONCRETE_VARIABLES KEYWORD_OTHER_RESERVED
    keyword whole LOCAL_OPERATIONS KEYWORD_OTHER_RESERVED
    keyword whole IMPLEMENTATION KEYWORD_OTHER_RESERVED
    keyword whole INITIALISATION KEYWORD_OTHER_RESERVED
    keyword whole CONSTRAINTS KEYWORD_OTHER_RESERVED
    keyword whole DEFINITIONS KEYWORD_OTHER_RESERVED
    keyword whole ASSERTIONS KEYWORD_OTHER_RESERVED
    keyword whole OPERATIONS KEYWORD_OTHER_RESERVED
    keyword whole PROPERTIES KEYWORD_OTHER_RESERVED
    keyword whole REFINEMENT KEYWORD_OTHER_RESERVED
    keyword whole CONSTANTS KEYWORD_OTHER_RESERVED
    keyword whole INVARIANT KEYWORD_OTHER_RESERVED
    keyword whole sequences SUPPORT_FUNCTION
    keyword whole VARIABLES KEYWORD_OTHER_RESERVED
    keyword whole Cardinal KEYWORD_OTHER_RESERVED

    # Relations
    keyword whole closure1 SUPPORT_FUNCTION

    keyword whole INCLUDES KEYWORD_OTHER_RESERVED

    # Arithmetic
    keyword whole NATURAL1 KEYWORD_OTHER_RESERVED

    keyword whole PROMOTES KEYWORD_OTHER_RESERVED
    keyword whole Boolean KEYWORD_OTHER_RESERVED
    keyword whole EXTENDS KEYWORD_OTHER_RESERVED
    keyword whole IMPORTS KEYWORD_OTHER_RESERVED

    # Arithmetic
    keyword whole INTEGER KEYWORD_OTHER_RESERVED

    keyword whole iterate SUPPORT_FUNCTION
    keyword whole MACHINE KEYWORD_OTHER_RESERVED

    # Arithmetic
    keyword whole NATURAL KEYWORD_OTHER_RESERVED

    keyword whole postfix SUPPORT_FUNCTION
    keyword whole REFINES KEYWORD_OTHER_RESERVED
    keyword whole subtree SUPPORT_FUNCTION
    keyword whole VARIANT KEYWORD_OTHER_RESERVED
    keyword whole ASSERT KEYWORD_OTHER_RESERVED
    keyword whole CHOICE KEYWORD_OTHER_RESERVED

    # Relations
    keyword whole closure SUPPORT_FUNCTION

    keyword whole EITHER KEYWORD_OTHER_RESERVED
    keyword whole father SUPPORT_FUNCTION
    keyword whole MAXINT KEYWORD_OTHER_RESERVED
    keyword whole MININT KEYWORD_OTHER_RESERVED
    keyword whole mirror SUPPORT_FUNCTION
    keyword whole modulo SUPPORT_FUNCTION
    keyword whole prefix SUPPORT_FUNCTION
    keyword whole SELECT KEYWORD_OTHER_RESERVED
    keyword whole STRING KEYWORD_OTHER_RESERVED
    keyword whole struct SUPPORT_FUNCTION
    keyword whole VALUES KEYWORD_OTHER_RESERVED
    keyword whole arity KEYWORD_OTHER_RESERVED
    keyword whole BEGIN KEYWORD_OTHER_RESERVED
    keyword whole btree SUPPORT_FUNCTION
    keyword whole const KEYWORD_OTHER_RESERVED
    keyword whole ELSIF KEYWORD_OTHER_RESERVED
    keyword whole FALSE KEYWORD_OTHER_RESERVED
    keyword whole first SUPPORT_FUNCTION
    keyword whole front SUPPORT_FUNCTION
    keyword whole infix KEYWORD_OTHER_RESERVED

    # Sets
    keyword whole INTER KEYWORD_OTHER_RESERVED

    keyword whole inter KEYWORD_OTHER_RESERVED
    keyword whole iseq1 KEYWORD_OTHER_RESERVED
    keyword whole right SUPPORT_FUNCTION

    # Arithmetic
    keyword whole SIGMA KEYWORD_OTHER_RESERVED

    keyword whole sizet KEYWORD_OTHER_RESERVED

    # Sets
    keyword whole UNION KEYWORD_OTHER_RESERVED

    keyword whole union KEYWORD_OTHER_RESERVED
    keyword whole WHERE KEYWORD_OTHER_RESERVED
    keyword whole WHILE KEYWORD_OTHER_RESERVED
    keyword whole bool KEYWORD_OTHER_RESERVED
    keyword whole BOOL KEYWORD_OTHER_RESERVED
    keyword whole card KEYWORD_OTHER_RESERVED
    keyword whole CASE KEYWORD_OTHER_RESERVED
    keyword whole conc KEYWORD_OTHER_RESERVED
    keyword whole ELSE KEYWORD_OTHER_RESERVED

    # Sets
    keyword whole FIN1 KEYWORD_OTHER_RESERVED

    keyword whole iseq KEYWORD_OTHER_RESERVED
    keyword whole last SUPPORT_FUNCTION
    keyword whole left SUPPORT_FUNCTION
    keyword whole NAT1 KEYWORD_OTHER_RESERVED

    # Sets
    keyword whole POW1 KEYWORD_OTHER_RESERVED

    keyword whole perm SUPPORT_FUNCTION
    keyword whole pred KEYWORD_OTHER_RESERVED
    keyword whole prj1 KEYWORD_OTHER_RESERVED
    keyword whole prj2 KEYWORD_OTHER_RESERVED
    keyword whole rank KEYWORD_OTHER_RESERVED
    keyword whole SEES KEYWORD_OTHER_RESERVED
    keyword whole seq1 KEYWORD_OTHER_RESERVED
    keyword whole SETS KEYWORD_OTHER_RESERVED
    keyword whole size SUPPORT_FUNCTION
    keyword whole skip KEYWORD_OTHER_RESERVED
    keyword whole sons KEYWORD_OTHER_RESERVED
    keyword whole succ KEYWORD_OTHER_RESERVED
    keyword whole tail KEYWORD_OTHER_RESERVED
    keyword whole THEN KEYWORD_OTHER_RESERVED
    keyword whole tree KEYWORD_OTHER_RESERVED
    keyword whole TRUE KEYWORD_OTHER_RESERVED
    keyword whole USES KEYWORD_OTHER_RESERVED
    keyword whole WHEN KEYWORD_OTHER_RESERVED
    keyword whole ANY KEYWORD_OTHER_RESERVED
    keyword whole bin KEYWORD_OTHER_RESERVED
    keyword whole dom KEYWORD_OTHER_RESERVED
    keyword whole END KEYWORD_OTHER_RESERVED

    # Sets
    keyword whole FIN KEYWORD_OTHER_RESERVED

    keyword whole fnc KEYWORD_OTHER_RESERVED
    keyword whole INT KEYWORD_OTHER_RESERVED
    keyword whole LET KEYWORD_OTHER_RESERVED
    keyword whole max KEYWORD_OTHER_RESERVED
    keyword whole min KEYWORD_OTHER_RESERVED
    keyword whole mod KEYWORD_OTHER_RESERVED
    keyword whole NAT KEYWORD_OTHER_RESERVED

    # Logical
    keyword whole not KEYWORD_OPERATOR_WORD

    # Sets
    keyword whole POW KEYWORD_OTHER_RESERVED

    keyword whole PRE KEYWORD_OTHER_RESERVED
    keyword whole ran KEYWORD_OTHER_RESERVED
    keyword whole rec KEYWORD_OTHER_RESERVED
    keyword whole rel KEYWORD_OTHER_RESERVED
    keyword whole rev KEYWORD_OTHER_RESERVED
    keyword whole seq KEYWORD_OTHER_RESERVED
    keyword whole Set KEYWORD_OTHER_RESERVED
    keyword whole son KEYWORD_OTHER_RESERVED
    keyword whole top KEYWORD_OTHER_RESERVED
    keyword whole VAR KEYWORD_OTHER_RESERVED
    keyword whole BE KEYWORD_OTHER_RESERVED
    keyword whole DO KEYWORD_OTHER_RESERVED
    keyword whole id KEYWORD_OTHER_RESERVED
    keyword whole IF KEYWORD_OTHER_RESERVED
    keyword whole IN KEYWORD_OTHER_RESERVED
    keyword whole OF KEYWORD_OTHER_RESERVED
    keyword whole OR KEYWORD_OTHER_RESERVED

    # Logical
    keyword whole or KEYWORD_OPERATOR_WORD

    # Arithmetic
    keyword whole PI KEYWORD_OTHER_RESERVED

# prevents - keyword from interfering with comment
    keyword /\* COMMENT_BLOCK
    keyword \*/ COMMENT_BLOCK
    keyword // COMMENT_LINE


    keyword <-- KEYWORD_OTHER_RESERVED
    keyword := KEYWORD_OTHER_RESERVED


    # Relations
    keyword \+->> KEYWORD_OPERATOR

    # Relations
    keyword -->> KEYWORD_OPERATOR

    # Sets
    keyword /<<: KEYWORD_OTHER_RESERVED

    # Sequences
    keyword /|\\ KEYWORD_OPERATOR

    # Relations
    keyword >->> KEYWORD_OPERATOR

    # Relations
    keyword >\+> KEYWORD_OPERATOR

    # Arithmetic
    keyword \*\* KEYWORD_OTHER_RESERVED

    # Relations
    keyword \+-> KEYWORD_OPERATOR

    # Sequences
    keyword \\|/ KEYWORD_OPERATOR

    # Relations
    keyword --> KEYWORD_OPERATOR

    # Sets
    keyword /<: KEYWORD_OTHER_RESERVED

    # Sets
    keyword /\\ KEYWORD_OTHER_RESERVED

    # Relations
    keyword <-> KEYWORD_OPERATOR

    # Sets
    keyword <<: KEYWORD_OTHER_RESERVED

    # Relations
    keyword <<| KEYWORD_OPERATOR

    # Logical
    keyword <=> KEYWORD_OPERATOR

    # Relations
    keyword <\+ KEYWORD_OPERATOR

    # Relations
    keyword >-> KEYWORD_OPERATOR

    # Sets
    keyword \\/ KEYWORD_OTHER_RESERVED

    # Relations
    keyword |-> KEYWORD_OPERATOR

    # Relations
    keyword |>> KEYWORD_OPERATOR

    keyword != KEYWORD_OTHER_RESERVED

    # Sequences
    keyword -> KEYWORD_OPERATOR

    # Sets
    keyword /: KEYWORD_OTHER_RESERVED

    # Logical
    keyword /= KEYWORD_OPERATOR

    # Substitutions
    keyword :: KEYWORD_OTHER_RESERVED

    # Sequences
    keyword <- KEYWORD_OPERATOR

    # Sets
    keyword <: KEYWORD_OTHER_RESERVED

    # Arithmetic
    keyword <= KEYWORD_OTHER_RESERVED

    # Relations
    keyword <| KEYWORD_OPERATOR

    keyword == KEYWORD_OTHER_RESERVED

    # Logical
    keyword => KEYWORD_OPERATOR

    # Relations
    keyword >< KEYWORD_OPERATOR

    # Arithmetic
    keyword >= KEYWORD_OTHER_RESERVED

    # Arithmetic
    keyword \* KEYWORD_OTHER_RESERVED

    # Arithmetic
    keyword \+ KEYWORD_OTHER_RESERVED

    # Sets
    keyword {} KEYWORD_OTHER_RESERVED

    # Relations
    keyword |> KEYWORD_OPERATOR

    # Logical
    keyword ! KEYWORD_OPERATOR

    # Logical
    keyword # KEYWORD_OPERATOR

    # Relations
    keyword % KEYWORD_OPERATOR

    # Logical
    keyword & KEYWORD_OPERATOR

    keyword ( KEYWORD_OTHER_RESERVED
    keyword ) KEYWORD_OTHER_RESERVED
    keyword , KEYWORD_OTHER_RESERVED

    # Arithmetic
    keyword - KEYWORD_OTHER_RESERVED

    # Arithmetic
    keyword / KEYWORD_OTHER_RESERVED

    # Sets
    keyword : KEYWORD_OTHER_RESERVED

    keyword ; KEYWORD_OTHER_RESERVED

    # Arithmetic
    keyword < KEYWORD_OTHER_RESERVED

    # Logical
    keyword = KEYWORD_OPERATOR

    # Arithmetic
    keyword > KEYWORD_OTHER_RESERVED

    keyword ? KEYWORD_OTHER_RESERVED
    keyword [ KEYWORD_OTHER_RESERVED
    keyword ] KEYWORD_OTHER_RESERVED

    # Sequences
    keyword ^ KEYWORD_OPERATOR

    keyword { KEYWORD_OTHER_RESERVED
    keyword } KEYWORD_OTHER_RESERVED

    keyword | KEYWORD_OTHER_RESERVED

    # Relations
    keyword ~ KEYWORD_OPERATOR


context exclusive /\* \*/ COMMENT_BLOCK
    spellcheck

context exclusive // \n COMMENT_LINE
    spellcheck

context " "    STRING_QUOTED_DOUBLE
