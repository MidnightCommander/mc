# Cuda syntax file

# Authors:
#    Sergey Sharybin <sergey.vfx@gmail.com>
#
# Based on cxx.syntax file with some extra keywords to be
# highlighted,

context default
    keyword whole auto STORAGE_MODIFIER
    keyword whole break KEYWORD_CONTROL
    keyword whole case KEYWORD_CONTROL
    keyword whole char STORAGE_TYPE_PRIMITIVE
    keyword whole const STORAGE_MODIFIER
    keyword whole continue KEYWORD_CONTROL
    keyword whole default KEYWORD_CONTROL
    keyword whole do KEYWORD_CONTROL
    keyword whole double STORAGE_TYPE_PRIMITIVE
    keyword whole else KEYWORD_CONTROL
    keyword whole enum STORAGE_TYPE_CLASS
    keyword whole extern STORAGE_MODIFIER
    keyword whole float STORAGE_TYPE_PRIMITIVE
    keyword whole for KEYWORD_CONTROL
    keyword whole goto KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole int STORAGE_TYPE_PRIMITIVE
    keyword whole long STORAGE_TYPE_PRIMITIVE
    keyword whole register STORAGE_MODIFIER
    keyword whole return KEYWORD_CONTROL
    keyword whole short STORAGE_TYPE_PRIMITIVE
    keyword whole signed STORAGE_TYPE_PRIMITIVE
    keyword whole sizeof KEYWORD_OPERATOR_WORD
    keyword whole static STORAGE_MODIFIER
    keyword whole struct STORAGE_TYPE_CLASS
    keyword whole switch KEYWORD_CONTROL
    keyword whole typedef STORAGE_TYPE
    keyword whole union STORAGE_TYPE_CLASS
    keyword whole unsigned STORAGE_TYPE_PRIMITIVE
    keyword whole void STORAGE_TYPE_PRIMITIVE
    keyword whole volatile STORAGE_MODIFIER
    keyword whole while KEYWORD_CONTROL
    keyword whole asm KEYWORD_OTHER_RESERVED
    keyword whole catch KEYWORD_CONTROL
    keyword whole class STORAGE_TYPE_CLASS
    keyword whole friend STORAGE_MODIFIER
    keyword whole delete KEYWORD_OTHER_NEW
    keyword whole inline STORAGE_MODIFIER
    keyword whole new KEYWORD_OTHER_NEW
    keyword whole operator KEYWORD_OTHER_RESERVED
    keyword whole private STORAGE_MODIFIER
    keyword whole protected STORAGE_MODIFIER
    keyword whole public STORAGE_MODIFIER
    keyword whole this VARIABLE_LANGUAGE
    keyword whole throw KEYWORD_CONTROL
    keyword whole template KEYWORD_OTHER_RESERVED
    keyword whole try KEYWORD_CONTROL
    keyword whole virtual STORAGE_MODIFIER
    keyword whole bool STORAGE_TYPE_PRIMITIVE
    keyword whole const_cast KEYWORD_OTHER_RESERVED
    keyword whole dynamic_cast KEYWORD_OTHER_RESERVED
    keyword whole explicit STORAGE_MODIFIER
    keyword whole false CONSTANT_LANGUAGE
    keyword whole mutable STORAGE_MODIFIER
    keyword whole namespace KEYWORD_OTHER_RESERVED
    keyword whole reinterpret_cast KEYWORD_OTHER_RESERVED
    keyword whole static_cast KEYWORD_OTHER_RESERVED
    keyword whole true CONSTANT_LANGUAGE
    keyword whole typeid KEYWORD_OPERATOR_WORD
    keyword whole typename KEYWORD_OTHER_RESERVED
    keyword whole using KEYWORD_CONTROL_IMPORT
    keyword whole wchar_t STORAGE_TYPE_PRIMITIVE
    keyword whole ... PUNCTUATION_SEPARATOR
    keyword whole linestart \{\s\t\}\[\s\t\]#*\n META_PREPROCESSOR

# Function type qualifiers
    keyword whole __device__ STORAGE_MODIFIER
    keyword whole __global__ STORAGE_MODIFIER
    keyword whole __host__ STORAGE_MODIFIER

    keyword whole __noinline__ STORAGE_MODIFIER
    keyword whole __forceinline__ STORAGE_MODIFIER

# Variable type qualifiers
    keyword whole __constant__ STORAGE_MODIFIER
    keyword whole __shared__ STORAGE_MODIFIER
    keyword whole __managed__ STORAGE_MODIFIER
    keyword whole __restrict__ STORAGE_MODIFIER

# Built-in variables
    keyword whole threadIdx VARIABLE_LANGUAGE
    keyword whole blockIdx VARIABLE_LANGUAGE
    keyword whole blockDim VARIABLE_LANGUAGE
    keyword whole gridDim VARIABLE_LANGUAGE
    keyword whole warpSize VARIABLE_LANGUAGE

# Synchronization
    keyword whole __syncthreads SUPPORT_FUNCTION
    keyword whole __threadfence SUPPORT_FUNCTION

    keyword /\* COMMENT_BLOCK
    keyword \*/ COMMENT_BLOCK
    keyword // COMMENT_LINE

    keyword '\\\{"abtnvfr\}' CONSTANT_CHARACTER_ESCAPE
    keyword '\\\{0123\}\{01234567\}\{01234567\}' CONSTANT_CHARACTER_ESCAPE
    keyword '\\'' CONSTANT_CHARACTER_ESCAPE
    keyword '\\\\' CONSTANT_CHARACTER_ESCAPE
    keyword '\\0' CONSTANT_CHARACTER_ESCAPE
    keyword '\{\s!"#$%&()\*\+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~ ¡¢£¤¥¦§¨©ª«¬­®¯°±²³´µ¶·¸¹º»¼½¾¿ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ×ØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿ\}' CONSTANT_CHARACTER

    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword = KEYWORD_OPERATOR
    keyword != KEYWORD_OPERATOR
    keyword == KEYWORD_OPERATOR
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ? PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR

context exclusive /\* \*/ COMMENT_BLOCK
    spellcheck

context exclusive // \n COMMENT_LINE
    spellcheck

context linestart # \n META_PREPROCESSOR
    keyword \\\n CONSTANT_CHARACTER_ESCAPE
    keyword /\**\*/ COMMENT_BLOCK
    keyword //*\n COMMENT_LINE
    keyword "+" STRING_QUOTED_OTHER
    keyword <+> STRING_QUOTED_OTHER

context " " STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_OTHER_PLACEHOLDER
    keyword %\[#0\s-\+,\]\[0123456789\*\]\[.\]\[0123456789\*\]\[L\]\{eEfgGoxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[0\s-\+,\]\[0123456789\*\]\[.\]\[0123456789\*\]\[hl\]\{diuxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[hl\]n CONSTANT_OTHER_PLACEHOLDER
    keyword %\[-\]\[0123456789\*\]\[.\]\[0123456789\*\]s CONSTANT_OTHER_PLACEHOLDER
    keyword %[*] CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword %p CONSTANT_OTHER_PLACEHOLDER
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE
