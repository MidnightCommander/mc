# ---------------------------------------------------
# po.syntax
# GNU Gettext PO files syntax highlighting template.
# Syntax highlighting rules for files produced with
# Gettext tools as used in Midnight Commander and
# Cooledit editors.
#
# It highlights:
#   - Original and translated messages   (blue/green)
#   - Generic comments added by Gettext  (white)
#   - C-style format modifiers,
#      as in c.syntax                    (brightgreen)
#   - Messages marked as "fuzzy"         (brightred)
#   - Untranslated messages              (brightred)
#   - Unused messages                    (red)
#
# Author: David Martin <dmartina@excite.es>
# August 17, 2001
# ---------------------------------------------------

context default
    keyword linestart msgstr\s\"\"\n\n KEYWORD_OTHER_TODO
    keyword linestart msgid KEYWORD_OTHER
    keyword linestart msgstr KEYWORD_OTHER

context linestart #,\sfuzzy \n\n KEYWORD_OTHER_TODO

context linestart #: \n COMMENT_LINE

context linestart #, \n COMMENT_LINE
    keyword c-format KEYWORD_OTHER

context linestart #~ \n INVALID_DEPRECATED

context linestart # \n COMMENT_LINE
    spellcheck

context exclusive linestart msgid \n STRING_QUOTED_DOUBLE
    spellcheck
    keyword \"\n\"
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\n CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_OTHER_PLACEHOLDER
    keyword %\[#0\s-\+,\]\[0123456789\]\[.\]\[0123456789\]\[L\]\{eEfgG\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[0\s-\+,\]\[0123456789\]\[.\]\[0123456789\]\[hl\]\{diouxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[hl\]n CONSTANT_OTHER_PLACEHOLDER
    keyword %\[.\]\[0123456789\]s CONSTANT_OTHER_PLACEHOLDER
    keyword %[*] CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE

context exclusive linestart msgstr \n STRING_QUOTED_DOUBLE
    spellcheck
    keyword \"\n\"
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\n CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_OTHER_PLACEHOLDER
    keyword %\[#0\s-\+,\]\[0123456789\]\[.\]\[0123456789\]\[L\]\{eEfgG\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[0\s-\+,\]\[0123456789\]\[.\]\[0123456789\]\[hl\]\{diouxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[hl\]n CONSTANT_OTHER_PLACEHOLDER
    keyword %\[.\]\[0123456789\]s CONSTANT_OTHER_PLACEHOLDER
    keyword %[*] CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE
