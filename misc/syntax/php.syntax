    keyword whole XSLT_SABOPT_PARSE_PUBLIC_ENTITIES CONSTANT_OTHER

# YAZ Functions
    keyword whole yaz\_\[0123456789_abcdefghijklmnopqrstuvwxyz\] SUPPORT_FUNCTION

# YP/NIS Functions
    keyword whole yp\_\[0123456789_abcdefghijklmnopqrstuvwxyz\] SUPPORT_FUNCTION

