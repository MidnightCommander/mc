context default

context { }\n ENTITY_NAME_SECTION
    keyword \\ PUNCTUATION_SEPARATOR_CONTINUATION

    keyword \+add-header KEYWORD_OTHER
    keyword \+block KEYWORD_OTHER
    keyword \+change-x-forwarded-for KEYWORD_OTHER
    keyword \+client-header-filter KEYWORD_OTHER
    keyword \+client-body-filter KEYWORD_OTHER
    keyword \+client-header-tagger KEYWORD_OTHER
    keyword \+content-type-overwrite KEYWORD_OTHER
    keyword \+crunch-client-header KEYWORD_OTHER
    keyword \+crunch-if-none-match KEYWORD_OTHER
    keyword \+crunch-incoming-cookies KEYWORD_OTHER
    keyword \+crunch-server-header KEYWORD_OTHER
    keyword \+crunch-outgoing-cookies KEYWORD_OTHER
    keyword \+deanimate-gifs KEYWORD_OTHER
    keyword \+delay-response KEYWORD_OTHER
    keyword \+downgrade-http-version KEYWORD_OTHER
    keyword \+external-filter KEYWORD_OTHER
    keyword \+fast-redirects KEYWORD_OTHER
    keyword \+filter KEYWORD_OTHER
    keyword \+force-text-mode KEYWORD_OTHER
    keyword \+forward-override KEYWORD_OTHER
    keyword \+handle-as-empty-document KEYWORD_OTHER
    keyword \+handle-as-image KEYWORD_OTHER
    keyword \+hide-accept-language KEYWORD_OTHER
    keyword \+hide-content-disposition KEYWORD_OTHER
    keyword \+hide-if-modified-since KEYWORD_OTHER
    keyword \+hide-from-header KEYWORD_OTHER
    keyword \+hide-referrer KEYWORD_OTHER
    keyword \+hide-user-agent KEYWORD_OTHER
    keyword \+https-inspection KEYWORD_OTHER
    keyword \+ignore-certificate-errors KEYWORD_OTHER
    keyword \+limit-connect KEYWORD_OTHER
    keyword \+limit-cookie-lifetime KEYWORD_OTHER
    keyword \+prevent-compression KEYWORD_OTHER
    keyword \+overwrite-last-modified KEYWORD_OTHER
    keyword \+redirect KEYWORD_OTHER
    keyword \+server-header-filter KEYWORD_OTHER
    keyword \+server-header-tagger KEYWORD_OTHER
    keyword \+suppress-tag KEYWORD_OTHER
    keyword \+session-cookies-only KEYWORD_OTHER
    keyword \+set-image-blocker KEYWORD_OTHER

    keyword \-add-header KEYWORD_OTHER
    keyword \-block KEYWORD_OTHER
    keyword \-change-x-forwarded-for KEYWORD_OTHER
    keyword \-client-header-filter KEYWORD_OTHER
    keyword \-client-body-filter KEYWORD_OTHER
    keyword \-client-header-tagger KEYWORD_OTHER
    keyword \-content-type-overwrite KEYWORD_OTHER
    keyword \-crunch-client-header KEYWORD_OTHER
    keyword \-crunch-if-none-match KEYWORD_OTHER
    keyword \-crunch-incoming-cookies KEYWORD_OTHER
    keyword \-crunch-server-header KEYWORD_OTHER
    keyword \-crunch-outgoing-cookies KEYWORD_OTHER
    keyword \-deanimate-gifs KEYWORD_OTHER
    keyword \-delay-response KEYWORD_OTHER
    keyword \-downgrade-http-version KEYWORD_OTHER
    keyword \-external-filter KEYWORD_OTHER
    keyword \-fast-redirects KEYWORD_OTHER
    keyword \-filter KEYWORD_OTHER
    keyword \-force-text-mode KEYWORD_OTHER
    keyword \-forward-override KEYWORD_OTHER
    keyword \-handle-as-empty-document KEYWORD_OTHER
    keyword \-handle-as-image KEYWORD_OTHER
    keyword \-hide-accept-language KEYWORD_OTHER
    keyword \-hide-content-disposition KEYWORD_OTHER
    keyword \-hide-if-modified-since KEYWORD_OTHER
    keyword \-hide-from-header KEYWORD_OTHER
    keyword \-hide-referrer KEYWORD_OTHER
    keyword \-hide-user-agent KEYWORD_OTHER
    keyword \-https-inspection KEYWORD_OTHER
    keyword \-ignore-certificate-errors KEYWORD_OTHER
    keyword \-limit-connect KEYWORD_OTHER
    keyword \-limit-cookie-lifetime KEYWORD_OTHER
    keyword \-prevent-compression KEYWORD_OTHER
    keyword \-overwrite-last-modified KEYWORD_OTHER
    keyword \-redirect KEYWORD_OTHER
    keyword \-server-header-filter KEYWORD_OTHER
    keyword \-server-header-tagger KEYWORD_OTHER
    keyword \-suppress-tag KEYWORD_OTHER
    keyword \-session-cookies-only KEYWORD_OTHER
    keyword \-set-image-blocker KEYWORD_OTHER

    keyword block CONSTANT_OTHER
    keyword add CONSTANT_OTHER
    keyword last CONSTANT_OTHER
    keyword first  CONSTANT_OTHER
    keyword simple-check CONSTANT_OTHER
    keyword check-decoded-url CONSTANT_OTHER
    keyword block CONSTANT_OTHER
    keyword forward-socks4a CONSTANT_OTHER
    keyword forward-socks5 CONSTANT_OTHER
    keyword forward-webserver CONSTANT_OTHER
    keyword forward CONSTANT_OTHER
    keyword conditional-block CONSTANT_OTHER
    keyword conditional-forge CONSTANT_OTHER
    keyword forge CONSTANT_OTHER
    keyword reset-to-request-time CONSTANT_OTHER
    keyword randomize CONSTANT_OTHER

    # 8.5.18 + 9.2
    keyword js-annoyances  CONSTANT_OTHER
    keyword js-events CONSTANT_OTHER
    keyword html-annoyances CONSTANT_OTHER
    keyword content-cookies CONSTANT_OTHER
    keyword refresh-tags CONSTANT_OTHER
    keyword unsolicited-popups CONSTANT_OTHER
    keyword all-popups CONSTANT_OTHER
    keyword img-reorder CONSTANT_OTHER
    keyword banners-by-size CONSTANT_OTHER
    keyword banners-by-link CONSTANT_OTHER
    keyword webbugs CONSTANT_OTHER
    keyword tiny-textforms CONSTANT_OTHER
    keyword jumping-windows CONSTANT_OTHER
    keyword frameset-borders CONSTANT_OTHER
    keyword iframes CONSTANT_OTHER
    keyword demoronizer CONSTANT_OTHER
    keyword shockwave-flash CONSTANT_OTHER
    keyword quicktime-kioskmode CONSTANT_OTHER
    keyword fun CONSTANT_OTHER
    keyword crude-parental CONSTANT_OTHER
    keyword ie-exploits CONSTANT_OTHER
    keyword site-specifics CONSTANT_OTHER
    keyword no-ping CONSTANT_OTHER
    keyword github CONSTANT_OTHER
    keyword google CONSTANT_OTHER
    keyword imdb CONSTANT_OTHER
    keyword yahoo CONSTANT_OTHER
    keyword msn CONSTANT_OTHER
    keyword blogspot CONSTANT_OTHER
    keyword sourceforge CONSTANT_OTHER
    keyword xml-to-html CONSTANT_OTHER
    keyword html-to-xml CONSTANT_OTHER
    keyword no-ping CONSTANT_OTHER
    keyword hide-tor-exit-notation CONSTANT_OTHER

# Lines, which ignored by Privoxy, if it starts with "- ":
context linestart -\s \n COMMENT_LINE

# Comments:
context linestart # \n COMMENT_LINE
    spellcheck
context linestart \s\[\s\]# \n COMMENT_LINE
    spellcheck
context linestart /\s \n COMMENT_LINE
    spellcheck
