
context default
    spellcheck
    keyword linestart Begin3 KEYWORD_OTHER
    keyword linestart Title:\s\s\s\s\s\s\s\s\s\s ENTITY_OTHER_ATTRIBUTE_NAME yellow
    keyword linestart Version:\s\s\s\s\s\s\s\s ENTITY_OTHER_ATTRIBUTE_NAME yellow
    keyword linestart Entered-date:\s\s\s ENTITY_OTHER_ATTRIBUTE_NAME yellow
    keyword linestart Description:\s\s\s\s ENTITY_OTHER_ATTRIBUTE_NAME yellow
    keyword linestart Keywords:\s\s\s\s\s\s\s ENTITY_OTHER_ATTRIBUTE_NAME yellow
    keyword linestart Alternate-site:\s ENTITY_OTHER_ATTRIBUTE_NAME yellow
    keyword linestart Primary-site:\s\s\s ENTITY_OTHER_ATTRIBUTE_NAME yellow
    keyword linestart Original-site:\s\s ENTITY_OTHER_ATTRIBUTE_NAME yellow
    keyword linestart Platforms:\s\s\s\s\s\s ENTITY_OTHER_ATTRIBUTE_NAME yellow
    keyword linestart Copying-policy:\s ENTITY_OTHER_ATTRIBUTE_NAME yellow
    keyword linestart End KEYWORD_OTHER

    keyword linestart \t\t                STRING_UNQUOTED yellow
    keyword linestart \s\s\s\s\s\s\s\s\s\s\s\s\s\s\s\s STRING_UNQUOTED yellow
    keyword whole GPL CONSTANT_OTHER
    keyword whole BSD CONSTANT_OTHER
    keyword whole Shareware CONSTANT_OTHER
    keyword whole sunsite.unc.edu CONSTANT_OTHER
    keyword wholeright \s*.tar.gz STRING_UNQUOTED
    keyword wholeright \s*.lsm STRING_UNQUOTED

context linestart Author:\s\s\s\s\s\s\s\s\s \n STRING_UNQUOTED
    keyword whole \s*@*\s(*) MARKUP_UNDERLINE_LINK

context linestart Maintained-by:\s\s \n STRING_UNQUOTED
    keyword whole \s*@*\s(*) MARKUP_UNDERLINE_LINK

###############################################################################
