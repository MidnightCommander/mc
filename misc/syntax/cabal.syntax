# Author   : Mikhail S. Pobolovets
# Language : cabal
#
# haskell.syntax is taken as base
#

caseinsensitive

context default

# cabal keywords

#   reserved keywords:

#comments
    keyword -- COMMENT_LINE

#   unused symbols
    keyword whole _\[0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\] VARIABLE_OTHER

#   known fields
    keyword whole \[\s\]author ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]bug-reports ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]buildable ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]build-depends ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]build-tools ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]build-type ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]cabal-version ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]category ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]cc-options ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]copyright ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]cpp-options ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]c-sources ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]data-dir ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]data-files ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]default-language ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]default ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]description ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]exposed-modules ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]exposed ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]extensions ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]extra-lib-dirs ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]extra-libraries ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]extra-source-files ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]extra-tmp-files ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]frameworks ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]ghc-options ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]ghc-prof-options ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]ghc-shared-options ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]homepage ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]hs-source-dirs ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]hugs-options ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]include-dirs ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]includes ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]install-includes ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]jhc-options ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]ld-options ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]license-file ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]license ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]location ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]main-is ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]maintainer ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]name ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]nhc98-options ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]other-extensions ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]other-modules ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]package-url ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]pkgconfig-depends ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]source-repository ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]stability ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]synopsis ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]tag ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]tested-with ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]type ENTITY_OTHER_ATTRIBUTE_NAME
    keyword whole \[\s\]version ENTITY_OTHER_ATTRIBUTE_NAME

#   extended fields
    keyword whole x\-\[\-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\] ENTITY_OTHER_ATTRIBUTE_NAME

#   version wildcard
    keyword whole -any KEYWORD_OPERATOR_WORD

#   commandline keys
    keyword whole -\[\-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz_0123456789\] KEYWORD_OPERATOR

#   known extensions
    keyword whole Arrows CONSTANT_OTHER
    keyword whole BangPatterns CONSTANT_OTHER
    keyword whole ConstrainedClassMethods CONSTANT_OTHER
    keyword whole DeriveDataTypeable CONSTANT_OTHER
    keyword whole DisambiguateRecordFields CONSTANT_OTHER
    keyword whole EmptyDataDecls CONSTANT_OTHER
    keyword whole CPP CONSTANT_OTHER
    keyword whole ExistentialQuantification CONSTANT_OTHER
    keyword whole ExtendedDefaultRules CONSTANT_OTHER
    keyword whole ExtensibleRecords CONSTANT_OTHER
    keyword whole FlexibleContexts CONSTANT_OTHER
    keyword whole FlexibleInstances CONSTANT_OTHER
    keyword whole ForeignFunctionInterface CONSTANT_OTHER
    keyword whole FunctionalDependencies CONSTANT_OTHER
    keyword whole GADTs CONSTANT_OTHER
    keyword whole GeneralizedNewtypeDeriving CONSTANT_OTHER
    keyword whole Generics CONSTANT_OTHER
    keyword whole HereDocuments CONSTANT_OTHER
    keyword whole ImplicitParams CONSTANT_OTHER
    keyword whole ImpredicativeTypes CONSTANT_OTHER
    keyword whole IncoherentInstances CONSTANT_OTHER
    keyword whole KindSignatures CONSTANT_OTHER
    keyword whole LiberalTypeSynonyms CONSTANT_OTHER
    keyword whole MagicHash CONSTANT_OTHER
    keyword whole MultiParamTypeClasses CONSTANT_OTHER
    keyword whole NamedFieldPuns CONSTANT_OTHER
    keyword whole NewQualifiedOperators CONSTANT_OTHER
    keyword whole NoImplicitPrelude CONSTANT_OTHER
    keyword whole NoMonomorphismRestriction CONSTANT_OTHER
    keyword whole NoMonoPatBinds CONSTANT_OTHER
    keyword whole OverlappingInstances CONSTANT_OTHER
    keyword whole OverloadedStrings CONSTANT_OTHER
    keyword whole PackageImports CONSTANT_OTHER
    keyword whole ParallelListComp CONSTANT_OTHER
    keyword whole PatternGuards CONSTANT_OTHER
    keyword whole PatternSignatures CONSTANT_OTHER
    keyword whole PolymorphicComponents CONSTANT_OTHER
    keyword whole PostfixOperators CONSTANT_OTHER
    keyword whole QuasiQuotes CONSTANT_OTHER
    keyword whole Rank2Types CONSTANT_OTHER
    keyword whole RankNTypes CONSTANT_OTHER
    keyword whole RecordPuns CONSTANT_OTHER
    keyword whole RecordWildCards CONSTANT_OTHER
    keyword whole RecursiveDo CONSTANT_OTHER
    keyword whole RelaxedPolyRec CONSTANT_OTHER
    keyword whole RestrictedTypeSynonyms CONSTANT_OTHER
    keyword whole ScopedTypeVariables CONSTANT_OTHER
    keyword whole StandaloneDeriving CONSTANT_OTHER
    keyword whole TemplateHaskell CONSTANT_OTHER
    keyword whole TransformListComp CONSTANT_OTHER
    keyword whole TypeFamilies CONSTANT_OTHER
    keyword whole TypeOperators CONSTANT_OTHER
    keyword whole TypeSynonymInstances CONSTANT_OTHER
    keyword whole UnboxedTuples CONSTANT_OTHER
    keyword whole UndecidableInstances CONSTANT_OTHER
    keyword whole UnicodeSyntax CONSTANT_OTHER
    keyword whole UnliftedFFITypes CONSTANT_OTHER
    keyword whole ViewPatterns CONSTANT_OTHER

#   links
    keyword http://+ STRING_UNQUOTED
    keyword https://+ STRING_UNQUOTED
    keyword ftp://+ STRING_UNQUOTED
    keyword git://+ STRING_UNQUOTED
    keyword cvs://+ STRING_UNQUOTED
    keyword svn://+ STRING_UNQUOTED
    keyword darcs://+ STRING_UNQUOTED
#   special text inside of <>, i.e. emails
    keyword \<+\> KEYWORD_OPERATOR

#   build types with '\s & \n' hack to remove too stupid highlighting
    keyword whole Configure\s CONSTANT_OTHER
    keyword whole Configure\n CONSTANT_OTHER
    keyword whole Custom\s CONSTANT_OTHER
    keyword whole Custom\n CONSTANT_OTHER
    keyword whole Make\s CONSTANT_OTHER
    keyword whole Make\n CONSTANT_OTHER
    keyword whole Simple\n CONSTANT_OTHER
    keyword whole Simple\s CONSTANT_OTHER

#   licenses
    keyword whole AllRightsReserved CONSTANT_OTHER
    keyword whole OtherLicense CONSTANT_OTHER
    keyword whole PublicDomain CONSTANT_OTHER
    keyword whole LGPL CONSTANT_OTHER
    keyword whole GPL CONSTANT_OTHER
    keyword whole LGPL2 CONSTANT_OTHER
    keyword whole GPL2 CONSTANT_OTHER
    keyword whole LGPL3 CONSTANT_OTHER
    keyword whole GPL3 CONSTANT_OTHER
    keyword whole BSD CONSTANT_OTHER
    keyword whole BSD3 CONSTANT_OTHER
    keyword whole BSD4 CONSTANT_OTHER
    keyword whole MIT CONSTANT_OTHER

#   compilers
    keyword whole GHC CONSTANT_OTHER
    keyword whole NHC CONSTANT_OTHER
    keyword whole JHC CONSTANT_OTHER
    keyword whole HBC CONSTANT_OTHER
    keyword whole Helium CONSTANT_OTHER
    keyword whole Hugs CONSTANT_OTHER

#   special keywords
    keyword whole True CONSTANT_OTHER
    keyword whole False CONSTANT_OTHER
    keyword whole if CONSTANT_OTHER
    keyword whole else CONSTANT_OTHER
    keyword whole os CONSTANT_OTHER
    keyword whole impl CONSTANT_OTHER
    keyword whole arch CONSTANT_OTHER

    keyword whole linestart \[\s\]executable KEYWORD_OPERATOR
    keyword whole linestart \[\s\]library KEYWORD_OPERATOR
    keyword whole linestart \[\s\]test-suite KEYWORD_OPERATOR
    keyword whole flag KEYWORD_OTHER_RESERVED
    keyword whole repo KEYWORD_OTHER_RESERVED


#   unboxed (started from upcase)
#    keyword whole \{ABCDEFGHIJKLMNOPQRSTUVWXYZ\}\[0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\]# white
#   types/modules
#    keyword whole \{ABCDEFGHIJKLMNOPQRSTUVWXYZ\}\[0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz\] white

#digits
    keyword whole 0\{xX\}\{0123456789abcdefABCDEF\}\[0123456789abcdefABCDEF\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[0123456789\]\.\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC


# some punctuation characters
    keyword whole $ VARIABLE_OTHER
    keyword whole ! CONSTANT_OTHER
    keyword whole && CONSTANT_OTHER
    keyword whole \* KEYWORD_OPERATOR
    keyword whole \+ KEYWORD_OPERATOR
    keyword whole / KEYWORD_OPERATOR
    keyword whole ^ CONSTANT_OTHER
    keyword whole || CONSTANT_OTHER
    keyword whole | CONSTANT_OTHER

    keyword ~ CONSTANT_OTHER
    keyword , PUNCTUATION_SEPARATOR
    keyword - KEYWORD_OPERATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword = KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword > KEYWORD_OPERATOR
    keyword { CONSTANT_OTHER
    keyword } CONSTANT_OTHER
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION

# comments
context exclusive {- -} COMMENT_BLOCK
    spellcheck

context exclusive // \n COMMENT_LINE
    spellcheck

context exclusive \-\- \n COMMENT_LINE
    spellcheck

context " " STRING_QUOTED_DOUBLE
    spellcheck

    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword %% CONSTANT_OTHER_PLACEHOLDER
    keyword %\[#0\s-\+,\]\[0123456789\*\]\[.\]\[0123456789\*\]\[L\]\{eEfgGoxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[0\s-\+,\]\[0123456789\*\]\[.\]\[0123456789\*\]\[hl\]\{diuxX\} CONSTANT_OTHER_PLACEHOLDER
    keyword %\[hl\]n CONSTANT_OTHER_PLACEHOLDER
    keyword %\[-\]\[0123456789\*\]\[.\]\[0123456789\*\]s CONSTANT_OTHER_PLACEHOLDER
    keyword %[*] CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword %p CONSTANT_OTHER_PLACEHOLDER
    keyword \\\{0123\}\{01234567\}\{01234567\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE

# infix binop
context exclusive ` ` STRING_QUOTED_OTHER
