#
# Syntax rules for the JAL programming language.
#

caseinsensitive

context default

    #=========================
    # Variable types
    #
    keyword whole bit STORAGE_TYPE_PRIMITIVE white
    keyword whole byte STORAGE_TYPE_PRIMITIVE white
    keyword whole sbyte STORAGE_TYPE_PRIMITIVE white
    keyword whole word STORAGE_TYPE_PRIMITIVE white
    keyword whole sword STORAGE_TYPE_PRIMITIVE white
    keyword whole dword STORAGE_TYPE_PRIMITIVE white
    keyword whole sdword STORAGE_TYPE_PRIMITIVE white

    #=========================
    # Predefined constants
    #
    keyword whole false CONSTANT_LANGUAGE green
    keyword whole true CONSTANT_LANGUAGE green
    keyword whole off CONSTANT_OTHER green
    keyword whole on CONSTANT_OTHER green
    keyword whole low CONSTANT_OTHER green
    keyword whole high CONSTANT_OTHER green

    #=========================
    # Keywords
    #
    keyword whole alias KEYWORD_OTHER
    keyword whole at KEYWORD_OTHER
    keyword whole begin KEYWORD_CONTROL
    keyword whole const STORAGE_MODIFIER
    keyword whole count KEYWORD_CONTROL
    keyword whole defined KEYWORD_OPERATOR_WORD
    keyword whole end KEYWORD_CONTROL
    keyword whole exit KEYWORD_CONTROL
    keyword whole function STORAGE_TYPE_FUNCTION
    keyword whole get KEYWORD_OTHER
    keyword whole in KEYWORD_OTHER
    keyword whole is KEYWORD_OTHER
    keyword whole local STORAGE_MODIFIER
    keyword whole of KEYWORD_OTHER
    keyword whole out KEYWORD_OTHER
    keyword whole put KEYWORD_OTHER
    keyword whole procedure STORAGE_TYPE_FUNCTION
    keyword whole record STORAGE_TYPE_CLASS
    keyword whole repeat KEYWORD_CONTROL
    keyword whole return KEYWORD_CONTROL
    keyword whole then KEYWORD_CONTROL
    keyword whole until KEYWORD_CONTROL
    keyword whole var STORAGE_TYPE

    keyword whole volatile STORAGE_MODIFIER white

    keyword whole asm KEYWORD_OTHER_RESERVED
    keyword whole assembler KEYWORD_OTHER_RESERVED
    keyword whole assert KEYWORD_OTHER
    keyword whole include KEYWORD_CONTROL_IMPORT
    keyword whole task KEYWORD_OTHER

    #=========================
    # Pragma keywords
    #
    keyword whole pragma\{\t\s\}\[\t\s\]bootloader\{\t\s\}\[\t\s\]bloader META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]bootloader\{\t\s\}\[\t\s\]long_start META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]bootloader\{\t\s\}\[\t\s\]loader18 META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]bootloader\{\t\s\}\[\t\s\]rickpic META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]clear\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]clear\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]code META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]data META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]debug\{\t\s\}\[\t\s\]codegen\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]debug\{\t\s\}\[\t\s\]codegen\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]debug\{\t\s\}\[\t\s\]pcode\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]debug\{\t\s\}\[\t\s\]pcode\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]eedata META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]eeprom META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]error META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]frame META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]fuse_def META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]id META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]iddata META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]inline META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]interrupt\{\t\s\}\[\t\s\]fast META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]interrupt\{\t\s\}\[\t\s\]normal META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]interrupt\{\t\s\}\[\t\s\]raw META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]interrupt META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]jump_table META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]keep\{\t\s\}\[\t\s\]bank META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]keep\{\t\s\}\[\t\s\]page META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]keep META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]name META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]nostack META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]expr_reduce\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]expr_reduce\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]cexpr_reduce\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]cexpr_reduce\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]const_detect\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]const_detect\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]load_reduce\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]load_reduce\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]temp_reduce\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]temp_reduce\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]variable_frame\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]variable_frame\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]variable_reduce\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]opt\{\t\s\}\[\t\s\]variable_reduce\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]shared META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]size META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]speed META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]stack META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]target\{\t\s\}\[\t\s\]bank META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]target\{\t\s\}\[\t\s\]clock META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]target\{\t\s\}\[\t\s\]chip META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]target\{\t\s\}\[\t\s\]cpu META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]target\{\t\s\}\[\t\s\]fuses META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]target\{\t\s\}\[\t\s\]fuses_def META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]target\{\t\s\}\[\t\s\]page META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]target META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]task META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]all\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]all\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]backend\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]backend\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]conversion\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]conversion\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]directives\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]directives\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]misc\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]misc\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]range\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]range\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]stack_overflow\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]stack_overflow\{\t\s\}\[\t\s\]yes META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]truncate\{\t\s\}\[\t\s\]no META_PREPROCESSOR
    keyword whole pragma\{\t\s\}\[\t\s\]warn\{\t\s\}\[\t\s\]truncate\{\t\s\}\[\t\s\]yes META_PREPROCESSOR

    keyword whole block KEYWORD_OTHER
    keyword whole case KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole elsif KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole forever KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole loop KEYWORD_CONTROL
    keyword whole otherwise KEYWORD_CONTROL
    keyword whole start KEYWORD_OTHER
    keyword whole suspend KEYWORD_CONTROL
    keyword whole using KEYWORD_CONTROL_IMPORT
    keyword whole while KEYWORD_CONTROL

    keyword whole _debug SUPPORT_FUNCTION
    keyword whole _error SUPPORT_FUNCTION
    keyword whole _warn SUPPORT_FUNCTION

    keyword whole _code_size CONSTANT_OTHER
    keyword whole _fuses CONSTANT_OTHER
    keyword whole _fuses_base CONSTANT_OTHER
    keyword whole target_chip CONSTANT_OTHER
    keyword whole target_cpu CONSTANT_OTHER
    keyword whole target_clock CONSTANT_OTHER

    keyword whole _usec_delay SUPPORT_FUNCTION

wholechars 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_

    #=========================
    # Numbers
    #
    keyword whole 0b\{01_\}\[01_\] CONSTANT_NUMERIC
    keyword whole 0q\{0123456_\}\[0123456_\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789_\}\[0123456789_\] CONSTANT_NUMERIC
    keyword whole 0x\{0123456789ABCDEFabcdef_\}\[0123456789ABCDEFabcdef_\] CONSTANT_NUMERIC

    #=========================
    # Comments
    #
    keyword --*\n COMMENT_LINE magenta
    keyword ;*\n COMMENT_LINE magenta

    #=========================
    # Special symbols
    #
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword << KEYWORD_OPERATOR
    keyword >> KEYWORD_OPERATOR

    keyword ~ KEYWORD_OPERATOR
    keyword !! KEYWORD_OPERATOR
    keyword & KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    keyword ^ KEYWORD_OPERATOR
    keyword ' KEYWORD_OPERATOR

    keyword : PUNCTUATION_SEPARATOR
    keyword != KEYWORD_OPERATOR
    keyword == KEYWORD_OPERATOR
    keyword <= KEYWORD_OPERATOR
    keyword >= KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword > KEYWORD_OPERATOR

    keyword = KEYWORD_OPERATOR
    keyword ! KEYWORD_OPERATOR

    #=========================
    # Separators
    #
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword . KEYWORD_OPERATOR

    #=========================
    # Assembler lines
    #
context exclusive asm\{\t\s\}\[\t\s\] \n META_EMBEDDED cyan

    #=========================
    # Strings
    #
context " " STRING_QUOTED_DOUBLE green
    spellcheck
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abfnrtv?\} CONSTANT_CHARACTER_ESCAPE
    keyword \\0\{0123456789ABCDEFabcdef\}\{0123456789ABCDEFabcdef\}\{0123456789ABCDEFabcdef\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\x\{0123456789ABCDEFabcdef\}\{0123456789ABCDEFabcdef\} CONSTANT_CHARACTER_ESCAPE
