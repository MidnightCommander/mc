# CURL, Client URL Library Functions (https://www.php.net/manual/en/ref.curl.php)
# Helper command:
#   wget -q -O - https://www.php.net/manual/en/ref.curl.php |\
#   grep -Eo "<ul class=\"chunklist chunklist_reference\">.*</ul>" |\
#   sed 's/<li>/\n<li>/g' | grep -Eo "<a href=.*>.*</a>" | sort -u |\
#   sed 's/<a href=.*>\(.*\)<\/a>/    keyword whole \1 yellow/g'
